def call_claude(messages: List[Dict], max_tokens: int = 8192,
                context: str = "") -> str:
    """Retry with exponential backoff + jitter. RAISES on failure - a failed
    call must never return "" and be read downstream as "no data"."""
    return call_claude_robust(client, MODEL, messages, max_tokens,
                              log=logger, context=context)


def claude_text(prompt: str, max_tokens: int = 8192, context: str = "") -> str:
    return call_claude([{"role": "user", "content": prompt}], max_tokens,
                       context=context)


# -- RS assessment framework -------------------------------------------------
# Selected PER REQUEST, and stored on the request rather than on the module.
#
# This used to be a module global that ``set_rs_framework`` wrote and nothing
# ever cleared. The consequences were the textbook ones: a request that named
# no framework silently inherited whichever framework the previous request had
# named, so the same inputs produced different documents depending on what ran
# before them; and two requests in flight at once raced for one variable, so
# either could be generated under the other one's framework. Both are
# cross-document contamination, and neither is visible in the output.
#
# ``docgen_evidence.request_scope`` binds the value to the request via
# contextvars, which gives every request - and every thread and asyncio task -
# its own value and resets it on the way out whether the request succeeded or
# raised. ``set_rs_framework`` is kept as a thin writer onto the active request
# so existing callers keep working; outside a request scope it writes to a
# throwaway state and therefore cannot leak into the next request.


def set_rs_framework(framework: Optional[str]) -> None:
    """Select the RS assessment framework for the ACTIVE REQUEST.

    Prefer opening a scope, which cannot be forgotten::

        with docgen_evidence.request_scope(rs_framework=framework):
            ...
    """
    _EV.current_request().rs_framework = (framework or "").strip()


def get_rs_framework() -> str:
    """The active request's RS framework, else the deployment default."""
    import residual_solvent as _rs
    return (_EV.current_request().rs_framework
            or getattr(_rs, "DEFAULT_RS_FRAMEWORK", "USP <467>"))



