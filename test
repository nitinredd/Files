    bn_product = st.text_input("Product Name", key="bn_product")
    bn_files = st.file_uploader(
        "Upload files", accept_multiple_files=True,
        type=["pdf", "docx", "doc", "json"], key="bn_files")

    # Processing auto-triggers on a new upload — no separate "Process" click.
    _sig = f"{bn_product}|" + ",".join(
        sorted(safe_str(getattr(f, "name", "")) for f in (bn_files or [])))
    if bn_files and bn_product and st.session_state.get("bn_upload_sig") != _sig:
        st.session_state["bn_upload_sig"] = _sig
        for k in ("benoc_annexures", "benoc_meta", "benoc_preview",
                  "benoc_validation", "benoc_docx_bytes", "benoc_report_ready",
                  "benoc_fname"):
            st.session_state.pop(k, None)
        try:
            # Structures and dissolution charts always auto-generate when the
            # source data is present, and degrade to blank when it is not.
            st.session_state["bn_gen_structures"] = True
            st.session_state["bn_gen_charts"] = True
            _bar = st.progress(0, text="Analyzing files… 0%")
            annexures = _process_annexures_with_progress(
                "BE NOC Application", list(bn_files or []), _bar, 5, 100)
            _bar.empty()
            st.session_state["benoc_annexures"] = annexures
            _meta = _auto_meta(bn_product, "", "BE NOC Application")
            _meta.update({
                "title": ("Application for Grant of NOC for Import of Innovator "
                          "Product for Bio-Equivalence Study"),
                "company_name": "Dr. Reddy's Laboratories Ltd.",
                "company_address": "",
                "declared_by": "",
                "declarant_title": "",
                # Every gap-fill channel stays empty: the assembled sections come
                # from the uploaded annexures, and an absent source renders
                # "Not provided." rather than a fabricated value.
                "api_overrides": [],
                "manual_process_narrative": "",
                "manual_composition": [],
                "manual_equipment": [],
                "manual_dissolution": {},
            })
            st.session_state["benoc_meta"] = _meta
            # Validation is computed for the structural can_generate gate only —
            # it is never rendered as a verification screen.
            preview, validation = _bn.build_benoc_payload(
                _meta, annexures, generate_images=False, generate_charts=False)
            st.session_state["benoc_preview"] = preview
            st.session_state["benoc_validation"] = validation
        except Exception:
            logger.exception("BE NOC process error")
            st.error("Could not read the uploaded files. Please try again.")

    annexures = st.session_state.get("benoc_annexures")
    if annexures is None:
        return
    validation = st.session_state.get("benoc_validation", {})

    # Warning-first: generate unless a true STRUCTURAL error (no files / all
    # extraction failed). Content warnings are informational only → logger; they
    # never appear in the UI or the DOCX.
    for _w in validation.get("warnings", []):
        logger.info(f"[BE NOC] {_w}")
    if validation.get("errors"):
        for _e in validation["errors"]:
            logger.error("[BE NOC] %s", _e)
        st.error("None of the uploaded files could be read. Please check them "
                 "and try again.")
    elif st.button("Generate Report", type="primary", key="bn_generate",
                   use_container_width=True):
        _generate_benoc_report()

    if st.session_state.get("benoc_report_ready") and st.session_state.get("benoc_docx_bytes"):
        st.download_button("📥 Download Report",
                           data=st.session_state["benoc_docx_bytes"],
                           file_name=st.session_state.get("benoc_fname",
                                                          "benoc_report.docx"),
                           mime="application/vnd.openxmlformats-officedocument."
                                "wordprocessingml.document",
                           key="bn_download", use_container_width=True)


def _generate_benoc_report() -> None:
    """Assemble the BE NOC payload (with structures + charts) and render via
    generate_benoc.js. Warning-first: blocks only on the structural hard errors."""
    import benoc as _bn
    try:
        annexures = st.session_state["benoc_annexures"]
        meta = st.session_state["benoc_meta"]
        gen_images = st.session_state.get("bn_gen_structures", True)
        gen_charts = st.session_state.get("bn_gen_charts", True)

        with st.spinner("Generating document…"):
            payload, validation = _bn.build_benoc_payload(
                meta, annexures, generate_images=gen_images,
                generate_charts=gen_charts)

        if not validation.get("can_generate"):
            st.error("❌ Generation blocked (structural errors only): "
                     + " ".join(validation.get("errors", [])[:3]))
            return

        logo_bytes, logo_mt = load_logo_from_assets()
        if logo_bytes:
            payload["logo_b64"] = base64.standard_b64encode(logo_bytes).decode()
            payload["logo_type"] = logo_mt

        with st.spinner("Rendering A4 DOCX…"):
            with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False,
                                             encoding="utf-8") as jf:
                _dump_payload_json(payload, jf)
                json_path = jf.name
            out_path = json_path.replace(".json", ".docx")
            script = str(Path(__file__).parent / "generate_benoc.js")
            r = subprocess.run(["node", script, json_path, out_path],
                               capture_output=True, text=True, timeout=180)
            if r.returncode != 0:
                raise RuntimeError(f"Renderer failed: {r.stderr[:500]}")
            with open(out_path, "rb") as f:
                docx_bytes = f.read()

        fname = (f"{meta['document_no'].replace('/','_').replace(' ','_')}_"
                 f"{datetime.now().strftime('%Y%m%d_%H%M%S')}.docx")
        st.session_state["benoc_docx_bytes"] = docx_bytes
        st.session_state["benoc_fname"] = fname
        st.session_state["benoc_report_ready"] = True
        st.success("✅ BE NOC report generated.")
    except Exception as e:
        st.error(f"Generation failed: {e}")
        logger.exception("BE NOC generate error")


def _auto_background(header: Dict) -> str:
    """Factual Background paragraph composed from the values the scientist gave.
    States only what was entered — nothing about the product is invented."""
    prod = safe_str(header.get("product_name")) or "the product"
