def _ei_pdf_convert(pdf: bytes, name: str, index: int, cb=None) -> Dict:
    import annexure_converter as _ac
    raw = _ac.convert_pdf_to_json(pdf, name, index, cb)
    if not isinstance(raw, dict):
        raw = {"annexure_number": index, "material_name": "", "elements": []}
    # Normalise the converter JSON through the same ingestion the JSON-upload
    # path uses, so downstream EI/injection logic sees one consistent schema.
    ann = process_annexure(raw, index)
    return ann if isinstance(ann, dict) else raw


def _ei_json_normalise(obj: Any, index: int) -> Dict:
    return process_annexure(obj, index)


def _rs_pdf_convert(pdf: bytes, name: str, index: int, cb=None) -> Dict:
    import residual_solvent_annexure_converter as _rsc
    import residual_solvent as _rs
    framework = get_rs_framework()
    return _rsc.convert_rs_pdf_to_json(pdf, name, index, cb, framework)


def _rs_json_normalise(obj: Any, index: int) -> Dict:
    import residual_solvent as _rs
    # RS Bug 1: honour the project's assessment framework (chosen at project start)
    # when collapsing multi-compendial duplicates. Defaults to USP <467>.
    framework = get_rs_framework()
    ann = _rs.process_rs_annexure(obj, index, framework)
    return ann


