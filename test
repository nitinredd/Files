"""
injection_support.py — Injection / parenteral support for the EI pipeline.

This module is ADDITIVE. It does not touch the OSD workflow. It provides:

  • parse_injection_excel(excel_bytes, product_name, claude_call)
        Intelligent parser for injection composition Excel files. Supports:
          - Medroxy-style ratio headers   ("Qty/unit (mg / 0.65 mL)")
          - Aprepitant-style multi-strength tables with an MDD column
        Returns a structured dict with inferred dosing + component quantities,
        every value carrying its source/method for the audit trail.

  • detect_calculation_model(annexure_data)
        Inspect annexure concentration units and decide mass-based (µg/g) vs
        volume-based (µg/mL). Returns (model, concentration_unit, evidence).

  • build_unit_config(dosage_category, route, calculation_model)
        Produce the unit_config object consumed by generate_report.js so the
        same renderer dynamically labels "Daily Intake (g/day)" vs "(mL/day)"
        and "Measured Concentration (µg/g)" vs "(µg/mL)".

  • build_injection_comp_data(parsed, annexure_data, model_info)
        Convert the parsed injection table into the comp_data structure the
        existing calculate_ei_tables() understands, pre-computing component
        daily intake so the engine stays product-agnostic.

  • validate_injection(parsed, model_info, comp_data, annexure_data)
        Strict validation gate. Returns (errors, warnings). Report generation
        is blocked when errors is non-empty.

All scientific decisions (route, PDE route, selected MDD, model, units,
component quantities) are made here in the backend.
"""

from __future__ import annotations
import re
import json
import logging
from typing import Any, Dict, List, Optional, Tuple, Callable

logger = logging.getLogger(__name__)


# ── Small local helpers (kept self-contained so this module has no app.py dep) ─
def _sstr(v: Any) -> str:
    return str(v).strip() if v is not None else ""


def _sfloat(v: Any, default: float = 0.0) -> float:
    if isinstance(v, (int, float)):
        return float(v)
    try:
        return float(str(v).strip().replace(",", ""))
    except Exception:
        return default


def _sint(v: Any, default: int = 1) -> int:
    try:
        return int(float(str(v).strip()))
    except Exception:
        return default


# ── Ratio / quantity parsing ──────────────────────────────────────────────────
# Matches "104 mg / 0.65 mL", "32 mg/4.4 mL", "130 mg / 18 mL", "160 mg/mL"
_RATIO_RE = re.compile(
    r"([0-9]*\.?[0-9]+)\s*(mg|mcg|µg|ug|g)\s*/\s*([0-9]*\.?[0-9]+)?\s*(ml|mL|l|L)",
    re.IGNORECASE,
)
# Matches a volume in a header like "(mg / 0.65 mL)" or "per 18 mL"
_VOL_RE = re.compile(r"([0-9]*\.?[0-9]+)\s*(ml|mL|l|L)", re.IGNORECASE)
# Matches mg/mL concentration headers
_CONC_RE = re.compile(
    r"([0-9]*\.?[0-9]+)\s*(mg|mcg|µg|ug|g)\s*/\s*(ml|mL)", re.IGNORECASE
)


def _mass_to_mg(value: float, unit: str) -> float:
    u = unit.lower()
    if u in ("g",):
        return value * 1000.0
    if u in ("mcg", "µg", "ug"):
        return value / 1000.0
    return value  # mg


def _vol_to_ml(value: float, unit: str) -> float:
    return value * 1000.0 if unit.lower() in ("l",) else value


# A8: an API dosed in USP units ("40 units", "0.2 units", "144 IU", "20 U").
_UNITS_RE = re.compile(
    r"([0-9][0-9,]*\.?[0-9]*)\s*(?:usp\s*)?(?:units?|iu|u)\b", re.IGNORECASE)


def _parse_units(text: str) -> float:
    """Return the numeric USP-unit value in `text` (e.g. '40 units' → 40.0),
    else 0.0. Ignores a bare 'u'/'iu' with no leading number."""
    s = _sstr(text)
    if not s:
        return 0.0
    m = _UNITS_RE.search(s)
    if not m:
        return 0.0
    try:
        return float(m.group(1).replace(",", ""))
    except (TypeError, ValueError):
        return 0.0


# ── FIX 2/3: volume-based (per-mL) dosing helpers ─────────────────────────────
_PER_ML_HEADER_RE = re.compile(r"/\s*m\s*l|per\s*ml", re.IGNORECASE)
_STRENGTH_TOKEN_RE = re.compile(
    r"([0-9][0-9,]*\.?[0-9]*)\s*(units?|iu|u|mg|µg|mcg|ug|g|ml|l)?\b", re.IGNORECASE)


def _parse_strengths(cell: str) -> List[Tuple[float, str]]:
    """Split a per-mL cell into [(value, unit_lower)], handling a dual-strength
    'a / b' cell (e.g. '0.2 units / 0.4 units' → [(0.2,'units'),(0.4,'units')]).
    A bare number keeps unit ''. Returns [] when nothing numeric is present."""
    s = _sstr(cell)
    if not s:
        return []
    out: List[Tuple[float, str]] = []
    for part in re.split(r"\s*/\s*", s):
        part = part.strip()
        if not part:
            continue
        m = _STRENGTH_TOKEN_RE.search(part)
        if not m:
            continue
        try:
            val = float(m.group(1).replace(",", ""))
        except (TypeError, ValueError):
            continue
        out.append((val, (m.group(2) or "").lower()))
    return out


def _detect_per_ml_col(qty_columns: List[str], mgml_col: str) -> str:
    """Return the first per-mL QUANTITY column (e.g. 'Quantity/mL', 'Qty per mL'),
    else ''. A pure 'mg/mL' concentration column (mgml_col) is deliberately NOT
    used here so existing mg/mL-concentration sheets keep the mass-based path
    (regression guard); only a per-mL composition quantity column enables the
    volume-based mode."""
    for c in list(qty_columns or []):
        if c and _PER_ML_HEADER_RE.search(c):
            return c
    return ""


def _strength_mg_per_ml(value: float, unit: str) -> Optional[float]:
    """Convert a per-mL amount to mg/mL. Returns None for a non-mass basis
    (units/IU) so the caller can treat that row's mass as API-potency-derived."""
    u = (unit or "").lower()
    if u in ("g",):
        return value * 1000.0
    if u in ("mcg", "µg", "ug"):
        return value / 1000.0
    if u in ("units", "iu", "u", "ml", "l"):
        return None
    return value  # mg or bare number → treat as mg/mL


def compute_volume_based(rows: List[Dict], ingredient_col: str, function_col: str,
                         per_ml_col: str, api_idx: Optional[int], product_name: str,
                         mdd_value: float, mdd_unit: str, density: float,
                         api_potency: float = 0.0) -> Optional[Dict]:
    """FIX 2/3 — volume-based dosing for per-mL solutions. Product-agnostic.

    volume_per_day (mL) = MDD ÷ API_concentration_per_mL (SAME unit basis as the
    MDD toggle). Dual-strength: split the API cell on '/', take the WORST case =
    lowest API concentration → largest volume → highest excipient burden.
    Per-component daily mass (g) = component_conc_mg_per_mL × volume_per_day/1000.
    total_product (g/day) = volume_per_day × density (density affects only the
    total / Option 2a-vs-2b threshold, never per-element concentrations).

    Returns None (caller falls back to the mass path) if the API per-mL
    concentration in the MDD's unit basis cannot be resolved."""
    if api_idx is None or not per_ml_col or mdd_value <= 0:
        return None
    warnings: List[str] = []
    want_units = mdd_unit.strip().lower() in ("units", "iu", "u")

    def _match_basis(u: str) -> bool:
        u = (u or "").lower()
        return (u in ("units", "iu", "u", "")) if want_units \
            else (u in ("mg", "g", "µg", "ug", "mcg", ""))

    api_strengths = _parse_strengths(_row_field(rows[api_idx], per_ml_col))
    cand = [(v, u) for (v, u) in api_strengths if v > 0 and _match_basis(u)]
    if not cand:
        return None
    worst_val, worst_unit = min(cand, key=lambda t: t[0])   # lowest conc = worst
    worst_index = api_strengths.index((worst_val, worst_unit))

    if want_units:
        api_conc = worst_val                                 # units/mL
    else:
        api_conc = _strength_mg_per_ml(worst_val, worst_unit or "mg") or worst_val
    if api_conc <= 0:
        return None
    volume_per_day = mdd_value / api_conc                     # mL/day

    vb_rows: List[Dict] = []
    for i, r in enumerate(rows):
        name = _sstr(r.get("ingredient", "")) or _row_field(r, ingredient_col,
                                                            ["ingredient", "name"])
        if not name:
            continue
        cell = _row_field(r, per_ml_col)
        fn = _row_field(r, function_col, ["function", "role"])
        is_qs = _is_qs_row(name, cell, fn)
        strengths = _parse_strengths(cell)
        comp_mg_per_ml = 0.0
        if strengths:
            idx = worst_index if worst_index < len(strengths) else 0
            mgml = _strength_mg_per_ml(*strengths[idx])
            if mgml is not None:
                comp_mg_per_ml = mgml
        daily_g = comp_mg_per_ml * volume_per_day / 1000.0
        component_mg = comp_mg_per_ml * volume_per_day
        # API dosed in units: derive its (tiny) daily mass from potency if known.
        if i == api_idx and comp_mg_per_ml <= 0 and want_units and api_potency > 0:
            component_mg = mdd_value / api_potency
            daily_g = component_mg / 1000.0
        vb_rows.append({
            "ingredient": name, "is_qs": is_qs,
            "component_mg_per_ml": round(comp_mg_per_ml, 6),
            "daily_g": round(daily_g, 8),
            "component_mg": round(component_mg, 6),
            "section": r.get("_section", ""),
        })

    dens_used = density if density > 0 else 1.0
    total_product_g = volume_per_day * dens_used
    option = ("Option 2b (concentration-based summation)"
              if total_product_g > 10 else "Option 2a (common permitted concentration)")
    return {
        "volume_per_day_ml":  round(volume_per_day, 4),
        "total_product_g":    round(total_product_g, 4),
        "density_used":       round(dens_used, 6),
        "option":             option,
        "api_conc_per_ml":    round(api_conc, 8),
        "api_unit":           "units" if want_units else "mg",
        "worst_strength_index": worst_index,
        "worst_strength_value": worst_val,
        "n_strengths":        len(api_strengths),
        "vb_rows":            vb_rows,
        "warnings":           warnings,
    }


def parse_ratio(text: str) -> Optional[Dict[str, float]]:
    """
    Parse a "mass / volume" ratio. Returns {mass_mg, volume_ml, conc_mg_per_ml}
    or None. "160 mg/mL" → volume_ml=1.0. "104 mg / 0.65 mL" → both present.
    """
    if not text:
        return None
    m = _RATIO_RE.search(text)
    if not m:
        return None
    mass = _mass_to_mg(_sfloat(m.group(1)), m.group(2))
    vol_raw = m.group(3)
    vol_unit = m.group(4)
    if vol_raw is None or vol_raw == "":
        volume_ml = 1.0  # "mg/mL" form
    else:
        volume_ml = _vol_to_ml(_sfloat(vol_raw), vol_unit)
    if volume_ml <= 0:
        return None
    return {
        "mass_mg": round(mass, 6),
        "volume_ml": round(volume_ml, 6),
        "conc_mg_per_ml": round(mass / volume_ml, 6),
    }


def parse_volume_from_header(header: str) -> Optional[float]:
    """Extract a dose volume in mL from a header like 'Qty/unit (mg / 0.65 mL)'."""
    if not header:
        return None
    # Prefer the volume that follows a slash (ratio denominator)
    r = parse_ratio(header)
    if r and r["volume_ml"] != 1.0:
        return r["volume_ml"]
    m = _VOL_RE.search(header)
    if m:
        return _vol_to_ml(_sfloat(m.group(1)), m.group(2))
    return None


# ── Excel → structured injection model ────────────────────────────────────────
def make_injection_excel_prompt() -> str:
    """Prompt for Claude Vision/text to extract an injection composition table."""
    return (
        "You are extracting the composition table from an INJECTION / PARENTERAL "
        "drug product spreadsheet. Extract the table EXACTLY as printed — do not "
        "calculate or infer dosing.\n\n"
        "Identify and return:\n"
        "1. ingredient_col: exact header of the ingredient/component-name column.\n"
        "2. function_col: exact header of the Function/Role column if present "
        "(e.g. values like 'Active', 'Active ingredient', 'API', 'Buffer').\n"
        "3. qty_columns: a list of EVERY quantity column header (keep ALL strength "
        "columns — a report may cover two strengths at once). A header may be "
        "'Quantity/mL', 'Quantity per mL', 'Qty/mL', 'Quantity/Vial', 'Qty/vial', "
        "'Quantity/unit', 'mg/vial', 'mg/mL', or a ratio like "
        "'Qty/unit (mg / 0.65 mL)' / 'Qty/vial (32 mg/4.4 mL)'.\n"
        "4. mgml_col: exact header of an explicit mg/mL concentration column if "
        "present, else empty string.\n"
        "5. mdd_col: exact header of an explicit MDD (maximum daily dose) column "
        "if present (per-component daily quantity), else empty string.\n"
        "6. density_value + density_unit: if a density is stated anywhere "
        "(e.g. '1.039 g/mL'), else 0 and empty.\n"
        "7. api_potency_units_per_mg: if the sheet states an API potency relating "
        "USP units to mg (e.g. '1 mg = 530 units', '530 units/mg'), return the "
        "number of units per mg; else 0.\n"
        "8. columns: list of ALL column headers in order.\n"
        "9. sections: list of {name, rows:[{ingredient, function, columns:{header:value}}]}.\n\n"
        "RULES:\n"
        "- A7 — when BOTH a per-mL and a per-vial (per-unit) column exist, list "
        "both but note the per-vial column is the per-unit basis.\n"
        "- A8 — an API row may be dosed in UNITS ('0.2 units', '40 units', 'IU', "
        "'USP units') rather than mg. NEVER drop it; keep its exact value + unit.\n"
        "- B5 — IGNORE decorative rows: a merged title/banner row (prose spanning "
        "many columns), subtitle/caption rows ('extracted from…', 'units/mL'), "
        "filter-dropdown decorations, and trailing notes/footnotes ('Note', '*', "
        "'#', 'Q.s.'). The real header row has 3+ of: S.No, Material Code, "
        "Ingredient, Function, Supplier, Quantity.\n"
        "- Include EVERY ingredient/q.s. row (Water for Injection, HCl, NaOH, "
        "Nitrogen) and pH adjusters — keep their literal cell text (e.g. 'q.s.', "
        "'q.s. to 18 mL').\n"
        "- Map each cell to its exact column header.\n"
        "- Do NOT compute MDD, strength, or totals — extract only.\n"
        "- Return ONLY valid JSON, no markdown.\n"
    )


_API_FUNCTION_HINTS = (
    "active ingredient", "active pharmaceutical ingredient", "active",
    "api", "drug substance",
)
_QS_HINTS = ("q.s", "qs ", "q.s.", "qs to", "q.s to", "adjust", "ph adjust")
_QS_MATERIALS = (
    "water for injection", "hydrochloric acid", "sodium hydroxide", "nitrogen",
    "water for injections", "wfi",
)


def _row_field(row: Dict, col: str, fallbacks: List[str] = None) -> str:
    cols = row.get("columns", {})
    if isinstance(cols, dict):
        if col and col in cols:
            return _sstr(cols[col])
        for fb in (fallbacks or []):
            for k, v in cols.items():
                if fb.lower() in k.lower():
                    return _sstr(v)
    for fb in (fallbacks or []):
        if fb in row:
            return _sstr(row[fb])
    return ""


def _is_qs_row(name: str, qty_text: str, function: str) -> bool:
    n = name.lower()
    q = qty_text.lower()
    if any(h in n for h in _QS_MATERIALS):
        # Water/HCl/NaOH/N2 are q.s./process aids unless a real number is given
        if any(h in q for h in _QS_HINTS) or not re.search(r"[0-9]", q):
            return True
    if any(h in q for h in _QS_HINTS):
        return True
    return False


def _identify_api_row(rows: List[Dict], product_name: str,
                      function_col: str) -> Tuple[Optional[int], str]:
    """
    Identify the API row using robust signals (not position).
    Returns (row_index, method).
    """
    pname = product_name.lower().strip()
    # 1. Function column says active
    for i, r in enumerate(rows):
        fn = _row_field(r, function_col, ["function", "role"]).lower()
        if any(h in fn for h in _API_FUNCTION_HINTS):
            return i, "function_column"
    # 2. Product-name ↔ material-name match
    if pname:
        for i, r in enumerate(rows):
            nm = _sstr(r.get("ingredient", "")).lower()
            # token overlap between product name and ingredient
            ptoks = {t for t in re.split(r"[\s\-,/()]+", pname) if len(t) > 3}
            ntoks = {t for t in re.split(r"[\s\-,/()]+", nm) if len(t) > 3}
            if ptoks and ntoks and (ptoks & ntoks):
                return i, "product_name_match"
    return None, "not_found"


def parse_injection_excel(parsed_raw: Dict, product_name: str,
                          doses_per_day: int = 1, mdd_value: float = 0.0,
                          mdd_unit: str = "mg", ui_density: float = 0.0) -> Dict:
    """
    Convert the raw extracted injection table (from Claude) into a structured
    model with inferred dosing + per-component quantities. Every inferred value
    carries its source method for the audit trail.

    `parsed_raw` is the JSON dict from make_injection_excel_prompt().

    FIX 1/2/4/5: when `mdd_value` > 0 (authoritative UI MDD, in `mdd_unit` = mg |
    units) AND the composition is per-mL, a volume-based model is computed
    (volume/day = MDD ÷ API conc/mL) and the UI MDD is NOT re-derived from Excel.
    Otherwise the existing mass-based (ratio / MDD-column) paths run unchanged.
    `ui_density` (g/mL) is used only when the Excel states no density.
    """
    audit: Dict[str, Any] = {}
    warnings: List[str] = []

    ingredient_col = _sstr(parsed_raw.get("ingredient_col", ""))
    function_col   = _sstr(parsed_raw.get("function_col", ""))
    mgml_col       = _sstr(parsed_raw.get("mgml_col", ""))
    mdd_col        = _sstr(parsed_raw.get("mdd_col", ""))
    qty_columns    = [_sstr(c) for c in (parsed_raw.get("qty_columns") or []) if _sstr(c)]
    density_value  = _sfloat(parsed_raw.get("density_value", 0))
    density_unit   = _sstr(parsed_raw.get("density_unit", ""))
    api_potency    = _sfloat(parsed_raw.get("api_potency_units_per_mg", 0))
    columns        = [_sstr(c) for c in (parsed_raw.get("columns") or []) if _sstr(c)]

    # Flatten rows (preserve section)
    rows: List[Dict] = []
    for sec in (parsed_raw.get("sections") or []):
        if not isinstance(sec, dict):
            continue
        sname = _sstr(sec.get("name", ""))
        for r in (sec.get("rows") or []):
            if isinstance(r, dict):
                r = dict(r)
                r["_section"] = sname
                # normalise ingredient key
                if "ingredient" not in r:
                    r["ingredient"] = _row_field(r, ingredient_col,
                                                 ["ingredient", "name", "component"])
                rows.append(r)

    # ── Detect table style ────────────────────────────────────────────────────
    has_mdd_col = bool(mdd_col)
    has_mgml    = bool(mgml_col)
    multi_strength = len(qty_columns) > 1
    table_style = ("aprepitant_multistrength"
                   if (has_mdd_col or multi_strength or has_mgml)
                   else "medroxy_ratio")
    audit["table_style"] = table_style
    audit["qty_columns"] = qty_columns

    # ── Identify API row ──────────────────────────────────────────────────────
    api_idx, api_method = _identify_api_row(rows, product_name, function_col)
    audit["api_row_method"] = api_method
    if api_idx is not None:
        audit["api_row_name"] = _sstr(rows[api_idx].get("ingredient", ""))

    # ── Select dose volume + presentation ─────────────────────────────────────
    dose_volume_ml = 0.0
    selected_qty_col = ""
    strength_mg_per_ml = 0.0
    api_per_dose_mg = 0.0
    mdd_source = "none"

    # Style A: explicit per-component MDD / Maximum Daily Intake column is the
    # source of truth. Detect its unit from the header — it may be given directly
    # in grams ("Maximum Daily Intake (g)") or in mg ("MDD (mg)"). When grams are
    # provided, the value IS the final daily intake and needs no derivation.
    component_mdd: Dict[int, float] = {}
    mdd_col_unit = "mg"
    if has_mdd_col:
        hdr = mdd_col.lower()
        # Unit precedence: explicit (g) in header → grams; µg → micrograms; else mg
        if re.search(r"\(\s*g\s*\)|\bg/day\b|\(g\)|intake\s*\(g\)|\bgram", hdr) \
           and not re.search(r"mg|µg|mcg|ug", hdr):
            mdd_col_unit = "g"
        elif re.search(r"µg|mcg|ug", hdr):
            mdd_col_unit = "ug"
        else:
            mdd_col_unit = "mg"
        for i, r in enumerate(rows):
            mtxt = _row_field(r, mdd_col, ["mdd", "maximum daily", "daily intake"])
            mval = _sfloat(re.sub(r"[^0-9.\-]", "", mtxt)) if mtxt else 0.0
            if mval > 0:
                component_mdd[i] = mval
        if api_idx is not None and api_idx in component_mdd:
            # Normalise the API MDD to mg for strength/consistency math
            raw_api = component_mdd[api_idx]
            api_per_dose_mg = _mass_to_mg(raw_api, mdd_col_unit)
            mdd_source = ("explicit_mdd_column_g" if mdd_col_unit == "g"
                          else "explicit_mdd_column")

    # Determine candidate presentations from qty columns (ratios)
    presentations: List[Dict] = []
    for qc in qty_columns:
        ratio = parse_ratio(qc)
        if ratio:
            presentations.append({
                "column": qc,
                "mass_mg": ratio["mass_mg"],
                "volume_ml": ratio["volume_ml"],
                "conc_mg_per_ml": ratio["conc_mg_per_ml"],
            })

    # Style B (multi-strength): pick the presentation with the largest MDD/mass
    if presentations:
        # Prefer the one whose API mass is largest (worst case)
        chosen = max(presentations, key=lambda p: p["mass_mg"])
        selected_qty_col = chosen["column"]
        dose_volume_ml = chosen["volume_ml"]
        strength_mg_per_ml = chosen["conc_mg_per_ml"]
        if api_per_dose_mg <= 0:
            api_per_dose_mg = chosen["mass_mg"]
            mdd_source = "ratio_header"
        audit["selected_presentation"] = chosen

    # Medroxy-style: single ratio header on the qty column
    if dose_volume_ml <= 0 and qty_columns:
        vol = parse_volume_from_header(qty_columns[0])
        if vol:
            dose_volume_ml = vol
            selected_qty_col = qty_columns[0]
            # API qty from that column on the API row
            if api_idx is not None:
                qtxt = _row_field(rows[api_idx], qty_columns[0])
                qv = _sfloat(re.sub(r"[^0-9.\-]", "", qtxt)) if qtxt else 0.0
                if qv > 0 and api_per_dose_mg <= 0:
                    api_per_dose_mg = qv
                    mdd_source = "ratio_header"
            if dose_volume_ml > 0 and api_per_dose_mg > 0:
                strength_mg_per_ml = api_per_dose_mg / dose_volume_ml

    # explicit mg/mL column overrides strength if present
    if has_mgml and api_idx is not None:
        mtxt = _row_field(rows[api_idx], mgml_col, ["mg/ml"])
        mv = _sfloat(re.sub(r"[^0-9.\-]", "", mtxt)) if mtxt else 0.0
        if mv > 0:
            strength_mg_per_ml = mv

    # ── A8/C5: API dosed in USP units → mg via potency (additive, gated) ──────
    # If no mg-based API quantity was resolved above and the API row is expressed
    # in USP units with a stated potency (units/mg), convert units→mg. Gated on
    # api_per_dose_mg <= 0, so mg-based products (Medroxyprogesterone, etc.) are
    # never affected. For injections the elemental exposure derives from
    # volume × density (or component mass), so this MDD is a display value.
    api_units_per_dose = 0.0
    if api_idx is not None:
        _scan_cols = list(qty_columns)
        if selected_qty_col:
            _scan_cols.append(selected_qty_col)
        for qc in _scan_cols:
            api_units_per_dose = _parse_units(_row_field(rows[api_idx], qc))
            if api_units_per_dose > 0:
                break
        if api_units_per_dose <= 0:
            for _v in (rows[api_idx].get("columns", {}) or {}).values():
                api_units_per_dose = _parse_units(_sstr(_v))
                if api_units_per_dose > 0:
                    break
    if api_per_dose_mg <= 0 and api_units_per_dose > 0 and api_potency > 0:
        api_per_dose_mg = api_units_per_dose / api_potency
        mdd_source = "units_to_mg_via_potency"
        audit["api_units_per_dose"] = api_units_per_dose
        audit["api_potency_units_per_mg"] = api_potency
        warnings.append(
            f"API dosed in USP units: {api_units_per_dose:g} units ÷ "
            f"{api_potency:g} units/mg = {api_per_dose_mg:.4f} mg per dose.")

    # ── MDD ───────────────────────────────────────────────────────────────────
    doses = max(1, _sint(doses_per_day, 1))
    mdd_mg = api_per_dose_mg * doses if api_per_dose_mg > 0 else 0.0

    # density normalisation → g/mL. Excel-stated density ONLY here, so the
    # existing mass-based paths are byte-identical (the UI-density fallback is
    # confined to the volume-based branch below — FIX 4).
    density_g_per_ml = 0.0
    density_source = "none"
    if density_value > 0:
        density_g_per_ml = (density_value / 1000.0
                            if density_unit.lower() in ("mg/ml",) else density_value)
        density_source = "excel"

    # ── FIX 1/2/3/5: authoritative-MDD volume-based dosing for per-mL solutions ─
    # When a UI MDD is provided and the composition is per-mL, dosing is volume-
    # based (volume/day = MDD ÷ API conc/mL) and the UI MDD is authoritative — it
    # is NOT re-derived from the Excel. Falls back to the mass path when the API
    # per-mL concentration in the MDD's unit basis can't be resolved.
    per_ml_col = _detect_per_ml_col(qty_columns, mgml_col)
    volume_based: Optional[Dict] = None
    if _sfloat(mdd_value) > 0 and per_ml_col:
        # FIX 4: Excel density wins; else the optional UI density; else 1.0 (inside
        # compute_volume_based). Only the total grams / Option 2a-vs-2b use it.
        vb_density = density_g_per_ml if density_g_per_ml > 0 else _sfloat(ui_density)
        volume_based = compute_volume_based(
            rows, ingredient_col, function_col, per_ml_col, api_idx, product_name,
            _sfloat(mdd_value), _sstr(mdd_unit) or "mg", vb_density,
            api_potency=api_potency)
    if volume_based:
        # UI MDD is authoritative for the reported MDD (mg). When dosed in units,
        # convert to mg via potency if available; else leave the mg display at 0.
        if _sstr(mdd_unit).lower() in ("mg",):
            mdd_mg = _sfloat(mdd_value)
        elif api_potency > 0:
            mdd_mg = _sfloat(mdd_value) / api_potency
        dose_volume_ml = volume_based["volume_per_day_ml"]
        density_g_per_ml = volume_based["density_used"]
        if density_source == "none":
            density_source = "ui" if _sfloat(ui_density) > 0 else "default"
        mdd_source = "ui_mdd_volume_based"
        for _w in volume_based["warnings"]:
            warnings.append(_w)

    return {
        "table_style":          table_style,
        "ingredient_col":       ingredient_col,
        "function_col":         function_col,
        "mgml_col":             mgml_col,
        "mdd_col":              mdd_col,
        "qty_columns":          qty_columns,
        "selected_qty_col":     selected_qty_col,
        "columns":              columns,
        "rows":                 rows,
        "api_row_index":        api_idx,
        "api_row_method":       api_method,
        "api_per_dose_mg":      round(api_per_dose_mg, 6),
        "api_units_per_dose":   round(api_units_per_dose, 6),
        "api_potency_units_per_mg": round(api_potency, 6),
        "doses_per_day":        doses,
        "mdd_mg":               round(mdd_mg, 6),
        "mdd_source":           mdd_source,
        "dose_volume_ml":       round(dose_volume_ml, 6),
        "strength_mg_per_ml":   round(strength_mg_per_ml, 6),
        "component_mdd":        component_mdd,         # {row_idx: value in mdd_col_unit}
        "mdd_col_unit":         mdd_col_unit,          # "g" | "mg" | "ug"
        "density_g_per_ml":     round(density_g_per_ml, 6),
        "density_source":       density_source,
        "presentations":        presentations,
        # FIX 1/2/3: authoritative UI MDD + volume-based model (None if inactive)
        "ui_mdd_value":         _sfloat(mdd_value),
        "ui_mdd_unit":          _sstr(mdd_unit) or "mg",
        "per_ml_col":           per_ml_col,
        "_volume_based":        bool(volume_based),
        "_vb":                  volume_based or {},
        "_vb_rows":             (volume_based or {}).get("vb_rows", []),
        "audit":                audit,
        "warnings":             warnings,
    }


# ── Calculation-model selection (unit-aware) ──────────────────────────────────
def detect_calculation_model(annexure_data: List[Dict]) -> Dict:
    """
    Decide mass-based (µg/g) vs volume-based (µg/mL) from the annexure units.
    Returns {model, concentration_unit, evidence, ambiguous}.
    """
    saw_mass = 0
    saw_vol = 0
    evidence: List[str] = []
    for ann in annexure_data or []:
        if not isinstance(ann, dict):
            continue
        mat = _sstr(ann.get("material_name", ""))
        for el in (ann.get("elements") or []):
            if not isinstance(el, dict):
                continue
            ru = (_sstr(el.get("raw_unit", "")) or
                  _sstr(el.get("concentration_unit", ""))).lower()
            if not ru:
                continue
            if ru in ("µg/ml", "ug/ml", "mcg/ml"):
                saw_vol += 1
                evidence.append(f"{mat}: µg/mL")
            elif ru in ("ppm", "µg/g", "ug/g", "mg/kg", "ppb", "ng/g", "%", "mg/g"):
                saw_mass += 1
                evidence.append(f"{mat}: {ru}")
    ambiguous = (saw_mass == 0 and saw_vol == 0)
    if saw_vol > 0 and saw_vol >= saw_mass:
        model = "volume_based"
        conc_unit = "ug/mL"
    else:
        model = "mass_based"
        conc_unit = "ug/g"
    return {
        "model": model,
        "concentration_unit": conc_unit,
        "evidence": evidence[:12],
        "ambiguous": ambiguous,
        "n_mass": saw_mass,
        "n_volume": saw_vol,
    }


