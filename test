# 2. ANNEXURE CONVERTER — solvent declarations (consistent schema, evidence typing)
# ════════════════════════════════════════════════════════════════════════════
def rs_annexure_prompt() -> str:
    return (
        "You are reading a pharmaceutical annexure for a RESIDUAL SOLVENT risk "
        "assessment (USP <467> / ICH Q3C). The document may be a supplier "
        "declaration, COA, specification, regulatory statement, or SDS.\n\n"
        "Identify the MATERIAL the document is about, distinguishing it from the "
        "DOCUMENT TYPE. Generic phrases like 'Product Quality Statement', "
        "'Quality and Regulatory Information Summary', 'Product Regulatory "
        "Information', 'Safety Data Sheet', 'Material Characterization', 'Residual "
        "Solvents Statement', 'Regulatory Information' are document types, NOT "
        "material names. The material is the SUBJECT, usually found after patterns "
        "like 'for:', 'Product Name:', 'Product identifier:', 'Subject:', 'RE:', "
        "'Product / Manufacturing plant:', 'Supplier product number and name:'. "
        "A letter addressed to a customer often names the CUSTOMER'S finished "
        "product or its active ingredient ('for use in ... tablets', 'Customer "
        "product', 'Project', 'Your product'): that is NOT the material this "
        "document is about - never return it as material_name or as a candidate; "
        "leave material_name empty rather than use it.\n\n"
        "Extract solvent evidence. Solvent statements may be numeric (NMT X ppm, "
        "X ppm, X%), BDL/ND, or textual ('solvents listed in USP <467> are not "
        "used', 'water is the only solvent used', 'no source for residual "
        "solvents', 'testing not required because solvent is not used', 'ethyl "
        "alcohol may be present up to 0.5% maximum', 'controlled by vendor "
        "specification').\n\n"
        "IMPORTANT: A solvent_name must be a SPECIFIC chemical solvent (e.g. "
        "Ethanol, Methanol, Acetone, Toluene, Isopropyl alcohol, Ethylene glycol, "
        "1,4-Dioxane, Heptane). NEVER put a category or declaration scope as a "
        "solvent_name — phrases like 'Class 1/2/3 solvents', 'Class I/II/III "
        "solvents', 'OVI', 'Organic Volatile Impurities', 'other residual "
        "solvents', 'residual solvents', 'ICH Q3C solvents', 'USP <467> solvents', "
        "'solvents listed in USP <467>', and 'water' are scopes, NOT solvents. "
        "Record those only via negative_declaration=true and raw_text.\n\n"
        "WHICH SECTION A NUMBER CAME FROM (critical — a substance is a residual "
        "solvent only where the document presents it as one): report a substance "
        "ONLY when this document presents it as a solvent - a residual-solvent "
        "table or section, a USP <467> / ICH Q3C / OVI table, or prose saying it "
        "is used, generated, controlled or tested as a solvent. A GENERAL "
        "CHEMICAL INVENTORY or screening checklist - a section titled like "
        "'Other Chemicals Not Tested', 'Substances not intentionally added', an "
        "allergen / contaminant / heavy-metal / elemental-impurity list - is NOT "
        "residual-solvent evidence, even when it prints a limit like 'nmt 10 "
        "ppm' beside a name, and even when the name IS a solvent (formic acid, "
        "triethylamine). Do not report those substances at all. For every "
        "solvent you do report, copy the heading of the section or table you "
        "read it from, verbatim, into source_section.\n\n"
        "TABULAR ROWS: when a row is labelled by a peak/impurity id with the "
        "chemical in parentheses ('Impurity B (Acetone)', 'Impurity A "
        "(Chloroform)'), the solvent_name is the parenthesized chemical → "
        "'Acetone', 'Chloroform'.\n\n"
        "REGULATORY-CONTEXT NUMBERS (critical — do NOT extract as material "
        "limits): a number that appears next to guideline/policy language is a "
        "REFERENCE, not this material's limit. Treat as evidence_type="
        "policy_statement (never numerical_limit/nmt) when the surrounding text "
        "says any of: 'PDE value of X mg/day', 'concentration limit of X ppm', "
        "'based on information of USP and EDQM', 'will not be implemented', "
        "'reverted back to', 'the guideline states', 'ICH Q3C (R7) updated', "
        "'in accordance with the above-mentioned guideline'. A generic residual-"
        "solvent policy letter (no specific material subject) must yield NO "
        "numeric solvents[] — only policy_statement scope entries.\n"
        "A non-USP-<467> solvent that DOES carry a genuine measured/spec value "
        "(e.g. CPME 1500 ppm, TFA 3400 ppm) IS a real solvent — keep it in "
        "solvents[] with its number; do not discard it.\n"
        "For a below-detection result, put the marker (BDL/BQL/ND/<LOD/<LOQ) in "
        "raw_value AND include the spec limit ('NMT 5000 ppm') in raw_text.\n\n"
        "BOTH A RESULT AND A SPEC LIMIT (critical — never drop the spec): many "
        "CoAs show a measured result AND its specification/limit for the SAME "
        "solvent — a 'Result | Specification' or 'Actual | Limit' table, a range "
        "'159 - 5000', '24 to 60', '0.00 - 1000', a form '159 (NMT 5000)', or "
        "'result 29 ppm, spec NMT 3000 ppm'. In every such case you MUST capture "
        "BOTH numbers: set raw_value to the SPEC LIMIT (the larger, NMT value) and "
        "put the COMPLETE evidence VERBATIM in raw_text including the measured "
        "result AND the spec (e.g. raw_text='159 - 5000 ppm' or 'result 159 ppm; "
        "specification NMT 5000 ppm'). Set evidence_type='nmt'. NEVER return only "
        "the measured result and silently discard the spec limit, and NEVER return "
        "only the spec and discard the measured result — raw_text must contain "
        "both so the worst-case can be selected downstream.\n"
        "If ONLY a measured result is given (no spec/NMT anywhere for that "
        "solvent), report just that value (raw_value=the result, "
        "evidence_type='coa_statement'); do NOT invent a spec limit.\n"
        "A COMPARISON TO A GUIDELINE IS NOT A SECOND SPEC (critical — this is "
        "the one case where the LARGER number must NOT be taken): a sentence "
        "that compares the material's own level to a broader standard — 'used "
        "at levels <100 ppm, which is significantly less than the USP/NF "
        "guideline of < 5000 ppm', 'NMT 100 ppm, well below the ICH Q3C limit "
        "of 5000 ppm' — states ONE value for this material (100) and ONE "
        "regulatory REFERENCE (5000). The rule above ('take the larger') "
        "applies ONLY when the source presents two numbers as the material's "
        "OWN result/specification pair: a 'Result | Specification' table, an "
        "'Actual | NMT' column pair, or a numeric range. It NEVER applies when "
        "one of the numbers is introduced as a guideline, a compendial limit, "
        "an Option 1 limit, a PDE or an industry standard. Set raw_value to the "
        "MATERIAL's number (100), and put the reference in limit_value with "
        "limit_label naming the guideline.\n"
        "raw_text IS THE AUDIT TRAIL — copy the WHOLE sentence or table row "
        "VERBATIM, with the words that introduce each number ('specification', "
        "'guideline', 'as per USP/NF', 'significantly less than'). Never trim "
        "raw_text to the solvent name or to a bare number: those introducing "
        "words are what decides whose number it is, and without them a "
        "guideline's value is read as the material's content.\n\n"
        "CONTENT COLUMN vs LIMIT COLUMN (critical): when a table prints the "
        "material's own CONTENT ('Maximum Expected Amount', 'Expected', 'Typical', "
        "'Content') beside a LIMIT ('Option 1 Limit', 'ICH limit', 'USP limit', "
        "'Specification', 'NMT'), copy each into its own field - content_value with "
        "content_label (the content column's header) and limit_value with "
        "limit_label (the limit column's header) - and keep both, with their "
        "labels, in raw_text. An Option 1 / ICH / USP limit is a regulatory "
        "reference, never the material's content.\n\n"
        "SEVERAL PRODUCTS IN ONE DOCUMENT: list every product the document covers in "
        "covered_materials, and set material_name on each solvent row to the product "
        "that statement belongs to; leave both empty for a one-product document.\n\n"
        "Return ONLY valid JSON (an OBJECT, never a bare array):\n"
        "{\n"
        '  "supplier_name": "",\n'
        '  "material_name": "",\n'
        '  "material_name_candidates": [],\n'
        '  "covered_materials": [],\n'
        '  "document_title": "",\n'
        '  "annexure_type": "supplier_declaration | coa | specification | sds | statement | other",\n'
        '  "solvents": [\n'
        '    {"solvent_name":"", "raw_text":"", "raw_value":"", "raw_unit":"ppm|%|none",\n'
        '     "content_value":"", "content_label":"", "limit_value":"", "limit_label":"",\n'
        '     "material_name":"", "source_section":"",\n'
        '     "evidence_type":"numerical_limit|percentage_limit|nmt|negative_declaration|'
        'no_source|controlled_by_spec|coa_statement|policy_statement|ambiguous", "page":1}\n'
        "  ],\n"
        '  "negative_declaration": false,\n'
        '  "raw_text": ""\n'
        "}"
    )


# Document-descriptor stripping (reuse the RS-specific list)
_RS_DOC_DESCRIPTORS = [
    "product quality statement", "quality and regulatory information summary",
    "product regulatory information", "regulatory information", "safety data sheet",
    "material characterization", "material characterisation", "residual solvents statement",
    "residual solvent statement", "certificate of analysis", "specification",
    "technical data sheet", "quality statement", "declaration", "statement",
    "insights from the experts", "residual solvents", "residual solvent",
]
_RS_CONNECTORS = (" for ", " of ", " on ", ":", " - ", " – ", " re ")


def rs_strip_descriptor(name: str) -> str:
    if not name:
        return ""
    s = " ".join(_s(name).split())
    low = s.lower()
    for desc in _RS_DOC_DESCRIPTORS:
        if low.startswith(desc):
            rest = s[len(desc):]
            rl = rest.lower()
            for conn in _RS_CONNECTORS:
                if rl.startswith(conn):
                    subj = rest[len(conn):].strip(" :-–").strip()
                    sl = subj.lower()
                    if sl in _RS_DOC_DESCRIPTORS or \
                       any(sl.startswith(d) for d in _RS_DOC_DESCRIPTORS) or \
                       "insights" in sl or "experts" in sl:
                        return ""
                    return subj
            if not rest.strip(" :-–"):
                return ""
    if low in _RS_DOC_DESCRIPTORS:
        return ""
    return s


#: A mass fraction of one per cent is ten thousand parts per million. Exact.
PERCENT_TO_PPM = Decimal(1).scaleb(4)
#: A part per billion is a thousandth of a part per million. Exact.
PPB_TO_PPM = Decimal(1).scaleb(-3)


def _percent_to_ppm(v: Any) -> Decimal:
    return _MUL(v, PERCENT_TO_PPM)          # 0.5% → 5000 ppm


def _convert_to_ppm_exact(raw_value: Any, raw_unit: str) -> Optional[Decimal]:
    """A stated concentration in ppm, exactly, or ``None`` when it is not a
    number. Every conversion factor is a power of ten written as one."""
    v = _EV.dec_or_none(raw_value)
    if v is None:
        return None
    u = (raw_unit or "").strip().lower()
    if u in ("%", "percent", "w/w%", "percentage"):
        return _percent_to_ppm(v)
    if u in ("ppm", "mg/kg", "µg/g", "ug/g", "mg/l", ""):
        return v
    if u in ("ppb", "µg/kg", "ug/kg"):
        return _MUL(v, PPB_TO_PPM)
    return v


def _convert_to_ppm(raw_value: Any, raw_unit: str) -> Optional[float]:
    """Boundary form of :func:`_convert_to_ppm_exact` for JSON and display."""
    exact = _convert_to_ppm_exact(raw_value, raw_unit)
    return None if exact is None else _FLOAT(exact)


def _infer_material_from_filename(filename: str) -> str:
    """Infer a material name from an annexure filename as a STRICT LAST RESORT.
    Strips: extension, '(Annexure N)' / '_annexure_N' patterns, SAP/GRN prefixes
    (RCQR/RCRR/GRN + digits), dates (YYYY-MM-DD or DDMMYYYY), long numeric IDs
    (6+ digits), and document-type words. Returns '' if nothing meaningful remains.
    Example: 'Citric acid (Annexure 14).pdf' → 'Citric acid'."""
    if not filename:
        return ""
    s = _s(filename)
    s = re.sub(r"\.(pdf|json|docx?|xlsx?|png|jpe?g|tiff?)$", "", s, flags=re.IGNORECASE)
    # "(Annexure 14)" or "_annexure_14" or "annexure-14"
    s = re.sub(r"[\(\[]?\s*annexure[\s_\-]*\d+\s*[\)\]]?", " ", s, flags=re.IGNORECASE)
    # SAP/GRN/AR style prefixes: RCQR00022, RCRR123, GRN456
    s = re.sub(r"\b(RCQR|RCRR|GRN|AR|ATR|SAP)[\-_ ]?\d{2,}\b", " ", s, flags=re.IGNORECASE)
    # separators → spaces (before numeric strips so _-bounded IDs are seen)
    s = re.sub(r"[_\-]+", " ", s)
    # dates YYYY-MM-DD, DD-MM-YYYY, DDMMYYYY, YYYYMMDD
    s = re.sub(r"\b\d{4}[\-/]\d{2}[\-/]\d{2}\b", " ", s)
    s = re.sub(r"\b\d{2}[\-/]\d{2}[\-/]\d{4}\b", " ", s)
    s = re.sub(r"\b\d{8}\b", " ", s)
    # long numeric IDs (6+ digits)
    s = re.sub(r"\b\d{6,}\b", " ", s)
    # strip document-type words
    _docwords = (r"coa|certificate\s+of\s+analysis|specification|spec|declaration|"
                 r"statement|sds|msds|regulatory|quality|residual\s+solvents?|"
                 r"annexure|monograph|information|report|final|copy")
    s = re.sub(r"\b(" + _docwords + r")\b", " ", s, flags=re.IGNORECASE)
    s = re.sub(r"\s+", " ", s).strip(" -–:_")
    # strip a leading connector left over from "... declaration of <material>"
    s = re.sub(r"^(?:of|for|on|re|the)\s+", "", s, flags=re.IGNORECASE).strip()
    # reject if what remains is empty or a pure number
    if not s or re.fullmatch(r"[\d\s.]+", s):
        return ""
    return s


# ── BDL / spec-limit / policy / dedup helpers (RS RF3, RF14, RF15) ────────────
# Below-detection markers: the result is not a number, so a per-batch actual is
# unavailable — the spec limit (NMT) is used for a worst-case exposure (RF15).
_RS_BDL_VALUES = {
    "bdl", "bql", "nd", "not detected", "notdetected", "< lod", "<lod",
    "< loq", "<loq", "below detection", "below detection limit",
    "below quantification", "below quantitation", "not quantifiable", "absent",
}
# Numeric spec limit inside free text: "NMT 5000 ppm", "Not more than 600 ppm",
# "≤ 3000 ppm", "limit 5000 ppm", "0.5 %". Trailing form "5000 ppm max" too.
_RS_NMT_TEXT_RE = re.compile(
    r"(?:nmt|not\s+more\s+than|max(?:imum)?|≤|<=|limit(?:\s+of)?|spec(?:ification)?"
    r"(?:\s+limit)?)\s*[:=]?\s*(\d+(?:\.\d+)?)\s*(ppm|%|mg/kg)?",
    re.IGNORECASE)
_RS_NMT_TRAILING_RE = re.compile(
    r"(\d+(?:\.\d+)?)\s*(ppm|%)\s*(?:max|maximum)\b", re.IGNORECASE)
# "Below the quantitation limit, which is X" — a vendor spec column printed as
# "<QL (500ppm)", "<QL(89ppm)", "< LOQ 0.05 ppm". The marker sits between the
# "<" and the digits, so neither the NMT patterns above (they need their
# keyword next to the number) nor _RS_LESS_THAN_RE (it needs a digit straight
# after the "<") can see the number, and the vendor's own bound is lost. The
# content is below X, so X is its worst case — the same reading _RS_LESS_THAN_RE
# gives a plain "<X". Only an explicit "<"/"≤" + limit-marker + number counts;
# a bare "BDL"/"ND" keeps its existing manual-review outcome.
_RS_QL_BOUND_RE = re.compile(
    r"[<≤]\s*=?\s*(?:ql|loq|lod|dl|rl)\b\s*[\(\[]?\s*"
    r"(\d+(?:\.\d+)?)\s*(ppm|%|ppb|mg\s*/\s*kg)?\s*[\)\]]?", re.IGNORECASE)

# Regulatory-context phrases: a number appearing next to these is a guideline
# REFERENCE, not a material limit (policy-letter false extraction — RF3).
_RS_POLICY_CONTEXT_RE = re.compile(
    r"pde\s+value|permitted\s+daily\s+exposure|concentration\s+limit\s+of|"
    r"based\s+on\s+information\s+of\s+usp|will\s+not\s+be\s+implemented|"
    r"reverted\s+back|the\s+guideline\s+states|edqm|"
    r"in\s+accordance\s+with\s+the\s+above|as\s+per\s+the\s+(?:above\s+)?guideline",
    re.IGNORECASE)
# Generic policy-letter titles (no specific material qualifier).
_RS_POLICY_TITLE_RE = re.compile(
    r"^(residual\s+solvents?|ich\s*q3c|regulatory\s+(?:information|update|position)|"
    r"quality\s+(?:and\s+regulatory\s+)?(?:information|statement)|policy)\b",
    re.IGNORECASE)


def _extract_nmt_ppm_from_text(text: str) -> Optional[float]:
    """Pull a spec limit (worst-case, largest) in ppm from free text, converting
    percentages (0.5 % → 5000 ppm). Returns None when no NMT-style number found."""
    if not text:
        return None
    best = _extract_nmt_ppm_exact(text)
    return None if best is None else _FLOAT(best)


def _extract_nmt_ppm_exact(text: str) -> Optional[Decimal]:
    """:func:`_extract_nmt_ppm_from_text` without the float boundary."""
    if not text:
        return None
    best: Optional[Decimal] = None
    for rx, unit_grp in ((_RS_NMT_TEXT_RE, 2), (_RS_NMT_TRAILING_RE, 2),
                         (_RS_QL_BOUND_RE, 2)):
        for m in rx.finditer(text):
            # RS-7 — the largest of the MATERIAL's numbers only: a number a
            # guideline introduces is the guideline's, whatever its size.
            if _rs_number_is_reference(text, m.start(1), m.end(1)):
                continue
            val = _EV.dec_or_none(m.group(1))
            if val is None:
                continue
            unit = (m.group(unit_grp) or "ppm").lower()
            ppm = _percent_to_ppm(val) if unit == "%" else val
            if best is None or ppm > best:
                best = ppm
    return best


# A bare guideline NAME is not, on its own, policy context. "ICH Q3C" is the
# standard a residual-solvent specification cites, so it gets the same
# citation-vs-reference rule USP <467> already has: a citation attached to the
# material's OWN spec wording ("Methanol: NMT 3000 ppm as per ICH Q3C",
# "Toluene NMT 890 ppm (ICH Q3C R8)") leaves that statement the material's,
# while a standalone mention - or one used as a reference noun, "the ICH Q3C
# limit is ..." - is the guideline's. Decided from the words around the
# mention, never from the solvent, the product or the value. A guideline SHEET
# is still excluded by provenance (RF3, at the end of process_rs_annexure).
_RS_BARE_STANDARD_RE = re.compile(r"\bich\s*q3c\b", re.IGNORECASE)


def _rs_clause_span(text: str, start: int, end: int) -> Tuple[int, int]:
    """The statement ``text[start:end]`` sits in, cut at the clause breaks."""
    lo = 0
    for m in _RS_CLAUSE_BREAK_RE.finditer(text, 0, start):
        lo = m.end()
    nxt = _RS_CLAUSE_BREAK_RE.search(text, end)
    return lo, (nxt.start() if nxt else len(text))


def _rs_standard_cites_own_spec(text: str, m: re.Match) -> bool:
    """True when the guideline mention ``m`` is the citation ON a material's own
    specification: it is not part of a regulatory reference noun, and its own
    clause states an NMT/spec number that no reference introduces."""
    for rm in _RS_REFERENCE_NOUN_RE.finditer(text):
        if rm.start() < m.end() and m.start() < rm.end():
            return False
    lo, hi = _rs_clause_span(text, m.start(), m.end())
    return _extract_nmt_ppm_exact(text[lo:hi]) is not None


def _rs_is_policy_context(raw_text: str) -> bool:
    if not raw_text:
        return False
    if _RS_POLICY_CONTEXT_RE.search(raw_text):
        return True
    mentions = list(_RS_BARE_STANDARD_RE.finditer(raw_text))
    return bool(mentions) and not any(
        _rs_standard_cites_own_spec(raw_text, m) for m in mentions)


# ── RS content-ppm classifier (Categories A–G) ────────────────────────────────
# The vendor CoA converter emits an inconsistent converted_ppm when a statement
# carries BOTH a batch-actual value and a spec limit (a "159 - 5000" range, an
# "Actual | NMT" column pair, etc.) — sometimes it keeps the actual, sometimes
# the spec. This classifier makes converted_ppm DETERMINISTIC from raw text alone
# (vendor / product / compendium-agnostic):
#   A spec-limit only      → converted = the spec limit            (evidence "nmt")
#   B batch-actual only    → converted = the measured value        (evidence actual)
#   C actual + spec (range)→ converted = spec (worst-case); actual preserved
#   D BDL/BQL/ND + spec    → converted = spec (worst-case, BDL note)
#   E BDL/BQL/ND, no spec  → converted = None (needs review)
#   F negative declaration → handled by the caller (converted = 0)
#   G ambiguous            → converted = None (needs review)
# A batch actual is ≤ its spec by definition, so taking the spec never understates
# exposure. The smaller (actual) value is preserved for the audit trail.
# The leading \b used to sit outside the whole group, which made the "<LOD"
# alternative unreachable: "<" is not a word character, so there is no boundary
# between the preceding space and it. Each alternative now carries the boundary
# it actually needs, and the symbol forms ("<LOD", "≤ LOQ", "<QL") are read as
# the below-limit results they are.
_RS_BDL_TEXT_RE = re.compile(
    r"\b(?:bdl|bql|nd|not\s+detected|below\s+(?:detection|quantr?[ai]tation|"
    r"quantification))\b|[<≤]\s*(?:lo[dq]|ql|rl|dl)\b", re.IGNORECASE)
# Two numbers joined by a range/pair delimiter (-, –, to, <, |, /, ~), the 2nd
# optionally prefixed by </NMT/"not more than". Anchored on digits so a solvent
# name like "1,4-Dioxane" (no digit after the hyphen) does not false-match.
_RS_RANGE_PAIR_RE = re.compile(
    r"(\d+(?:\.\d+)?)\s*(?:ppm|%|mg/kg)?\s*(?:-|–|—|<|\||/|~|to|~to)\s*"
    r"(?:<|≤|<=|nmt\s+|not\s+more\s+than\s+)?\s*(\d+(?:\.\d+)?)",
    re.IGNORECASE)


def _rs_text_is_bdl(text: str) -> bool:
    return bool(text) and bool(_RS_BDL_TEXT_RE.search(text))


# ── RS-1 / RS-2: which column a number came from ─────────────────────────────
# A vendor table can print a REGULATORY limit ("Option 1 Limit", "ICH limit",
# "USP <467> limit") beside the material's own EXPECTED content ("Maximum
# Expected Amount in Finished Product", "Typical"). The content column is the
# material's content; the regulatory limit belongs only to the final
# comparison row, so it never becomes content - not beside the content, and
# not on its own. Detected from the column labels, never from the solvent or
# the product.
_RS_EXPECTED_LABEL_RE = re.compile(
    r"max(?:imum|\.)?\s+expected(?:\s+(?:amount|level|content|value|concentration))?|"
    r"expected\s+(?:maximum\s+)?(?:amount|level|content|value|concentration)|"
    r"typical(?:\s+(?:amount|level|content|value|concentration))?|"
    r"max(?:imum|\.)?\s+(?:amount|level|content)\s+(?:present|expected|in\s+(?:the\s+)?"
    r"(?:finished\s+)?product)|residual\s+(?:amount|level|content)|actual\s+content|"
    # A limit the MATERIAL's own side sets is the material's content, not a
    # guideline: "Vendor's Specification Limit", "Supplier limit", "In-house
    # spec", "Agreed limit". The word "limit" alone says nothing about whose
    # limit it is - only the qualifier beside it does, and these qualifiers name
    # the party that makes the material. Without this the header matched NEITHER
    # label pattern, so the vendor's own column was invisible and the ICH/USP
    # column beside it became the content.
    r"(?:vendor|supplier|manufacturer|producer|in[\s-]?house|internal|company|"
    r"agreed|contractual|site)(?:'?s)?\s+"
    r"(?:(?:specification|spec|acceptance|release|quality)\s+)?"
    r"(?:limit|specification|spec|value|level|content|criteri(?:on|a))",
    re.IGNORECASE)
_RS_REGULATORY_LABEL_RE = re.compile(
    r"option\s*[-\s]?(?:1|i)\b(?:\s+(?:limit|concentration|value))?|"
    r"\bich(?:\s*q3c)?(?:\s*\(r\d+\))?\s+(?:limit|concentration|value)|"
    r"\bq3c\s+(?:limit|concentration|value)|"
    r"\busp\s*(?:<\s*467\s*>)?\s+(?:limit|concentration|value)|<\s*467\s*>\s+limit|"
    r"permitted\s+(?:daily\s+exposure|concentration|limit)|\bpde\b|"
    r"regulatory\s+limit|limit\s+(?:as\s+)?per\s+(?:ich|usp|q3c)|class\s+[123]\s+limit",
    re.IGNORECASE)
# The number a label names: right after a separator, else one carrying a
# unit, else a bare number that is not part of a code ("85F565140").
_RS_LABEL_NUMBER_RES = (
    re.compile(r"^[\s:=|,\-–]*(?:\((?:ppm|%)\)\s*)?[:=|]?\s*[<≤]?\s*(\d+(?:\.\d+)?)"
               r"\s*(ppm|%|ppb|mg\s*/\s*kg)?(?![\w.])", re.IGNORECASE),
    re.compile(r"(?<![\w.])(\d+(?:\.\d+)?)\s*(ppm|%|ppb|mg\s*/\s*kg)\b", re.IGNORECASE),
    re.compile(r"(?<![\w.])(\d+(?:\.\d+)?)()(?![\w.])"),
)
_RS_LESS_THAN_RE = re.compile(
    r"(?:<|less\s+than|below)\s*(\d+(?:\.\d+)?)\s*(ppm|%|ppb|mg/kg)?", re.IGNORECASE)

# ── RS-7: a number a guideline governs is the guideline's ─────────────────────
# One vendor text can state the material's own specification AND the regulatory
# reference it sits under - "Ethanol: nmt 100 ppm ... significantly less than
# the USP/NF guideline of < 5000 ppm". The reference is not the material's
# value. Which one a number is, is decided by the words that INTRODUCE it (or
# name it straight after its unit) - never by comparing it with a limit.
#
# A reference NOUN ("guideline", "PDE", "Option 1 limit", "ICH limit") makes the
# number it introduces the reference's, even through "is NMT". A CITATION ("as
# per USP <467>") does so only for a bare number: "Methanol (as per ICH Q3C): NMT
# 3000 ppm" is the material's own specification citing its standard.
_RS_STANDARD_ALT = (r"(?:usp(?:\s*/\s*nf)?(?:\s*<\s*467\s*>)?|<\s*467\s*>|"
                    r"ich(?:\s*q3c)?(?:\s*\(\s*r\d+\s*\))?|q3c|ph\.?\s*eur\.?|edqm)")
_RS_REFERENCE_NOUN_RE = re.compile(
    r"\bguidelines?\b|significantly\s+(?:less|lower)\s+than|\bwell\s+below|"
    r"\bpde\b|permitted\s+(?:daily\s+exposure|concentration|limit)|"
    r"\boption\s*[-\s]?(?:1|i)\b(?:\s+(?:limit|concentration|value)s?)?|"
    r"\bregulatory\s+(?:limit|value|reference)s?|\bconcentration\s+limits?|"
    r"(?<![a-z])" + _RS_STANDARD_ALT + r"\s+(?:limit|concentration|value)s?\b|"
    r"\bclass\s+(?:[123]|i{1,3})\s+limits?|\blimits?\s+(?:as\s+)?per\s+"
    + _RS_STANDARD_ALT, re.IGNORECASE)
_RS_CITATION_RE = re.compile(
    r"\b(?:as\s+per|according\s+to|in\s+accordance\s+with|based\s+on"
    r"(?:\s+information\s+of)?)\s+(?:the\s+)?" + _RS_STANDARD_ALT, re.IGNORECASE)
_RS_STANDARD_NAME_RE = re.compile(_RS_STANDARD_ALT + r"|\bclass\s+(?:[123]|i{1,3})\b",
                                  re.IGNORECASE)
# A reference named straight after the number: "5000 ppm (USP/NF guideline)".
_RS_TRAILING_REFERENCE_RE = re.compile(
    r"\s*(?:ppm|ppb|%|mg\s*/\s*kg)?\s*[(\[,\-–—]?\s*"
    r"(?:i\.?e\.?,?\s*|which\s+is\s+|the\s+)?(?:" + _RS_STANDARD_ALT + r"\s*)?"
    r"(?:guidelines?\b|pde\b|permitted\s+daily\s+exposure|option\s*[-\s]?(?:1|i)\b|"
    r"regulatory\s+(?:limit|reference))", re.IGNORECASE)
# The words that may sit between a reference phrase and the number it governs.
_RS_REFERENCE_GAP_WORDS = frozenset(
    "of is are at the a an its this value values level levels limit limits "
    "concentration concentrations which being set ppm ppb mg kg "
    # the below-limit markers a bound may be written through ("<QL (5000 ppm)")
    "ql loq lod dl rl".split())
_RS_OWN_SPEC_WORDS = frozenset("nmt not more than max maximum".split())
# Where one statement ends and the next begins.
_RS_CLAUSE_BREAK_RE = re.compile(r"[;|\n]|(?<!\d)\.(?=\s|$)")
# A concentration a statement prints: a number with its unit.
_RS_CONC_NUMBER_RE = re.compile(r"(?<![\w.])(\d+(?:\.\d+)?)\s*(ppm|ppb|mg\s*/\s*kg|%)",
                                re.IGNORECASE)


def _rs_number_is_reference(text: str, start: int, end: int) -> bool:
    """True when the number at ``text[start:end]`` is a regulatory reference's:
    within its own clause a reference phrase introduces it, or one names it
    straight after its unit."""
    if not text:
        return False
    breaks = [m.end() for m in _RS_CLAUSE_BREAK_RE.finditer(text, 0, start)]
    clause = breaks[-1] if breaks else 0
    last, cited = None, False
    for rx, is_citation in ((_RS_REFERENCE_NOUN_RE, False), (_RS_CITATION_RE, True)):
        for m in rx.finditer(text, clause, start):
            if last is None or m.end() > last.end():
                last, cited = m, is_citation
    if last is not None:
        gap = _RS_STANDARD_NAME_RE.sub(" ", text[last.end():start])
        words = re.findall(r"[a-z]+", gap.lower())
        allowed = (_RS_REFERENCE_GAP_WORDS if cited
                   else _RS_REFERENCE_GAP_WORDS | _RS_OWN_SPEC_WORDS)
        if (not re.search(r"\d", gap) and len(words) <= 6
                and all(w in allowed for w in words)
                and not (cited and re.search(r"≤|<=", gap))):
            return True
    trailing = _RS_TRAILING_REFERENCE_RE.match(text, end)
    if not trailing:
        return False
    # "(PDE 30 mg/day)" names ITS OWN number, not the one before it.
    stop = re.search(r"[)\];|\n]|(?<!\d)\.(?=\s|$)", text[trailing.end():])
    tail = text[trailing.end():trailing.end() + stop.start() if stop else len(text)]
    return not re.search(r"\d", _RS_STANDARD_NAME_RE.sub(" ", tail))


def _rs_reference_only(text: str) -> bool:
    """True when every concentration a statement prints is a reference's."""
    found = [_rs_number_is_reference(text, m.start(1), m.end(1))
             for m in _RS_CONC_NUMBER_RE.finditer(text or "")]
    return bool(found) and all(found)


# ── RS-11: a statement trimmed to its number keeps the document's own words ───
# RS-1/RS-2/RS-7 decide whether a number is the material's or a guideline's from
# the words that INTRODUCE it. That only works while those words are still
# there. When the extractor returns raw_value "5000" but trims raw_text down to
# "Ethanol", every one of those rules is blind and the number is taken at face
# value as the material's content - so a sentence like "used at levels <100 ppm,
# which is significantly less than the USP/NF guideline of < 5000 ppm" can put
# the GUIDELINE's number in the exposure column.
# The document's own page text is still on the annexure, so the sentence that
# PRINTS this number is put back in front of the classifier and the existing
# rules judge it. Only the sentences carrying this exact number are added: no
# other value can be introduced, and a statement that already prints its own
# number is untouched. Nothing here looks at how big the number is.
_RS_SENTENCE_SPLIT_RE = re.compile(r"(?<=[.;\n])\s+")


def _rs_statement_context(doc_text: str, names: Iterable[str],
                          raw_text: str, raw_value: Any) -> str:
    """*raw_text*, plus the document's own sentences that print the number this
    statement carries, when *raw_text* does not print it itself."""
    val = _EV.dec_or_none(raw_value)
    if val is None or not _s(doc_text):
        return raw_text
    for m in _RS_CONC_NUMBER_RE.finditer(raw_text or ""):
        if _EV.dec_or_none(m.group(1)) == val:
            return raw_text          # the statement stands on its own words
    keys = [k.lower() for k in (_s(n) for n in names) if k]
    if not keys:
        return raw_text
    found = [s for s in _RS_SENTENCE_SPLIT_RE.split(doc_text)
             if any(k in s.lower() for k in keys)
             and any(_EV.dec_or_none(m.group(1)) == val
                     for m in _RS_CONC_NUMBER_RE.finditer(s))]
    if not found:
        return raw_text
    return (_s(raw_text) + " " + " ".join(dict.fromkeys(found))).strip()


def _rs_label_value_ppm(segment: str, default_unit: str) -> Optional[Decimal]:
    for rx in _RS_LABEL_NUMBER_RES:
        m = rx.search(segment)
        if m:
            return _convert_to_ppm_exact(m.group(1), (m.group(2) or default_unit
                                                      or "ppm").replace(" ", ""))
    return None


def _rs_labelled_numbers(text: str, default_unit: str) -> Dict[str, Any]:
    """The expected-content and regulatory-limit numbers a text names, and the
    text with the regulatory statements taken out."""
    spans = []
    for kind, rx in (("regulatory", _RS_REGULATORY_LABEL_RE),
                     ("expected", _RS_EXPECTED_LABEL_RE)):
        for m in rx.finditer(text or ""):
            spans.append((m.start(), m.end(), kind))
    spans.sort()
    kept: List[Tuple[int, int, str]] = []
    for span in spans:
        if kept and span[0] < kept[-1][1]:
            continue
        kept.append(span)
    found: Dict[str, List[Decimal]] = {"expected": [], "regulatory": []}
    cut: List[Tuple[int, int]] = []
    for i, (start, end, kind) in enumerate(kept):
        stop = kept[i + 1][0] if i + 1 < len(kept) else len(text)
        value = _rs_label_value_ppm(text[end:min(stop, end + 60)], default_unit)
        if value is not None:
            found[kind].append(value)
            if kind == "regulatory":
                cut.append((start, min(stop, end + 60)))
    remaining = text or ""
    for start, stop in reversed(cut):
        remaining = remaining[:start] + " " + remaining[stop:]
    return {"expected": found["expected"], "regulatory": found["regulatory"],
            "text_without_regulatory": remaining}


def _rs_strip_value(text: str, *values: Any) -> str:
    """*text* with the printed forms of *values* blanked out.

    Used to take a number a LABEL has already identified as the guideline's out
    of the text, so no later reader can pick it up again as the material's.
    """
    out = _s(text)
    for value in values:
        for token in {_s(value), ("" if value is None else _s(_dec_str(value)))}:
            if not token or not re.search(r"\d", token):
                continue
            out = re.sub(re.escape(token) + r"\s*(?:ppm|ppb|%|mg\s*/\s*kg)?",
                         " ", out, flags=re.IGNORECASE)
    return out


def _dec_str(value: Any) -> str:
    """A Decimal/float rendered the way a document prints it (no trailing 0s)."""
    dec = _EV.dec_or_none(value)
    if dec is None:
        return ""
    normalized = dec.normalize()
    return format(normalized, "f")


def _rs_cell_ppm(value: Any, unit: str) -> Optional[Decimal]:
    """One table CELL in ppm, whether it prints a plain number or a bound.

    A vendor states its own column as a bound as often as a number - "<QL
    (89ppm)", "≤890ppm", "NMT 3000 ppm", "<0.5 %". _convert_to_ppm_exact reads
    only a plain number, so every one of those cells came back None, the
    column was treated as absent, and the REGULATORY column beside it became
    the material's content. A bound's worst case is the bound, exactly as
    _classify_solvent_ppm already treats the same text.
    """
    direct = _convert_to_ppm_exact(value, unit)
    if direct is not None:
        return direct
    text = _s(value)
    if not text:
        return None
    bound = _extract_nmt_ppm_exact(text)     # NMT / ≤ / <QL (X) forms
    if bound is not None:
        return bound
    m = _RS_LESS_THAN_RE.search(text)        # a plain "<X"
    if m:
        return _convert_to_ppm_exact(m.group(1),
                                     (m.group(2) or unit or "ppm").replace(" ", ""))
    return None


def _rs_labelled_content(sv: Dict, raw_unit: str, raw_text: str) -> Optional[Dict]:
    """Which number is the content when the source names its columns, or None.

    Structured fields from the extractor (``content_value`` / ``limit_value``
    with their labels) come first; otherwise the labels are read from the text.
    """
    content = _rs_cell_ppm(sv.get("content_value"),
                           _s(sv.get("content_unit")) or raw_unit)
    limit = _rs_cell_ppm(sv.get("limit_value"),
                         _s(sv.get("limit_unit")) or raw_unit)
    if content is not None or limit is not None:
        limit_label = _s(sv.get("limit_label"))
        content_label = _s(sv.get("content_label"))
        # The HEADER says which column is which, not the field it arrived in.
        # When an extractor files the guideline's column as the content and the
        # material's own column as the limit, the labels say so plainly - follow
        # them, so the guideline's number can never become the content because
        # of where it was put.
        if (_RS_REGULATORY_LABEL_RE.search(content_label)
                and _RS_EXPECTED_LABEL_RE.search(limit_label)):
            content, limit = limit, content
            content_label, limit_label = limit_label, content_label
        regulatory = (bool(_RS_REGULATORY_LABEL_RE.search(limit_label))
                      or _s(sv.get("limit_is_regulatory")).lower() in ("true", "yes", "1"))
        expected = (not content_label
                    or bool(_RS_EXPECTED_LABEL_RE.search(content_label)))
        # The structured path used to hand the FULL raw_text on as "remaining",
        # so the regulatory number the labels had ALREADY identified was still
        # in the text and could be read back as the material's own - and
        # regulatory_only could never fire, because the reference's own number
        # always answered the "is there a vendor number left?" question. Once a
        # label says a number is the guideline's, that number leaves the text.
        remaining = (_rs_strip_value(raw_text, sv.get("limit_value"), limit)
                     if regulatory else raw_text)
    else:
        nums = _rs_labelled_numbers(raw_text, raw_unit)
        content = max(nums["expected"]) if nums["expected"] else None
        limit = max(nums["regulatory"]) if nums["regulatory"] else None
        regulatory, expected = limit is not None, content is not None
        remaining = nums["text_without_regulatory"]
        if content is None and limit is None:
            return None
    if content is not None and (expected or regulatory or limit is None):
        return {"converted": _FLOAT(content), "spec": _FLOAT(limit) if limit is not None
                else None, "actual": None,
                "basis": "vendor_expected_content",
                "note": ("the material's stated content; the limit column beside it "
                         "is kept for the comparison row only")}
    if content is not None and limit is not None:
        # A batch result beside the vendor's OWN specification: the
        # specification is the worst-case content, the result is preserved.
        return {"converted": _FLOAT(max(content, limit)), "spec": _FLOAT(limit),
                "actual": _FLOAT(content), "basis": "nmt_with_batch_actual",
                "note": "vendor specification taken for worst-case exposure; "
                        "batch result preserved"}
    if limit is not None and regulatory:
        vendor_spec = _extract_nmt_ppm_exact(remaining)
        if vendor_spec is None:
            return {"regulatory_only": _FLOAT(limit)}
        return {"text": remaining}
    return None


def _classify_solvent_ppm(raw_value: Any, raw_unit: str, raw_text: str,
                          is_bdl: bool = False) -> Dict[str, Any]:
    """Classify a solvent statement into Categories A–G and return
    {converted_ppm, actual_measured_ppm, spec_limit_ppm, category,
     calculation_basis, note}. Decides on text content only."""
    unit = (_s(raw_unit) or "").strip().lower()
    blob = f"{_s(raw_value)} {_s(raw_text)}".strip()

    def _to_ppm(v: Any, u: Optional[str] = None) -> Decimal:
        uu = (u or unit or "ppm").lower()
        if uu in ("%", "percent", "percentage", "w/w%"):
            return _percent_to_ppm(v)
        if uu in ("ppb", "µg/kg", "ug/kg"):
            return _MUL(v, PPB_TO_PPM)
        return _D(v)  # ppm, mg/kg, µg/g, mg/l, none

    out = {"converted_ppm": None, "actual_measured_ppm": None,
           "spec_limit_ppm": None, "category": "G",
           "calculation_basis": "ambiguous", "note": ""}

    is_bdl = is_bdl or _rs_text_is_bdl(raw_text)
    nmt_exact = _extract_nmt_ppm_exact(blob)       # largest NMT-context number
    nmt_ppm = None if nmt_exact is None else _FLOAT(nmt_exact)
    has_pct = "%" in blob

    # Category C — a numeric range (actual … spec). Worst-case = the larger value;
    # the smaller is the batch actual. Skipped when both sides are equal, and
    # when either side is a guideline's number rather than the material's (RS-7).
    m = _RS_RANGE_PAIR_RE.search(blob)
    if m and not is_bdl and not any(
            _rs_number_is_reference(blob, m.start(g), m.end(g)) for g in (1, 2)):
        a = _EV.dec_or_none(m.group(1))
        b = _EV.dec_or_none(m.group(2))
        if a is not None:
            a = _to_ppm(a, "%" if has_pct else None)
        if b is not None:
            b = _to_ppm(b, "%" if has_pct else None)
        if a is not None and b is not None and a != b:
            lo, hi = (_FLOAT(x) for x in sorted((a, b)))
            out.update({"converted_ppm": hi, "actual_measured_ppm": lo,
                        "spec_limit_ppm": hi, "category": "C",
                        "calculation_basis": "nmt_with_batch_actual",
                        "note": "range: spec limit taken for worst-case exposure; "
                                "batch actual preserved"})
            return out

    # Categories D / E — below-detection result.
    if is_bdl:
        if nmt_ppm is not None:
            out.update({"converted_ppm": nmt_ppm, "spec_limit_ppm": nmt_ppm,
                        "category": "D", "calculation_basis": "nmt_conservative_bdl",
                        "note": "BDL result; using spec limit for worst-case exposure"})
        else:
            out.update({"category": "E", "calculation_basis": "unresolved_bdl",
                        "note": "BDL result with no spec limit; manual review"})
        return out

    primary_exact = _convert_to_ppm_exact(raw_value, raw_unit)  # model's value
    # RS-7 — the model's number is a guideline's when the statement prints it
    # only where a guideline introduces it; the statement's own printed
    # concentration, when it has one, is then the material's.
    if primary_exact is not None and raw_text:
        printed = [(p, _convert_to_ppm_exact(p.group(1), re.sub(r"\s+", "", p.group(2))))
                   for p in _RS_CONC_NUMBER_RE.finditer(raw_text)]
        same = [p for p, v in printed if v == primary_exact]
        if same and all(_rs_number_is_reference(raw_text, p.start(1), p.end(1))
                        for p in same):
            own = [v for p, v in printed if v is not None
                   and not _rs_number_is_reference(raw_text, p.start(1), p.end(1))]
            primary_exact = max(own) if own else None
    primary = None if primary_exact is None else _FLOAT(primary_exact)

    # Category A — a spec limit is present (NMT/≤/limit wording).
    if nmt_ppm is not None:
        actual = (primary if (primary_exact is not None
                              and primary_exact < nmt_exact) else None)
        out.update({"converted_ppm": nmt_ppm, "spec_limit_ppm": nmt_ppm,
                    "actual_measured_ppm": actual, "category": "A",
                    "calculation_basis": "nmt_conservative",
                    "note": ("spec limit; lower actual preserved"
                             if actual is not None else "spec limit")})
        return out

    # Category B — a single measured value with no spec context.
    if primary is not None:
        out.update({"converted_ppm": primary, "actual_measured_ppm": primary,
                    "category": "B", "calculation_basis": "batch_actual",
                    "note": "measured content (no spec limit in text)"})
        return out

    # Category D — a stated upper bound ("<100 ppm", "less than 0.5 %") with no
    # specification beside it: the content is below X, so X is its worst case.
    lt = next((x for x in _RS_LESS_THAN_RE.finditer(blob)
               if not _rs_number_is_reference(blob, x.start(1), x.end(1))), None)
    if lt:
        bound = _EV.dec_or_none(lt.group(1))
        if bound is not None and bound > 0:
            lt_unit = (lt.group(2) or "").lower()
            ppm = _to_ppm(bound, "%" if lt_unit == "%" else (lt_unit or None))
            out.update({"converted_ppm": _FLOAT(ppm), "category": "D",
                        "calculation_basis": "stated_upper_bound",
                        "note": "stated '<X' bound; the bound is the worst-case "
                                "content"})
            return out

    # Category G — nothing numeric could be resolved.
    return out


# RS Bug 3: compendial-variant detection for same-solvent dedup. A USP <467>
# assessment must prefer the USP/NF limit when an annexure lists the same solvent
# under several compendia (e.g. Acetone: EP NMT 1000 ppm vs USP/NF NMT 5000 ppm).
# Priority USP/NF > Ph.Eur/EP > JP > ASMF/in-house/other. Detected from the
# solvent name + its evidence raw_text; absence of any descriptor scores 0 so it
# never perturbs the existing worst-case ranking (no regression for annexures
# that do not tag a compendium).
_COMPENDIAL_USP_RE = re.compile(
    r"\b(usp(?:\s*[/\-]?\s*nf)?|u\.?s\.?p\.?|national\s+formulary|nf)\b", re.IGNORECASE)
_COMPENDIAL_EP_RE = re.compile(
    r"\b(ph\.?\s*eur\.?|eur\.?\s*ph\.?|european\s+pharmacop(?:o)?eia|ep)\b", re.IGNORECASE)
_COMPENDIAL_JP_RE = re.compile(
    r"\b(jp|japanese\s+pharmacop(?:o)?eia)\b", re.IGNORECASE)
_COMPENDIAL_OTHER = ("asmf", "in-house", "in house", "dmf", "cep")

# RS Bug 1: the priority order among compendial variants depends on the project's
# assessment framework (chosen at project start; USP <467> is the default and the
# US-market default). Each framework maps a detected compendium category to a
# rank (higher = preferred). Category "OTHER" = ASMF/in-house/DMF/CEP. A missing
# category scores 0 so it never perturbs the worst-case ppm ranking (no
# regression for annexures that do not tag a compendium).
DEFAULT_RS_FRAMEWORK = "USP <467>"
_RS_FRAMEWORK_PRIORITY: Dict[str, Dict[str, int]] = {
    # USP <467> / plain USP / ICH Q3C: USP/NF > Ph.Eur/EP > JP > ASMF/other
    "USP <467>": {"USP": 4, "EP": 3, "JP": 2, "OTHER": 1},
    "USP":       {"USP": 4, "EP": 3, "JP": 2, "OTHER": 1},
    "ICH Q3C":   {"USP": 4, "EP": 3, "JP": 2, "OTHER": 1},
    # Ph.Eur: Ph.Eur/EP > USP/NF > JP > ASMF/other
    "Ph.Eur":    {"EP": 4, "USP": 3, "JP": 2, "OTHER": 1},
    # JP: JP > USP/NF > Ph.Eur > ASMF/other
    "JP":        {"JP": 4, "USP": 3, "EP": 2, "OTHER": 1},
}


def normalize_rs_framework(framework: Optional[str]) -> str:
    """Map free-text project metadata to a known framework key, else the default."""
    f = _s(framework).strip().lower()
    if not f:
        return DEFAULT_RS_FRAMEWORK
    if "ph" in f and "eur" in f:
        return "Ph.Eur"
    if f in ("ep", "pheur", "ph eur", "european pharmacopoeia"):
        return "Ph.Eur"
    if f == "jp" or "japan" in f:
        return "JP"
    if "ich" in f or "q3c" in f:
        return "ICH Q3C"
    if "usp" in f or "467" in f or "nf" in f:
        return "USP <467>"
    return DEFAULT_RS_FRAMEWORK


def _compendium_category(sv: Dict) -> Optional[str]:
    """Detect which compendium an entry is tagged with, else None."""
    blob = (_s(sv.get("solvent_name")) + " " + _s(sv.get("raw_text"))).lower()
    if not blob.strip():
        return None
    if _COMPENDIAL_USP_RE.search(blob):
        return "USP"
    if _COMPENDIAL_EP_RE.search(blob):
        return "EP"
    if _COMPENDIAL_JP_RE.search(blob):
        return "JP"
    if any(t in blob for t in _COMPENDIAL_OTHER):
        return "OTHER"
    return None


def _compendial_rank(sv: Dict, framework: str = DEFAULT_RS_FRAMEWORK) -> int:
    """Higher = preferred for the given assessment framework. 0 = no compendial
    descriptor (falls through to the worst-case ppm ranking, preserving legacy
    behaviour). Default USP <467> reproduces the original USP/NF>EP>JP>other order."""
    cat = _compendium_category(sv)
    if cat is None:
        return 0
    table = _RS_FRAMEWORK_PRIORITY.get(framework, _RS_FRAMEWORK_PRIORITY[DEFAULT_RS_FRAMEWORK])
    return table.get(cat, 0)


# RS RF3: an NMT specification limit outranks a batch-actual test result for a
# worst-case USP <467> exposure (a batch actual is ≤ its spec by definition, so
# using it under-states exposure). Detect a batch-actual entry from its evidence
# type / column label / wording.
_RS_BATCH_ACTUAL_RE = re.compile(
    r"\b(test\s+result|batch\s+(?:result|actual|analysis|value)|actual\s+"
    r"(?:value|result|content)|analysis\s+result|as\s+found|found\s*[:=]|"
    r"observed|result\s*[:=])\b", re.IGNORECASE)
_RS_SPEC_WORDING_RE = re.compile(
    r"\b(nmt|not\s+more\s+than|≤|<=|max(?:imum)?|limit|specification|spec)\b",
    re.IGNORECASE)


def _is_batch_actual(sv: Dict) -> bool:
    """True when a solvent entry is a measured batch RESULT rather than a spec
    limit. Spec-limit evidence types and NMT/limit wording are never batch
    actuals; explicit result wording (or a plain measured value) is."""
    et = _s(sv.get("evidence_type")).lower()
    if et in ("nmt", "numerical_limit", "percentage_limit", "controlled_by_spec"):
        return False
    blob = (_s(sv.get("solvent_name")) + " " + _s(sv.get("raw_text"))).lower()
    if _RS_SPEC_WORDING_RE.search(blob):
        return False
    if _RS_BATCH_ACTUAL_RE.search(blob):
        return True
    return et in ("coa_statement", "batch_result", "result", "measured", "actual")


def _dedup_rs_solvents(solvents: List[Dict],
                       framework: str = DEFAULT_RS_FRAMEWORK) -> List[Dict]:
    """Collapse duplicate solvent rows (RF14). Group by canonical name (non-USP by
    lowercased raw name). Keep ONE representative per group: prefer the
    framework's highest-priority compendial variant (default USP <467> → USP/NF
    first — RS Bug 1/3); when no compendium is tagged, fall back to worst-case —
    an entry that carries a converted ppm, then the LARGEST ppm (spec limit ≥
    batch actual → conservative), then NMT source, then highest confidence.
    Confidence is carried as the group max so no evidence strength is lost."""
    groups: Dict[str, List[Dict]] = {}
    order: List[str] = []
    for sv in solvents:
        canon = sv.get("canonical")
        key = canon if canon else ("~" + _s(sv.get("solvent_name")).lower())
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append(sv)
    out: List[Dict] = []
    for key in order:
        grp = groups[key]
        if len(grp) == 1:
            out.append(grp[0])
            continue

        def _rank(sv: Dict):
            ppm = sv.get("converted_ppm")
            has_ppm = ppm is not None
            return (
                not _is_batch_actual(sv),      # RF3: NMT spec beats batch actual
                # A compendial preference chooses BETWEEN limits, so an entry
                # that states no value cannot win on it: a statement mentioning
                # USP/NF but carrying no number of its own ("significantly less
                # than the USP/NF guideline") would otherwise beat the
                # material's own specification and leave the cell empty.
                has_ppm,
                _compendial_rank(sv, framework),  # RS Bug 1: framework priority
                float(ppm) if has_ppm else -1.0,
                sv.get("evidence_type") == "nmt",
                _f(sv.get("confidence", 0.0)),
            )
        win = max(grp, key=_rank)
        best = dict(win)
        best["confidence"] = max(_f(s.get("confidence", 0.0)) for s in grp)
        # Preserve the superseded entries (e.g. batch actuals) for the audit trail
        # (RF3) without letting them drive the exposure calculation.
        supers = [{"solvent_name": s.get("solvent_name"),
                   "converted_ppm": s.get("converted_ppm"),
                   "evidence_type": s.get("evidence_type"),
                   "raw_text": _s(s.get("raw_text"))[:200]}
                  for s in grp if s is not win]
        if supers:
            best["_superseded"] = supers
        out.append(best)
    return out


def _annexure_richness(ann: Dict) -> Tuple[int, int, float]:
    """Rank an annexure record by evidence richness for dedup (RF8): number of
    solvent entries first, then how many carry a numeric ppm, then the best
    confidence. Used to keep the fuller record when two dedupe to the same key."""
    solv = ann.get("solvents") or []
    numeric = sum(1 for s in solv if s.get("converted_ppm") is not None)
    conf = max((_f(s.get("confidence", 0.0)) for s in solv), default=0.0)
    return (len(solv), numeric, conf)


def _pick_richer_annexure(a: Dict, b: Dict) -> Dict:
    return a if _annexure_richness(a) >= _annexure_richness(b) else b


def _rs_numbered_copies(annexures: List[Any]) -> Tuple[List[Any], List[str]]:
    """RS-3 — copies of the uploaded annexures that identify themselves, made
    before anything is mapped.

    A file converted on its own comes back as annexure 1, so a pack of such
    files repeats the number and the number then identifies nothing: every
    ingredient was logged against annexure 1. Each copy carries
    ``_upload_index`` - its position in the upload, which later copies keep -
    and when the uploaded numbers repeat or are missing, each is numbered by
    that position, the number it arrived with kept as
    ``_uploaded_annexure_number``. Unique numbers are left exactly as uploaded,
    so an out-of-order pack is still reported rather than silently renumbered.
    The caller's records are never modified.
    """
    copies = [dict(a) if isinstance(a, dict) else a for a in (annexures or [])]
    for pos, c in enumerate(copies):
        if isinstance(c, dict):
            c["_upload_index"] = pos
    numbers = [_s(c.get("annexure_number")) for c in copies if isinstance(c, dict)]
    if all(numbers) and len(set(numbers)) == len(numbers):
        return copies, []
    for pos, c in enumerate(copies):
        if isinstance(c, dict):
            c["_uploaded_annexure_number"] = c.get("annexure_number")
            c["annexure_number"] = pos + 1
    return copies, ["Uploaded annexure numbers repeat or are missing (each file "
                    "was numbered on its own); every annexure is numbered by its "
                    "position in the upload."]


def _rs_upload_positions(annexures: List[Any]) -> Dict[int, int]:
    """``id(annexure) -> its position in the upload``, for every record listed.

    The ``_upload_index`` stamp when every record carries a distinct one, so a
    de-duplicated or cluster-merged COPY still points at the file it came from
    - and agrees with the uploaded list it was copied from, whose own records
    carry no stamp and are counted by position, which is the same number.
    """
    records = [(i, a) for i, a in enumerate(annexures or []) if isinstance(a, dict)]
    stamps = [a.get("_upload_index") for _i, a in records]
    if (records and all(isinstance(s, int) and not isinstance(s, bool)
                        for s in stamps) and len(set(stamps)) == len(stamps)):
        return {id(a): a["_upload_index"] for _i, a in records}
    return {id(a): i for i, a in records}


def dedup_rs_annexures(annexures: List[Dict],
                       framework: str = DEFAULT_RS_FRAMEWORK) -> Tuple[List[Dict], List[str]]:
    """Dedup annexures by (normalized material, normalized supplier) BEFORE
    mapping (RF8), so the merged/richer record feeds both the mapper and the
    exposure calc — no solvent evidence is lost. Records with no resolved
    material never merge. Returns (deduped, dup_warnings).

    It works on numbered copies (:func:`_rs_numbered_copies`), so every record
    it returns knows its upload position and carries a number of its own."""
    deduped: List[Dict] = []
    key_to_idx: Dict[Tuple[str, ...], int] = {}
    copies, warnings = _rs_numbered_copies(annexures)
    for ann in copies:
        if not isinstance(ann, dict) or ann.get("_error"):
            deduped.append(ann)
            continue
        mat = _rs_norm(_s(ann.get("material_name")))
        sup = _rs_norm(_s(ann.get("supplier_name")))
        # RED FLAG 3 — a vendor that ships ONE document template for its whole
        # catalogue (Merck EMPROVE: Sodium chloride and Sodium hydroxide as
        # ~49 near-identical pages) yields the same extracted material_name and
        # supplier for two different chemicals. Keyed on that pair alone they
        # deduplicated into one record and a dominant excipient disappeared.
        # The detected chemical family — read from the filename / candidates /
        # title when the name itself is a banner — separates them. It is empty
        # for anything unrecognised, so no existing dedup key changes shape.
        try:
            fam = _s(_rs_pool_identity(ann).get("family"))
        except Exception:
            fam = ""
        key = (mat, sup, fam) if mat else ("~unresolved", str(ann.get("annexure_number")), "")
        if mat and key in key_to_idx:
            idx = key_to_idx[key]
            kept = deduped[idx]
            merged = _dedup_rs_solvents(
                (kept.get("solvents") or []) + (ann.get("solvents") or []), framework)
            winner = dict(_pick_richer_annexure(kept, dict(ann)))
            winner["solvents"] = merged
            if any(s.get("converted_ppm") is not None for s in merged):
                winner["negative_declaration"] = False
            mf = list(kept.get("_merged_from", []))
            for num in (kept.get("annexure_number"), ann.get("annexure_number")):
                if (num is not None and num != winner.get("annexure_number")
                        and num not in mf):
                    mf.append(num)
            if mf:
                winner["_merged_from"] = mf
            deduped[idx] = winner
            warnings.append(
                f"Duplicate annexure for '{_s(ann.get('material_name'))}' / "
                f"'{_s(ann.get('supplier_name'))}' (Annexure "
                f"{ann.get('annexure_number','?')}) merged; solvent evidence combined.")
        else:
            key_to_idx[key] = len(deduped)
            deduped.append(dict(ann))
    return deduped, warnings


# ── RS-10: which SECTION a statement was read from ───────────────────────────
# A residual-solvent number comes from a residual-solvent section. A general
# chemical inventory or screening checklist - "Other Chemicals Not Tested", an
# allergen / contaminant / elemental-impurity list - prints limits for
# substances the site does not test as solvents, and some of those substances
# ARE solvents (formic acid, triethylamine are both ICH Q3C Class 3), so their
# names can never tell the two apart. Only the heading can.
_RS_SOLVENT_SECTION_RE = re.compile(
    r"residual\s+solvent|\bsolvents?\b|usp\s*<?\s*467|ich\s*q3c|"
    r"organic\s+volatile|\bovi\b|class\s+[123]\s+solvent", re.IGNORECASE)
_RS_NON_SOLVENT_SECTION_RE = re.compile(
    r"other\s+chemicals|not\s+tested|not\s+intentionally\s+added|inventory|"
    r"allergen|contaminant|heavy\s+metal|elemental\s+impurit|pesticide|"
    r"\bgmo\b|\bbse\b|\btse\b|melamine|nitrosamine|residual\s+monomer|"
    r"microbial|screening\s+list", re.IGNORECASE)

# Tabular CoAs label a solvent row by peak/impurity id with the real chemical in
# parentheses: "Impurity B (Acetone)" / "RS-3 (Chloroform)" (RF12). When the
# outer label is a generic peak/impurity tag, use the parenthesized chemical.
_RS_PAREN_NAME_RE = re.compile(r"\(([^)]+)\)")
_RS_PEAK_LABEL_RE = re.compile(
    r"^\s*(?:impurit(?:y|ies)|imp|peak|rs|rrt|residual\s+solvents?|solvent|"
    r"unknown|compound|component|[a-z])\b", re.IGNORECASE)


def _rs_clean_solvent_name(sname: str) -> str:
    """Prefer the parenthesized chemical name when the row label is a generic
    peak/impurity tag ('Impurity B (Acetone)' → 'Acetone'). Names that already
    lead with a real chemical ('Isopropyl alcohol (IPA)') are left intact."""
    s = _s(sname)
    if not s or "(" not in s:
        return s
    if _RS_PEAK_LABEL_RE.match(s):
        m = _RS_PAREN_NAME_RE.search(s)
        if m and m.group(1).strip():
            return m.group(1).strip()
    return s


def process_rs_annexure(obj: Any, index: int,
                        framework: str = DEFAULT_RS_FRAMEWORK) -> Dict:
    """
    Normalise one converted RS annexure into a CONSISTENT top-level object,
    even when no solvent table / no numerical values are present, or when the
    model returned a list (schema_repaired). Never raises.

    framework selects the compendial dedup priority (RS Bug 1); it defaults to
    USP <467>, which reproduces the original behaviour.
    """
    default: Dict = {
        "annexure_number": index,
        "supplier_name": "",
        "material_name": "",
        "material_name_candidates": [],
        "material_name_source": "body",
        "needs_material_confirmation": False,
        "document_title": "",
        "annexure_type": "other",
        "solvents": [],
        "negative_declaration": False,
        "schema_repaired": False,
        "_error": False,
    }

    if not isinstance(obj, dict):
        if isinstance(obj, list):
            d = dict(default)
            d["extracted_items"] = obj
            d["schema_repaired"] = True
            logger.warning(f"RS annexure {index}: root was a list — wrapped.")
            return d
        d = dict(default)
        d["_error"] = True
        d["extraction_notes"] = f"Malformed annexure: got {type(obj).__name__}."
        return d

    out = dict(default)
    # Honor an explicit upstream error (e.g. PDF rasterization failure) so the
    # structured error object propagates instead of being reset to a clean record.
    if obj.get("_error"):
        out["_error"] = True
        out["extraction_notes"] = _s(obj.get("extraction_notes")) or "Extraction failed."
        return out
    for fld in ("supplier_name", "material_name", "document_title", "annexure_type",
                "raw_text", "filename"):
        if obj.get(fld) is not None:
            out[fld] = _s(obj.get(fld))
    # Part 6 — carry the page metadata through re-normalisation (a previously
    # converted JSON is re-normalised on upload, and a dropped page span would
    # leave the annexure list with an empty page reference).
    if obj.get("n_pages"):
        try:
            out["n_pages"] = int(obj["n_pages"])
        except (TypeError, ValueError):
            pass
    if _s(obj.get("annexure_pages")):
        out["annexure_pages"] = _s(obj.get("annexure_pages"))
    cands = obj.get("material_name_candidates", [])
    if isinstance(cands, list):
        out["material_name_candidates"] = [_s(c) for c in cands if _s(c)]
    # RS-5 — one document can cover several materials (a regulatory data sheet
    # for two products). Each is listed once, so the mapper can bind the
    # document to every composition row it covers.
    covered = obj.get("covered_materials")
    if isinstance(covered, list):
        names = [rs_strip_descriptor(_s(c)) or _s(c) for c in covered if _s(c)]
        if names:
            out["covered_materials"] = list(dict.fromkeys(names))
    if obj.get("schema_repaired"):
        out["schema_repaired"] = True
    if obj.get("extracted_items") is not None:
        out["extracted_items"] = obj.get("extracted_items")

    # Material-name: strip document descriptors, recover from candidates
    out["material_name"] = rs_strip_descriptor(out["material_name"])
    out["material_name_candidates"] = [
        c for c in (rs_strip_descriptor(x) for x in out["material_name_candidates"]) if c
    ]
    if not out["material_name"] and out["material_name_candidates"]:
        out["material_name"] = out["material_name_candidates"][0]
    if not out["material_name"] and out["document_title"]:
        recovered = rs_strip_descriptor(out["document_title"])
        if recovered:
            out["material_name"] = recovered

    # STRICT filename fallback (B3): only when ALL body-based paths yielded
    # nothing. Never overrides a valid body-extracted material_name. Fixes the
    # case where the body/title is generic ("Residual Solvents") but the filename
    # names the material — e.g. "Citric acid (Annexure 14).pdf" → "Citric acid".
    if not out["material_name"]:
        inferred = _infer_material_from_filename(_s(obj.get("filename")))
        if inferred:
            out["material_name"] = inferred
            out["material_name_source"] = "filename_inferred"
            out["needs_material_confirmation"] = True
    else:
        out.setdefault("material_name_source", "body")

    out["negative_declaration"] = bool(obj.get("negative_declaration"))

    # Is this a generic regulatory/policy letter (no specific material subject)?
    # Numbers in such a document are guideline references, not material limits.
    # Require a genuinely UNRESOLVED material — a filename-inferred material with
    # real per-batch data must NOT be cleared (that is a real CoA, not a policy
    # letter). Stray policy-context numbers are still rejected per-solvent below.
    doc_title = out.get("document_title", "")
    is_policy_letter = (not out["material_name"]) and bool(
        _RS_POLICY_TITLE_RE.search(doc_title))

    # RS-11 — the document's own page text, kept so a statement the extractor
    # trimmed to a bare number can be read against the words that printed it.
    doc_raw_text = _s(out.get("raw_text"))

    # Normalise solvent evidence
    solvents_in = obj.get("solvents", [])
    norm_solvents: List[Dict] = []
    declaration_scopes: List[Dict] = []
    if isinstance(solvents_in, list):
        for sv in solvents_in:
            if not isinstance(sv, dict):
                continue
            sname = _rs_clean_solvent_name(_s(sv.get("solvent_name")))
            etype = _s(sv.get("evidence_type")) or "ambiguous"
            raw_value = sv.get("raw_value")
            raw_unit = _s(sv.get("raw_unit"))
            raw_text = _s(sv.get("raw_text"))
            # Resolve once. A vendor/specialty solvent (class None — e.g. TFA)
            # still gets a canonical name so its abbreviation and full name merge
            # into ONE entry (RS Bug 4), but is treated as non-USP below.
            sinfo = RSM.get_solvent_info(sname) if sname else None
            canon = sinfo["canonical_name"] if sinfo else None

            # (a) Generic category / declaration-scope phrases are NOT solvents
            # (Class 1/2/3, OVI, "residual solvents", water) → scope evidence.
            if not sname or is_generic_solvent_category(sname):
                declaration_scopes.append({
                    "scope_text": sname,
                    "raw_text": raw_text or sname,
                    "evidence_type": etype if etype in (
                        "negative_declaration", "no_source", "controlled_by_spec",
                        "coa_statement") else "declaration_scope",
                    "page": sv.get("page", 1),
                })
                continue

            # (a2) RS-10: the SECTION the number was read from. A general
            # chemical inventory or screening checklist ("Other Chemicals Not
            # Tested", an allergen / contaminant / elemental-impurity list)
            # prints limits for substances the site does not test as solvents -
            # and some of those substances ARE solvents (formic acid,
            # triethylamine), so the name can never tell them apart; only the
            # heading can. When the extractor names no section, nothing changes.
            section = _s(sv.get("source_section"))
            if (section and _RS_NON_SOLVENT_SECTION_RE.search(section)
                    and not _RS_SOLVENT_SECTION_RE.search(section)):
                declaration_scopes.append({
                    "scope_text": sname,
                    "raw_text": raw_text or sname,
                    "evidence_type": "non_solvent_section",
                    "source_section": section,
                    "page": sv.get("page", 1),
                })
                continue

            # (b) RF3: a real solvent name whose evidence is a policy/guideline
            # reference (PDE value, ICH Q3C discussion) is NOT a material limit.
            if etype == "policy_statement" or _rs_is_policy_context(raw_text):
                declaration_scopes.append({
                    "scope_text": sname,
                    "raw_text": raw_text or sname,
                    "evidence_type": "policy_statement",
                    "page": sv.get("page", 1),
                })
                continue

            # Convert to ppm via the deterministic A–G classifier so a statement
            # carrying BOTH a batch actual and a spec limit (a "159 - 5000" range,
            # an "Actual | NMT" pair, or a BDL result) always resolves to the same
            # worst-case value regardless of vendor/CoA format. The smaller actual
            # is preserved for audit. (Sofosbuvir/Velpatasvir extraction fix.)
            converted_ppm = None
            calc_basis = etype
            audit_note = ""
            actual_ppm = None
            spec_ppm = None
            rv_norm = _s(raw_value).strip().lower()
            is_bdl = (rv_norm in _RS_BDL_VALUES) or _rs_text_is_bdl(raw_text)
            # RS-1 / RS-2 — when the source names its columns, the content
            # column is the content and a regulatory limit never is.
            labelled = (_rs_labelled_content(sv, raw_unit, raw_text)
                        if etype not in ("negative_declaration", "no_source")
                        else None)
            if labelled and labelled.get("regulatory_only") is not None:
                declaration_scopes.append({
                    "scope_text": sname,
                    "raw_text": raw_text or sname,
                    "evidence_type": "regulatory_limit_reference",
                    "page": sv.get("page", 1),
                })
                continue
            if labelled and labelled.get("converted") is not None:
                converted_ppm = labelled["converted"]
                actual_ppm = labelled.get("actual")
                spec_ppm = labelled.get("spec")
                calc_basis = labelled["basis"]
                audit_note = labelled["note"]
            elif etype in ("numerical_limit", "percentage_limit", "nmt"):
                # RS-11 — classify on the words the SOURCE put around this
                # number, not on a statement the extractor trimmed to the bare
                # value. Unchanged whenever the statement prints its own number.
                _base = (labelled or {}).get("text") or raw_text
                _ctx = _rs_statement_context(doc_raw_text, (sname, canon),
                                             _base, raw_value)
                cls = _classify_solvent_ppm(raw_value, raw_unit, _ctx, is_bdl)
                converted_ppm = cls["converted_ppm"]
                actual_ppm = cls["actual_measured_ppm"]
                spec_ppm = cls["spec_limit_ppm"]
                calc_basis = cls["calculation_basis"] or calc_basis
                audit_note = cls["note"]
                if _ctx != _base:
                    audit_note = (audit_note + "; " if audit_note else "") + (
                        "the statement carried a value with no wording of its "
                        "own, so the document's own sentence for this solvent "
                        "decided what the value is")
            elif etype in ("negative_declaration", "no_source"):
                calc_basis = "negative_declaration"
            # BDL under a non-numeric etype: still recover the spec limit from text.
            if converted_ppm is None and is_bdl:
                nmt_ppm = _extract_nmt_ppm_from_text(raw_text)
                if nmt_ppm is not None:
                    converted_ppm = nmt_ppm
                    spec_ppm = nmt_ppm
                    calc_basis = "nmt_conservative_bdl"
                    audit_note = ("BDL result; using spec limit for worst-case "
                                  "exposure")

            # RS-7 — a numeric statement whose every printed concentration is a
            # regulatory reference ("significantly less than the USP/NF
            # guideline of < 5000 ppm") states nothing of the material's own. It
            # is kept as the reference it is, never as a solvent row that a
            # later dedup could prefer over the material's own specification.
            if (converted_ppm is None and not is_bdl
                    and etype in ("numerical_limit", "percentage_limit", "nmt")
                    and _rs_reference_only(raw_text)):
                declaration_scopes.append({
                    "scope_text": sname,
                    "raw_text": raw_text or sname,
                    "evidence_type": "regulatory_limit_reference",
                    "page": sv.get("page", 1),
                })
                continue

            # Non-USP = not an ICH Q3C-classed solvent. A vendor solvent (class
            # None) resolves to a canonical name but is still non-USP, so the RF2
            # numeric-evidence gate below (and NA limit display) still applies.
            is_non_usp = (sinfo is None) or (sinfo.get("class") is None)
            entry = {
                "solvent_name": sname,
                "canonical": canon,
                "is_non_usp_solvent": is_non_usp,
                "raw_text": raw_text,
                "raw_value": raw_value,
                "raw_unit": raw_unit,
                "converted_ppm": converted_ppm,
                "evidence_type": etype,
                "calculation_basis": calc_basis,
                "page": sv.get("page", 1),
                "confidence": _f(sv.get("confidence", 0.6)) or 0.6,
            }
            if audit_note:
                entry["audit_note"] = audit_note
            # RS-5 — the material a statement belongs to, in a document that
            # covers more than one.
            scope = _s(sv.get("material_scope") or sv.get("material_name"))
            if scope:
                entry["material_scope"] = scope
            # Audit trail: preserve both the batch actual and the spec limit so a
            # reviewer can see the worst-case selection (RS content-extraction fix).
            if actual_ppm is not None:
                entry["actual_measured_ppm"] = actual_ppm
            if spec_ppm is not None:
                entry["spec_limit_ppm"] = spec_ppm

            # RF2: a solvent NAME with no number behind it is a declaration
            # scope, not a calculation column - whatever its ICH class. The gate
            # used to ask "is it non-USP", so a USP-classed name mentioned with
            # no number at all (a vendor listing the Class 1 solvents it does
            # NOT use) still opened a document-wide column that every other
            # material then had to show NA in. What keeps a solvent is EVIDENCE,
            # not membership of the master table.
            # Kept, because each IS per-solvent evidence: a negative declaration
            # (it resolves to 0.0 in annexure_limit below), and a statement that
            # prints a concentration or a below-detection result but could not
            # be resolved - that one must stay visible for manual review, not
            # disappear. A chemical name carrying digits ("1,1,1-Trichloro-
            # ethane") is not a concentration: only a number WITH a unit is.
            _stated = f"{_s(raw_value)} {raw_text}"
            _has_reading = is_bdl or bool(_RS_CONC_NUMBER_RE.search(_stated))
            if (converted_ppm is None and not _has_reading
                    and etype not in ("negative_declaration", "no_source")):
                declaration_scopes.append({
                    "scope_text": sname,
                    "raw_text": raw_text or sname,
                    "evidence_type": "declaration_scope",
                    "page": sv.get("page", 1),
                })
                continue
            norm_solvents.append(entry)

    # RF14: collapse duplicate rows (Methanol × 5 → one worst-case entry).
    norm_solvents = _dedup_rs_solvents(norm_solvents, framework)

    # A vendor's stated NMT specification is the material's worst-case content
    # and is kept even when it equals the ICH Q3C limit - an API specification
    # normally does. Which numbers are regulatory references is decided above,
    # per statement, from the column labels and the words that introduce each
    # number (RS-1 / RS-2 / RS-7), never by comparing a value with the ICH Q3C
    # table; a standalone guideline sheet is excluded by provenance below (RF3).
    out["solvents"] = norm_solvents
    out["declaration_scopes"] = declaration_scopes

    # RF3: a generic policy letter must not contribute material-specific limits.
    # Everything it carried becomes scope evidence and its flag stays false.
    if is_policy_letter and norm_solvents:
        for sv in norm_solvents:
            declaration_scopes.append({
                "scope_text": sv.get("solvent_name", ""),
                "raw_text": sv.get("raw_text", ""),
                "evidence_type": "policy_statement",
                "page": sv.get("page", 1),
            })
        norm_solvents = []
        out["solvents"] = []
        out["declaration_scopes"] = declaration_scopes

    # RF4: negative_declaration is the GLOBAL "no residual solvents present" flag.
    # It is true ONLY when there are no numeric solvent limits. Any numeric limit
    # forces it false; per-class negatives live in declaration_scopes, not here.
    has_numeric = any(sv.get("converted_ppm") is not None for sv in norm_solvents)
    if has_numeric or is_policy_letter:
        out["negative_declaration"] = False
    elif not norm_solvents and (
            out["negative_declaration"]
            or any(sc.get("evidence_type") in ("negative_declaration", "no_source")
                   for sc in declaration_scopes)
            or "not used" in out.get("raw_text", "").lower()
            or "water is the only" in out.get("raw_text", "").lower()):
        out["negative_declaration"] = True
    else:
        out["negative_declaration"] = False
    return out


