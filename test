# ── EI display-name cleanup (B1/B2/C6) — DISPLAY ONLY ────────────────────────
# Backend matching/clustering keeps the FULL messy text (title, candidates,
# filename) unchanged — see _build_conc_map / _resolve_ingredient_match. Only the
# DOCX display name (Table 2, annexure list) is cleaned, with this priority:
#   1. the composition ingredient name this annexure matched (scientist-typed,
#      cleanest);  2. the cleaned vendor material_name (vendor grades / purity /
#      compendia noise / ellipsis stripped);  3. a filename-derived name (SAP
#      codes / dates / "Annexure N" / extension stripped);  4. "Material N".
_EI_ELLIPSIS_RE = re.compile(r"\s*(?:…|\.{3,})")
_EI_DISPLAY_NOISE_RE = re.compile(
    r"®|™"
    r"|\bEMPROVE\b|\bEXPERT\b|\bESSENTIAL\b|\bEMSURE\b|\bPROLABO\b|\bSUPRAPUR\b"
    r"|\bfor\s+biopharmaceutical\s+production\b"
    r"|\bsuitable\s+for\s+[a-z][a-z ]*?production\b"
    r"|\blow\s+endotoxin\b"
    r"|\bPh\.?\s*Eur\.?\b|\bBP\b|\bJP\b|\bNF\b|\bUSP\b|\bEP\b|\bDAB\b|\bJPE\b"
    r"|\b\d{1,3}(?:\.\d+)?\s*%",
    re.IGNORECASE)


