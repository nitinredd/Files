# 3b. CALCULATION IDENTITY AGGREGATION (Red Flag 3)
#     Composition stays stage-wise for Section 4; Section 5 calculation collapses
#     repeated / synonymous material rows into ONE calculation identity each.
# ════════════════════════════════════════════════════════════════════════════
def _qs_identity(name: Any) -> str:
    """The identity of a q.s. / vehicle row, blind to markers and q.s. wording.

    "Purified water", "Purified Water@" and "Purified water (q.s.)" are one
    material listed in three stages. Markers are removed with the shared
    engine - this module keeps no marker alphabet of its own.
    """
    text = _EV.scrub_note_markers(_s(name))
    text = re.sub(r"\([^)]*\)|\[[^\]]*\]", " ", text)
    text = re.sub(r"\bq\.?\s*s\.?(?=\s|$)(?:\s*to\b[^,;]*)?", " ", text,
                  flags=re.IGNORECASE)
    try:
        family = _s(_rs_identity(text).get("family"))
    except Exception:                                           # noqa: BLE001
        family = ""
    return family or _rs_norm(text)


def _dedupe_qs_rows(rows: List[Dict]) -> List[Dict]:
    """q.s. rows as calculation-exempt rows, ONE per material."""
    out: List[Dict] = []
    by_key: Dict[str, Dict] = {}
    for q in rows or []:
        if not isinstance(q, dict):
            continue
        name = _s(q.get("component", ""))
        key = _qs_identity(name) or name.lower()
        if key in by_key:
            agg = by_key[key]["_aggregation"]
            agg["source_rows"] += 1
            if name and name not in agg["original_names"]:
                agg["original_names"].append(name)
            continue
        row = {
            "component": _EV.strip_note_markers(name) or name,
            "quantity": q.get("quantity"),
            "amount_in_maximum_dose_mg": None,
            "amount_basis": "qs",
            "_is_qs": True,
            "solvents": {}, "columns": {},
            "_aggregation": {"source_rows": 1, "stages": [], "original_names":
                             [name], "aggregation_reason": "q.s. row"},
        }
        by_key[key] = row
        out.append(row)
    return out


def dedupe_qs_rows(parsed: Dict) -> Dict:
    """*parsed* with repeated q.s. rows collapsed to one row per material.

    For the Excel-authoritative (detailed) modes, whose quantified rows are
    used exactly as the sheet states them: only calculation-exempt q.s. rows
    are touched, so no number changes. The first occurrence keeps its place.
    """
    if not isinstance(parsed, dict):
        return parsed
    seen: set = set()
    kept: List[Any] = []
    for r in parsed.get("rows") or []:
        if isinstance(r, dict) and r.get("_is_qs"):
            key = _qs_identity(r.get("component")) or _s(r.get("component")).lower()
            if key in seen:
                continue
            seen.add(key)
        kept.append(r)
    out = dict(parsed)
    out["rows"] = kept
    return out


_RS_TRAILING_QUALIFIER_RE = re.compile(
    r"^(?:[\(\[\-–—:,/&+]+|part|stage|step|for|and|of|the|with|in)$", re.IGNORECASE)


# A word of a composition name; a qualifier written against the word before it
# - "stearate(Part-I)" - is a word of its own.
_RS_NAME_WORD_RE = re.compile(r"[^\s(\[]+|[(\[]\S*")
# Where a name's qualifiers begin: a bracketed part, a dash, or a part/stage word.
_RS_NAME_QUALIFIER_RE = re.compile(r"^(?:[(\[\-–—]|part\b|stage\b|step\b)",
                                   re.IGNORECASE)


def _rs_shared_display_name(names: List[str]) -> str:
    """The leading words every one of *names* shares, in the first name's own
    text, with a dangling qualifier trimmed; "" when they share none.

    A qualifier written against the word before it ("Magnesium
    stearate(Part-I)") is a word of its own, so it never takes that word with
    it. When the rows share only ONE word of longer names - a misspelling, a
    grade written differently - the first row's name before its qualifiers is
    used instead: a merged row is never cut down to a single word.
    """
    texts = [_s(n) for n in names if _s(n)]
    if not texts:
        return ""
    split = [[(m.group(0), m.end()) for m in _RS_NAME_WORD_RE.finditer(t)]
             for t in texts]
    common: List[Tuple[str, int]] = []
    for i, (word, end) in enumerate(split[0]):
        if all(len(ws) > i and ws[i][0].lower() == word.lower() for ws in split[1:]):
            common.append((word, end))
        else:
            break
    while common and (common[-1][0].startswith(("(", "["))
                      or _RS_TRAILING_QUALIFIER_RE.match(common[-1][0])):
        common.pop()

    def _base(words: List[Tuple[str, int]]) -> List[Tuple[str, int]]:
        out: List[Tuple[str, int]] = []
        for word, end in words:
            if _RS_NAME_QUALIFIER_RE.match(word):
                break
            out.append((word, end))
        return out

    if len(common) == 1 and all(len(_base(ws)) > 1 for ws in split):
        common = _base(split[0])
    text = texts[0][:common[-1][1]].strip(" -–—:,/(") if common else ""
    return text if re.search(r"[A-Za-z]{3}", text) else ""


def aggregate_calculation_identities(parsed: Dict) -> Dict:
    """
    Collapse repeated/synonymous component rows into one calculation identity,
    summing quantity_per_unit and amount_in_maximum_dose. Uses the same family
    recognition as the mapper (with negative-pair protection) so e.g. HPC/Klucel
    variants merge but Triethyl citrate never merges with ATBC. q.s. rows are
    NOT aggregated (kept separate, calculation-exempt). Returns a parsed-like
    dict whose 'rows' are the aggregated identities, plus an audit trail.
    """
    rows = parsed.get("rows", []) or []
    no_of_doses = parsed.get("no_of_doses")

    buckets: List[Dict] = []          # each: {family, key, ident, members[]}
    qs_rows: List[Dict] = []

    def bucket_for(name: str):
        ident = _rs_identity(name)
        fam = ident.get("family", "")
        dist = _rs_distinctive(ident.get("tokens", set()))
        for b in buckets:
            bfam = b["ident"].get("family", "")
            # Block chemically distinct families that share weak generic tokens
            if _rs_pair_blocked(fam, bfam):
                continue
            # Strong merge: identical recognised family
            if fam and bfam and fam == bfam:
                return b
            # Else merge only on distinctive (non-generic) token equality
            if not fam and not bfam:
                bdist = _rs_distinctive(b["ident"].get("tokens", set()))
                if dist and bdist and dist == bdist:
                    return b
        return None

    for r in rows:
        if r.get("_is_qs"):
            qs_rows.append(r)
            continue
        name = r.get("component", "")
        b = bucket_for(name)
        if b is None:
            b = {"ident": _rs_identity(name), "members": []}
            buckets.append(b)
        b["members"].append(r)

    # The units-per-day the parser actually used, exactly. The display value is
    # rounded to 6 dp, and multiplying that back in would put the rounding into
    # every aggregated amount.
    doses_exact = (_EV.dec_or_none(parsed.get("multiplier_exact"))
                   or _EV.dec_or_none(no_of_doses))

    agg_rows: List[Dict] = []
    aggregation_warnings: List[str] = []
    for b in buckets:
        members = b["members"]
        qty_sum = _EV.DECIMAL_ZERO
        had_qty = False
        amt_sum = _EV.DECIMAL_ZERO
        had_amt = False
        stages, names, src = [], [], []
        for m in members:
            q = m.get("quantity")
            if isinstance(q, (int, float, Decimal)) and not isinstance(q, bool):
                qty_sum = qty_sum + _D(q); had_qty = True
            a_exact = _EV.dec_or_none(m.get("amount_in_maximum_dose_mg_exact"))
            a = m.get("amount_in_maximum_dose_mg")
            if a_exact is not None:
                amt_sum = amt_sum + a_exact; had_amt = True
            elif isinstance(a, (int, float, Decimal)) and not isinstance(a, bool):
                amt_sum = amt_sum + _D(a); had_amt = True
            names.append(m.get("component", ""))
            st = m.get("stage") or (m.get("columns", {}) or {}).get("Stage")
            if st:
                stages.append(_s(st))
            src.append(m.get("component", ""))

        # Recompute amount from summed qty × doses when possible (authoritative)
        amount = None
        amount_exact = None
        basis = members[0].get("amount_basis", "none")
        if had_qty and doses_exact:
            amount_exact = _MUL(qty_sum, doses_exact)
            basis = "aggregated_quantity_times_doses"
        elif had_amt:
            amount_exact = amt_sum
            basis = "aggregated_amount_sum"
        if amount_exact is not None:
            amount = _FLOAT(_ROUND(amount_exact, 6))

        primary = members[0].get("component", "")
        # The merged row is named in the composition's OWN words - the words its
        # rows share ("Magnesium stearate (Part-I)" + "(Part-II)" -> "Magnesium
        # stearate") - never the family key, a lower-case matching label.
        canon_name = _rs_shared_display_name(names) or primary
        if len(members) > 1:
            aggregation_warnings.append(
                f"Aggregated {len(members)} rows into '{canon_name}' "
                f"(stages: {', '.join(stages) or 'n/a'}).")
        agg_rows.append({
            "component": canon_name if len(members) > 1 else primary,
            "quantity": _FLOAT(_ROUND(qty_sum, 6)) if had_qty else None,
            "amount_in_maximum_dose_mg": amount,
            "amount_in_maximum_dose_mg_exact": (str(amount_exact)
                                                if amount_exact is not None
                                                else None),
            "amount_basis": basis,
            "_is_qs": False,
            "solvents": members[0].get("solvents", {}) or {},
            "columns": {},
            "_aggregation": {
                "source_rows": len(members),
                "stages": stages,
                "original_names": names,
                "aggregation_reason": (b["ident"].get("family") and "family identity")
                                      or "distinctive-token identity",
            },
        })

    # q.s. rows stay calculation-exempt, and ONE material is ONE row: a vehicle
    # listed in four stages ("Purified water", "Purified Water@", ...) used to
    # reach the supplier table and every assessment table four times.
    agg_rows.extend(_dedupe_qs_rows(qs_rows))

    out = dict(parsed)
    out["rows"] = agg_rows
    out["aggregation_warnings"] = aggregation_warnings
    out["needs_dose_basis"] = any(
        (not r["_is_qs"]) and r["amount_in_maximum_dose_mg"] is None for r in agg_rows)
    return out


