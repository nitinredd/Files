def rasterize_pdf_pages(pdf_bytes: bytes, dpi: int = 200) -> List[bytes]:
    """Every page as an image under Claude's size limit (the shared renderer)."""
    pages, _warnings = render_pdf_pages_for_claude(pdf_bytes, dpi, log=logger)
    return pages


def extract_figure_from_page(pdf_bytes: bytes, page_index: int, dpi: int = 200) -> bytes:
    """Crop top 38% (header+caption) and bottom 10% (page number) of figure page."""
    doc = fitz.open(stream=pdf_bytes, filetype="pdf")
    try:
        page = doc.load_page(page_index)
        r = page.rect
        crop = fitz.Rect(r.x0 + r.width*0.02, r.y0 + r.height*0.38,
                         r.x1 - r.width*0.02, r.y1 - r.height*0.10)
        mat = fitz.Matrix(dpi/72, dpi/72)
        pix = page.get_pixmap(matrix=mat, alpha=False, colorspace=fitz.csRGB, clip=crop)
        return pix.tobytes("png")
    finally:
        doc.close()


def identify_figure_pages(page_images: List[bytes]) -> List[Dict]:
    prompt = (
        "Look at this page from a pharmaceutical technical report.\n"
        "Does it contain a figure, diagram, flowchart, or schematic "
        "(NOT a table, NOT only text)?\n\n"
        'YES: {"has_figure":true,"description":"...","figure_label":"Figure X: ..."}\n'
        'NO:  {"has_figure":false}\nReturn ONLY the JSON.'
    )
    figures: List[Dict] = []
    for i, img in enumerate(page_images):
        try:
            raw = claude_vision(img, prompt)
            data = safe_json_parse(raw, {"has_figure": False})
            if isinstance(data, dict) and data.get("has_figure"):
                figures.append({"page_index": i,
                                 "description": safe_str(data.get("description","")),
                                 "figure_label": safe_str(data.get("figure_label",""))})
        except Exception as e:
            logger.warning(f"Figure detect p{i}: {e}")
    return figures


def extract_reference_structure(page_images: List[bytes]) -> Dict:
    """
    Extract ALL content from the reference PDF:
    - Page 1 metadata (header fields)
    - TOC (whatever sections the product has)
    - Every page: section text AND any tables (with exact columns)
    - Revision history and signatures
    This is the key to product-agnosticism: we extract as-is, render as-is.
    """
    # ── Metadata from page 1 ─────────────────────────────────────────────────
    meta_prompt = (
        "This is page 1 of a pharmaceutical TSR document.\n"
        "Extract ALL metadata exactly as shown. Return ONLY this JSON:\n"
        '{"title":"","document_no":"","product_name":"","dosage_form":"","version":"",'
        '"strength":"","department":"","market":"","protocol":"",'
        '"sop_format_number":"","route_of_administration":""}'
    )
    meta_raw = claude_vision(safe_list_get(page_images, 0, b""), meta_prompt)
    meta = safe_json_parse(meta_raw, {})
    if not isinstance(meta, dict): meta = {}

    # ── TOC from page 2 ───────────────────────────────────────────────────────
    toc_prompt = (
        "This page is from a pharmaceutical Technical Summary Report.\n\n"
        "Does this page contain a TABLE OF CONTENTS section?\n"
        "A real TABLE OF CONTENTS has:\n"
        "  - A heading 'TABLE OF CONTENTS' or 'CONTENTS'\n"
        "  - Numbered section entries (1, 2, 3...) with titles and page numbers\n"
        "  - Page numbers are integers (e.g. 3, 4, 15)\n\n"
        "The IPDO page header table (IPDO | Technical Summary Report | Dr.Reddy's)\n"
        "is NOT a table of contents — ignore it.\n"
        "A metadata table (Title, Document No, Product Name, Department...) is\n"
        "NOT a table of contents — return is_toc:false for those pages.\n\n"
        "If this IS a TABLE OF CONTENTS, return ONLY:\n"
        '{"is_toc":true,"entries":[{"no":"1","title":"Abstract","page":"3"}]}\n'
        "If NOT a TOC page:\n"
        '{"is_toc":false,"entries":[]}'
    )
    toc_entries: List[Dict] = []
    for i in range(min(4, len(page_images))):
        try:
            raw = claude_vision(safe_list_get(page_images, i, b""), toc_prompt)
            d = safe_json_parse(raw, {})
            if not (isinstance(d, dict) and d.get("is_toc")): continue
            candidates = d.get("entries", [])
            if not isinstance(candidates, list) or not candidates: continue

            # Validate: real TOC entries have:
            #   "no"   = numeric string or small integer ("1","2",...,"12")
            #   "page" = numeric string ("3","4","15","16")
            # If the header metadata table was mistaken for a TOC, entries look like:
            #   {"no":"Title","title":"Risk assessment...","page":"FR&D"}
            # We reject those by checking that both "no" and "page" are numeric.
            def is_valid_toc_entry(e: Dict) -> bool:
                if not isinstance(e, dict): return False
                no_val   = safe_str(e.get("no",   "")).strip()
                page_val = safe_str(e.get("page",  "")).strip()
                # "no" must be a small integer string ("1"–"20")
                try:
                    n = int(no_val)
                    if n < 1 or n > 50: return False
                except (ValueError, TypeError):
                    return False
                # "page" must be a numeric string
                try:
                    int(page_val)
                except (ValueError, TypeError):
                    return False
                return True

            valid = [e for e in candidates if is_valid_toc_entry(e)]
            # Require at least 3 valid entries to accept as a real TOC
            if len(valid) >= 3:
                toc_entries = valid
                break
        except Exception:
            pass

    # ── Revision history and signatures (last 3 pages) ────────────────────────
    # NOTE: We no longer do per-page full extraction — it was only used for
    # additional_tables which caused the header table to repeat 12+ times.
    # Removing saves ~18 Claude API calls per report.
    pages_data: List[Dict] = []   # kept for compatibility, not populated
    revision_data: List[Dict] = []
    sig_data: List[Dict] = []
    rev_prompt = (
        "This page may contain revision history table and/or electronic signatures.\n"
        "Return ONLY: "
        '{"revision_history":[{"document_version":"","changes":""}],'
        '"signatures":[{"intention":"","employee_id":"","user_name":"","date":""}]}'
    )
    for i in range(max(0, len(page_images)-3), len(page_images)):
        try:
            raw = claude_vision(safe_list_get(page_images, i, b""), rev_prompt)
            d = safe_json_parse(raw, {})
            if isinstance(d, dict):
                rh = d.get("revision_history")
                sg = d.get("signatures")
                if isinstance(rh, list) and rh: revision_data = rh
                if isinstance(sg, list) and sg: sig_data = sg
        except Exception:
            pass

    return {
        "meta":             meta,
        "toc_entries":      toc_entries,
        "revision_history": revision_data,
        "signatures":       sig_data,
    }


def extract_composition_tables(pages_data: List[Dict]) -> Dict:
    """
    From the page-by-page extraction, find and return all composition/ingredient
    tables exactly as extracted — columns, rows, captions preserved verbatim.
    """
    comp_tables: List[Dict] = []
    for page in pages_data:
        if not isinstance(page, dict): continue
        for sec in (page.get("sections") or []):
            if not isinstance(sec, dict): continue
            for tbl in (sec.get("tables") or []):
                if not isinstance(tbl, dict): continue
                # Identify composition/ingredient/packing tables
                cap = safe_str(tbl.get("caption","")).lower()
                cols = tbl.get("columns", [])
                is_comp = any(kw in cap for kw in
                              ["ingredient","composition","packing","material","substance",
                               "excipient","table 1","table 2","detail"])
                if is_comp or (cols and any("ingredient" in str(c).lower() or
                                             "material" in str(c).lower() or
                                             "component" in str(c).lower()
                                             for c in cols)):
                    comp_tables.append(tbl)
    return {"tables": comp_tables}


def extract_additional_tables(pages_data: List[Dict]) -> List[Dict]:
    """
    Intentionally returns empty list.

    We previously tried to extract "extra" tables from the PDF pages verbatim,
    but the repeating IPDO header table (Field | Value) appears on every page
    and was passing all filters, causing it to be rendered 12+ times.

    The structured pipeline already renders every needed table:
      - Table 1: Composition (from Excel)
      - Table 2: Annexure list (from annexure_data)
      - Tables 5/6/7: EI calculations (from calculate_ei_tables)
      - Revision history, signatures, TOC (from reference structure)

    Any additional product-specific tables (e.g. "Potential risk" summary)
    are captured as text in the Claude-generated text_sections instead.
    """
    return []


# ── Excel composition parser ──────────────────────────────────────────────────
def _ei_vet_ingredient_col(proposed: str, columns: Any, sections: Any) -> str:
    """RED FLAG 14 — validate (and if necessary replace) the ingredient-name column.

    The EI composition is extracted by the model, so the wrong-column failure
    shows up as an ``ingredient_col`` naming a role or metadata header rather
    than a name header. The header list is taken from ``columns`` when present,
    otherwise from the keys of the first data row.
    """
    proposed = safe_str(proposed)
    headers = [safe_str(c) for c in (columns or []) if safe_str(c)]
    if not headers:
        for sec in (sections or []):
            if not isinstance(sec, dict):
                continue
            for row in (sec.get("rows") or []):
                if isinstance(row, dict) and isinstance(row.get("columns"), dict):
                    headers = [safe_str(k) for k in row["columns"].keys()
                               if safe_str(k)]
                    break
            if headers:
                break
    if not headers:
        return proposed
    try:
        idx = headers.index(proposed) if proposed in headers else None
    except ValueError:                                           # noqa: BLE001
        idx = None
    if idx is None and proposed and not COLS.name_column_is_valid(proposed):
        logger.warning("EI ingredient column %r classifies as %r — re-picking "
                       "(RF14).", proposed, COLS.classify_header(proposed))
        idx = None
    resolved = COLS.resolve_name_column(headers, idx)
    if resolved is None:
        return proposed
    chosen = headers[resolved]
    if proposed and chosen != proposed:
        logger.warning("EI ingredient column changed %r -> %r (RF14).",
                       proposed, chosen)
    return chosen


# ══════════════════════════════════════════════════════════════════════════════
# THE NOTE STAGE (Ticket 6)
# ══════════════════════════════════════════════════════════════════════════════
# A marker on a composition cell changes what that cell MEANS. Stripping it for
# display without applying its meaning is the worst of both worlds: the document
# reads cleanly and the arithmetic is wrong, with nothing left on the page to say
# so. This stage runs BEFORE any calculation, binds every marker to the row and
# column it modifies, and routes each note by what it SAYS - never by which
# product the workbook belongs to.
#
#   q.s.                     the row is a process aid at quantity sufficient and
#                            is exempt from the quantitative summation
#   overage                  the DISPLAYED strength backs the overage out; the
#                            formulation amount stays as the sheet prints it
#   salt/base equivalence    on the API row, the dose basis is the free base
#   unit                     the annotated quantity is in the note's unit, not
#                            the column's
#   density / MDD            fills a document-level input the caller left blank
#   hydrate / multiplier /
#   BSA / option / route     recorded on the row for the calculation to read
#
# Everything the stage finds is recorded in ``_note_audit`` so a reviewer can see
# which marker changed which number.
_EI_NOTE_UNIT_TO_MG = {"g": Decimal("1000"), "mg": Decimal("1"),
                       "mcg": Decimal("0.001"), "µg": Decimal("0.001"),
                       "ug": Decimal("0.001")}
_EI_NOTE_UNIT_RE = re.compile(r"\b(?:in|as|expressed\s+in|reported\s+in)\s+"
                              r"(g|mg|mcg|µg|ug)\b", re.IGNORECASE)
_EI_NOTE_DENSITY_RE = re.compile(r"([0-9]*\.?[0-9]+)\s*g\s*/\s*m\s*[lL]")
_EI_NOTE_PERCENT_RE = re.compile(r"([0-9]*\.?[0-9]+)\s*%")


def _ei_note_overage_fraction(text: str) -> Optional[float]:
    """The overage a note declares, as a fraction, or None."""
    m = _EI_NOTE_PERCENT_RE.search(safe_str(text))
    if not m:
        return None
    pct = _EV.dec_or_none(m.group(1))
    if pct is None or not (0 < pct < 100):
        return None
    return _FLOAT(_DIV(pct, 100))


def _ei_note_salt_factor(text: str) -> Optional[float]:
    """The salt/base ratio a note states, or None. Uses the shared RS parser so
    one sentence yields one factor in every workflow."""
    try:
        import residual_solvent as _RS                          # noqa: PLC0415
    except Exception:                                           # noqa: BLE001
        return None
    hit = _RS.parse_salt_base_footnote(text)
    if not hit or hit.get("kind") != "salt_base":
        return None
    factor = float(hit.get("salt_factor") or 1.0)
    if 1.0 < factor <= _RS.SALT_FACTOR_MAX:
        return round(factor, 6)
    return None


_EI_API_FUNCTION_RE = re.compile(
    r"\bactive\b|\bdrug\s+substance\b|\bapi\b|\ba\.?p\.?i\.?\b", re.IGNORECASE)


def _ei_row_is_api(row: Dict, columns: List[str]) -> bool:
    """True when this composition row is the active substance.

    Read from a Function / Role / Category cell, which is where a composition
    states it. Nothing here looks at the material's name.
    """
    cols = row.get("columns") if isinstance(row.get("columns"), dict) else {}
    for header, value in cols.items():
        h = safe_str(header).lower()
        if any(word in h for word in ("function", "role", "category", "type")):
            if _EI_API_FUNCTION_RE.search(safe_str(value)):
                return True
    return False


def apply_composition_notes(result: Dict, all_rows: List[List[str]]) -> Dict:
    """Build the document's NoteIndex, bind it, and apply what it says.

    Mutates *result* in place and returns the audit. Never raises: a workbook
    whose notes cannot be read is a workbook without note enrichment, not a
    failed generation.
    """
    audit: Dict[str, Any] = {"definitions": {}, "bindings": [], "unresolved": [],
                             "unresolved_critical": [], "applied": []}
    try:
        index = _EV.NoteIndex()
        cells: List[str] = []
        for r in (all_rows or []):
            for c in (r or []):
                if safe_str(c):
                    cells.append(c)
        index.add_definitions(cells, source="composition workbook")

        columns = [safe_str(c) for c in (result.get("columns") or [])]
        applied: List[str] = []
        doc_salt_factor = 0.0
        doc_salt_raw = ""
        doc_overage = 0.0
        doc_density = 0.0
        doc_mdd_mg = 0.0

        for section in (result.get("sections") or []):
            if not isinstance(section, dict):
                continue
            for row in (section.get("rows") or []):
                if not isinstance(row, dict):
                    continue
                raw_name = safe_str(row.get("ingredient", ""))
                # A footnote DEFINITION that survived extraction is not a row.
                if _EV.is_note_definition(raw_name):
                    row["_note_definition_row"] = True
                    row["_is_qs"] = True
                    continue
                name, notes = index.bind(raw_name, target=raw_name,
                                         column=result.get("ingredient_col", ""))
                if name != raw_name:
                    row["ingredient"] = name
                found = list(notes)

                cols = row.get("columns")
                if isinstance(cols, dict):
                    for header in list(cols.keys()):
                        clean, bound = index.bind(cols[header], target=name,
                                                  column=safe_str(header))
                        if clean != safe_str(cols[header]):
                            cols[header] = clean
                        for note in bound:
                            if note not in found:
                                found.append(note)

                if not found:
                    continue
                row["_notes"] = [n.as_dict() for n in found]
                row["_note_categories"] = sorted({n.category for n in found})
                is_api = _ei_row_is_api(row, columns)
                for note in found:
                    category = note.category
                    if category == "qs":
                        row["_is_qs"] = True
                        row["_note_qs"] = True
                        applied.append(f"{name or 'a row'}: q.s. note - excluded "
                                       "from the quantitative summation")
                    elif category == "overage":
                        fraction = _ei_note_overage_fraction(note.text)
                        if fraction:
                            # The row's own overage always; the DOCUMENT's
                            # only when the row is the API - an excipient's
                            # overage never changes the product's strength.
                            row["_note_overage_pct"] = fraction
                            if is_api:
                                doc_overage = fraction
                            applied.append(
                                f"{name or 'a row'}: {fraction * 100:.4g}% overage "
                                "- the displayed strength backs it out, the "
                                "formulation amount stays as printed")
                    elif category == "salt_base_equivalence":
                        factor = _ei_note_salt_factor(note.text)
                        if factor and is_api:
                            doc_salt_factor = factor
                            doc_salt_raw = note.text
                            row["_note_salt_factor"] = factor
                            applied.append(
                                f"{name or 'the API row'}: salt/base note - the "
                                f"dose basis is the free base (factor {factor})")
                        elif factor:
                            row["_note_salt_factor_display_only"] = factor
                            applied.append(
                                f"{name or 'a row'}: salt/base note is a display "
                                "equivalence for that row; the API dose basis is "
                                "unchanged")
                    elif category == "unit":
                        m = _EI_NOTE_UNIT_RE.search(note.text)
                        if m:
                            row["_note_amount_unit"] = m.group(1).lower()
                            applied.append(
                                f"{name or 'a row'}: quantity is in "
                                f"{m.group(1)} per its note, not the column unit")
                    elif category == "density":
                        m = _EI_NOTE_DENSITY_RE.search(note.text)
                        if m and not doc_density:
                            doc_density = safe_float(m.group(1))
                            applied.append(f"density {doc_density} g/mL from a note")
                    elif category == "mdd":
                        m = re.search(r"([0-9]*\.?[0-9]+)\s*(g|mg|mcg|µg|ug)\b",
                                      note.text, re.IGNORECASE)
                        if m and not doc_mdd_mg:
                            doc_mdd_mg = _FLOAT(_MUL(
                                m.group(1), _EI_NOTE_UNIT_TO_MG.get(
                                    m.group(2).lower(), _EV.DECIMAL_ONE)))
                            applied.append(
                                f"maximum daily dose {doc_mdd_mg} mg/day from a note")

        # Document-level effects, applied only where the caller left a blank.
        if doc_salt_factor:
            result.setdefault("salt_factor", doc_salt_factor)
            result["footnote_kind"] = "salt_base"
            result["footnote_raw"] = doc_salt_raw
            result.setdefault("dose_basis_used", "base")
        if doc_overage:
            result.setdefault("overage_pct", doc_overage)
        if doc_density and not safe_float(result.get("density_g_per_ml", 0)):
            result["density_g_per_ml"] = doc_density
        if doc_mdd_mg and not safe_float(result.get("mdd_total_mg_per_day", 0)):
            result["mdd_total_mg_per_day"] = doc_mdd_mg
            result["mdd_g"] = _FLOAT(_DIV(doc_mdd_mg, 1000))

        audit = index.audit()
        audit["applied"] = applied
        for line in applied:
            logger.info("[EI note] %s", line)
        for missing in audit.get("unresolved_critical") or ():
            logger.warning(
                "[EI note] quantity %r carries marker %r with no footnote "
                "anywhere in the workbook - its meaning is unknown.",
                missing.get("value"), missing.get("marker"))
    except Exception:                                           # noqa: BLE001
        logger.exception("EI note stage skipped")
    result["_note_audit"] = audit
    return audit


def _ei_template_grounding(excel_bytes: bytes, grounded: Any = None,
                           meta: Optional[Dict] = None) -> Optional[Dict]:
    """T15 — the workbook read through the upload template, or None.

    *grounded* is a grounding the caller already made (``False`` when it found
    none), so a workbook is never grounded - or sent to the model - twice.
    """
    if grounded is False:
        return None
    if isinstance(grounded, dict):
        return grounded
    try:
        import docgen_template as _TPL
        meta = meta or {}
        return _TPL.ground_composition_workbook(
            excel_bytes, claude_text=claude_text,
            prefer=_TPL.preference_from_request(meta.get("dosage_category"),
                                                meta.get("route"),
                                                meta.get("dosage_form")))
    except Exception:                                           # noqa: BLE001
        logger.debug("EI template grounding skipped", exc_info=True)
        return None


def _ei_data_worksheet(wb: Any, injectable: bool) -> Any:
    """The sheet the extractor reads: never the template's guidance sheet."""
    try:
        import docgen_template as _TPL
        return _TPL.first_data_worksheet(wb, injectable=injectable) or wb.worksheets[0]
    except Exception:                                           # noqa: BLE001
        return wb.worksheets[0]


def _ei_template_mdd_mg(meta: Optional[Dict]) -> Optional[float]:
    meta = meta or {}
    if not meta.get("mdd_value"):
        return None
    return DOSE.mdd_as_mg(meta.get("mdd_value"), meta.get("mdd_unit"))


def parse_composition_excel(excel_bytes: bytes, meta: Optional[Dict] = None,
                            grounded: Any = None) -> Dict:
    """
    Generic parser: works for oral sachets, injections, any formulation.
    Returns sections with ingredients and their amounts.

    A workbook filled on the official upload template's OSD sheet is read
    DETERMINISTICALLY through the template - no model call - and then goes
    through exactly the same post-processing as any other composition.
    """
    _g = _ei_template_grounding(excel_bytes, grounded, meta)
    if _g:
        try:
            import docgen_template as _TPL
            if not _TPL.is_injectable(_g):
                result, all_rows = _TPL.ei_osd_result(
                    _g, mdd_mg=_ei_template_mdd_mg(meta),
                    doses_per_day=safe_int((meta or {}).get("doses_per_day"), 1) or 1)
                return _ei_finish_composition(result, all_rows)
        except Exception:                                       # noqa: BLE001
            logger.exception("Template composition read failed; the extractor "
                             "reads the workbook instead")
    wb = openpyxl.load_workbook(BytesIO(excel_bytes), data_only=True)
    ws = _ei_data_worksheet(wb, injectable=False)
    rows_text: List[str] = []
    all_rows: List[List[str]] = []
    for i, row in enumerate(ws.iter_rows(values_only=True)):
        if any(c is not None for c in row):
            row_str = [str(c) if c is not None else "" for c in row]
            rows_text.append(f"Row {i+1}: {' | '.join(row_str)}")
            all_rows.append(row_str)
    wb.close()
    sheet_dump = "\n".join(rows_text[:100])

    prompt = (
        "You are extracting the ingredient composition table from a pharmaceutical "
        "drug product spreadsheet. Extract the table structure EXACTLY as printed.\n\n"
        "DO NOT calculate doses, daily dose, or total mass. DO NOT infer dosing. "
        "Only extract what is literally in the spreadsheet.\n\n"
        "Your tasks:\n"
        "1. Identify the column that contains the INGREDIENT/MATERIAL NAME.\n"
        "2. Identify the column that contains the AMOUNT per single dose unit "
        "(per sachet / per tablet / per mL / per vial). If multiple amount columns "
        "exist for different strengths, choose the one with the LARGEST values "
        "(highest strength = worst case for elemental impurity assessment).\n"
        "3. Identify the unit of that amount column (mg, g, mL, mg/mL, µg).\n"
        "4. Extract every ingredient row with all its column values.\n\n"
        "Return ONLY this JSON (no markdown, no comments):\n"
        "{\n"
        '  "ingredient_col": "<exact header text of the ingredient-name column>",\n'
        '  "amount_col": "<exact header text of the chosen amount column>",\n'
        '  "amount_unit": "<mg | g | mL | mg/mL | µg>",\n'
        '  "columns": ["<exact col1 header>","<exact col2 header>", "..."],\n'
        '  "sections": [\n'
        '    {\n'
        '      "name": "<section header text, or empty string>",\n'
        '      "rows": [\n'
        '        {"ingredient":"<name>","columns":{"<col header>":"<cell value>"}}\n'
        '      ]\n'
        '    }\n'
        '  ]\n'
        "}\n\n"
        "RULES:\n"
        "- columns[]: list the exact header text of every column, in order.\n"
        "- B5 — IGNORE decorative / non-table rows: a merged title/banner row (one "
        "cell of prose spanning many columns), a subtitle or caption row (e.g. "
        "'extracted from…', 'units/mL'), filter-dropdown header decorations, and "
        "trailing notes/footnote rows (starting with 'Note', '*', '#', 'Q.s.'). The "
        "REAL header row is the one containing 3+ of: S.No, Material Code, "
        "Ingredient, Function, Supplier, Quantity. Start data rows after it and stop "
        "at the first notes/footnote row.\n"
        "- A7 — the amount column may be titled 'Quantity/mL', 'Quantity per mL', "
        "'Qty/mL', 'Quantity/Vial', 'Qty/vial', 'Quantity/unit', 'mg/vial', "
        "'mg/mL', 'Amount in max dose', 'Content/mL', 'Strength', etc. When BOTH a "
        "per-mL and a per-vial (per-unit) column exist, PREFER the per-vial "
        "(per-unit) column.\n"
        "- A8 — an API row may be dosed in UNITS ('0.2 units', '40 units', 'IU', "
        "'USP units') rather than mg. NEVER drop such a row; keep its exact value "
        "and unit. If the sheet states a potency (units per mg), extract it too.\n"
        "- The amount column (e.g. 'mg/tab', 'mg/unit', 'Qty/unit', 'mg/0.65 mL') "
        "MUST be included in columns[] and must appear immediately after the "
        "ingredient-name column. Never drop the per-unit amount column.\n"
        "- If a Material Code / SAP Code / Item Code column exists (values like "
        "100015157 or 350100602), INCLUDE its exact header in columns[] and map "
        "each ingredient's code in that row's columns dict. Never drop it.\n"
        "- For each row, map each cell to its exact column header in the columns dict.\n"
        "- ingredient_col and amount_col MUST be values that appear in columns[].\n"
        "- amount_unit: read from the amount column header "
        "(e.g. 'Qty/unit (mg/0.65 mL)' → 'mg'; 'mg/sachet' → 'mg').\n"
        "- Include EVERY ingredient row, even pH adjusters and 'QS' rows.\n"
        "- Do NOT invent or compute any values. Extract only.\n\n"
        f"Spreadsheet:\n{sheet_dump}"
    )
    raw = claude_text(prompt)
    parsed = safe_json_parse(raw, {})

    if isinstance(parsed, dict) and isinstance(parsed.get("sections"), list) and parsed["sections"]:
        result = parsed
    else:
        logger.warning("Excel parse: fallback to raw rows")
        fallback_rows = []
        for row in all_rows[1:]:
            if len(row) > 2 and row[0].strip():
                fallback_rows.append({"ingredient": row[0], "amount": row[2] if len(row)>2 else "0",
                                       "unit": "", "function": ""})
        result = {"sections": [{"name": "Composition", "rows": fallback_rows}],
                  "ingredient_col": "", "amount_col": "", "amount_unit": "mg",
                  "columns": []}
    return _ei_finish_composition(result, all_rows)


# ── Table 1: the composition AS UPLOADED (T3) ────────────────────────────────
# A section the extractor names after the ONE strength it chose ("For 100 mg")
# is that choice restated, not a part of the formulation.
_EI_STRENGTH_ONLY_RE = re.compile(
    r"^\s*(?:for\s+|strength\s*[:\-]?\s*)?\d+(?:\.\d+)?\s*(?:mg|mcg|µg|ug|g|ml)\b"
    r"(?:\s*/\s*[a-z]+\.?)?\s*$", re.IGNORECASE)


def _ei_cell_key(text: Any) -> str:
    """A cell reduced to what identifies it: marks off, case and spacing folded."""
    raw = safe_str(text)
    return re.sub(r"\s+", " ", _EV.strip_note_markers(raw) or raw).strip().lower()


def _ei_display_cell(text: Any) -> str:
    """A cell as the sheet shows it; its marks were bound by the note stage."""
    raw = safe_str(text)
    clean = (_EV.strip_note_markers(raw) or raw).strip()
    return re.sub(r"^(-?\d+)\.0+$", r"\1", clean)


def _ei_display_composition(result: Dict, all_rows: List[List[str]]) -> None:
    """Set Table 1 from the sheet itself.

    Every column the sheet has - every strength side by side, the material
    code, the function, the vendor - and every ingredient row the extractor
    read, each cell copied verbatim, the name column first as every renderer
    expects. The extractor's single amount column (``amount_col``) feeds the
    calculation only: nothing here is selected, summed, merged or averaged.
    Leaves the result untouched when the sheet's header row cannot be found.
    """
    rows_in = all_rows or []
    ing_key = _ei_cell_key(result.get("ingredient_col"))
    header_idx = None
    for ri, row in enumerate(rows_in[:15]):
        roles = [COLS.classify_header(c) for c in row]
        if "quantity" in roles and (
                "name" in roles
                or (ing_key and ing_key in [_ei_cell_key(c) for c in row])):
            header_idx = ri
            break
    if header_idx is None:
        return
    header = [safe_str(c) for c in rows_in[header_idx]]
    name_i = next((i for i, c in enumerate(header)
                   if ing_key and _ei_cell_key(c) == ing_key), None)
    if name_i is None:
        name_i = COLS.resolve_name_column(header)
    if name_i is None:
        return
    # A banded header: "Quantity (mg/tab)" over "100 mg | 50 mg | 25 mg".
    data_start = header_idx + 1
    sub = ([safe_str(c) for c in rows_in[data_start]]
           if data_start < len(rows_in) else [])
    if (sub and not (name_i < len(sub) and sub[name_i])
            and any(c for i, c in enumerate(sub) if i != name_i)):
        width = max(len(header), len(sub))
        header += [""] * (width - len(header))
        band, combined = "", []
        for i in range(width):
            if header[i]:
                band = header[i]
            below = sub[i] if i < len(sub) else ""
            combined.append(f"{header[i] or band} {below}".strip() if below
                            else header[i])
        header = combined
        data_start += 1
    order = [name_i] + [i for i, c in enumerate(header)
                        if i != name_i and c and COLS.classify_header(c) != "serial"]
    labels: List[str] = []
    for i in order:
        label, n = header[i], 2
        while label in labels:
            label, n = f"{header[i]} ({n})", n + 1
        labels.append(label)
    unused: Dict[str, List[List[str]]] = {}
    for row in rows_in[data_start:]:
        if name_i < len(row) and _ei_cell_key(row[name_i]):
            unused.setdefault(_ei_cell_key(row[name_i]), []).append(row)
    quantity_keys = [_ei_cell_key(header[i]) for i in order
                     if COLS.classify_header(header[i]) == "quantity"]
    sections = []
    for section in result.get("sections") or []:
        if not isinstance(section, dict):
            continue
        rows = []
        for row in section.get("rows") or []:
            if not isinstance(row, dict) or row.get("_note_definition_row"):
                continue
            name = safe_str(row.get("ingredient"))
            matches = unused.get(_ei_cell_key(name)) or []
            source = matches.pop(0) if matches else None
            own = row.get("columns") if isinstance(row.get("columns"), dict) else {}
            cells = {label: _ei_display_cell(
                         (source[i] if i < len(source) else "") if source is not None
                         else own.get(header[i], ""))
                     for label, i in zip(labels, order)}
            cells[labels[0]] = name or cells[labels[0]]
            rows.append({"ingredient": name, "columns": cells})
        title = safe_str(section.get("name"))
        key = _ei_cell_key(title)
        if key and (_EI_STRENGTH_ONLY_RE.match(title)
                    or any(key in q for q in quantity_keys)):
            title = ""
        sections.append({"name": title, "rows": rows})
    if any(s["rows"] for s in sections):
        result["_display_columns"] = labels
        result["_display_sections"] = sections


def _ei_finish_composition(result: Dict, all_rows: List[List[str]]) -> Dict:
    """The post-processing every composition read goes through, however it was
    read: column vetting, the material-code backfill, the note stage, the
    as-uploaded Table 1 and the role-word self-test."""
    # NOTE: doses_per_day, route, and MDD are NOT extracted here — the user
    # enters them manually in the UI and they are injected into comp_data
    # afterwards. The Excel parser only provides the ingredient table structure.
    result["ingredient_col"]  = safe_str(result.get("ingredient_col", ""))
    # RED FLAG 14 — vet the extractor's own choice of ingredient-name column.
    # A "Pharmaceutical Function" / "Reference" / "Vendor" / "Material Code"
    # header is never the name column; when the model nominates one, re-pick
    # from the sheet headers so role words can never become ingredient names.
    result["ingredient_col"] = _ei_vet_ingredient_col(
        result["ingredient_col"], result.get("columns"), result.get("sections"))
    result["amount_col"]      = safe_str(result.get("amount_col", ""))
    result["amount_unit"]     = safe_str(result.get("amount_unit", "mg"))
    result["amount_per_dose"] = True  # amounts are per dose unit; scaled by doses_per_day
    # Defaults — always overridden by header in the pipeline
    result.setdefault("doses_per_day", 1)
    result.setdefault("route", "oral")
    result.setdefault("mdd_g", 1.0)
    if not isinstance(result.get("sections"), list): result["sections"] = []
    if not isinstance(result.get("columns"), list):  result["columns"] = []

    # ── Safeguard: ensure the amount column (e.g. "mg/tab") is always present ──
    # The component name + its per-unit amount must both appear in the rendered
    # table. If Claude omitted the amount column from `columns`, re-insert it
    # right after the ingredient column so the quantity is never dropped.
    cols = [safe_str(c) for c in result.get("columns", []) if safe_str(c)]
    ing_col = result["ingredient_col"]
    amt_col = result["amount_col"]
    if amt_col and amt_col not in cols:
        if ing_col and ing_col in cols:
            insert_at = cols.index(ing_col) + 1
            cols.insert(insert_at, amt_col)
        else:
            cols.append(amt_col)
    # If no columns were detected at all, derive them from the row data
    if not cols:
        seen: List[str] = []
        for sec in result.get("sections", []):
            if not isinstance(sec, dict): continue
            for row in (sec.get("rows") or []):
                if isinstance(row, dict) and isinstance(row.get("columns"), dict):
                    for k in row["columns"].keys():
                        if k not in seen:
                            seen.append(k)
        cols = seen
    result["columns"] = cols

    # ── RF12: Material Code column ────────────────────────────────────────────
    # DRL composition Excels usually carry a Material Code / SAP Code column
    # (9-digit 100xxxxxx / 350xxxxxx). Guarantee it reaches Table 1 by detecting
    # it deterministically in the raw Excel and backfilling per-ingredient codes,
    # rather than trusting the LLM to preserve it. Never fabricates a code; if no
    # such column exists, Table 1 is left unchanged.
    _MATCODE_HDR_RE = re.compile(
        r"\b(material\s*code|material\s*no\.?|material\s*number|sap\s*code|"
        r"item\s*code|mat\.?\s*code)\b", re.IGNORECASE)
    try:
        ing_col_l = safe_str(ing_col).lower().strip()
        hdr_idx = mat_idx = -1
        ing_idx = -1
        for ri, r in enumerate(all_rows[:15]):
            local_mat = local_ing = -1
            for ci, cellv in enumerate(r):
                cl = re.sub(r"\s+", " ", safe_str(cellv).lower()).strip()
                if local_mat < 0 and _MATCODE_HDR_RE.search(cl):
                    local_mat = ci
                if ing_col_l and cl == ing_col_l:
                    local_ing = ci
            if local_mat >= 0:
                hdr_idx, mat_idx = ri, local_mat
                ing_idx = local_ing
                break
        if mat_idx >= 0 and hdr_idx >= 0:
            mat_hdr = safe_str(all_rows[hdr_idx][mat_idx]) or "Material Code"
            if ing_idx < 0:
                ing_idx = 0
            code_by_ing: Dict[str, str] = {}
            for r in all_rows[hdr_idx + 1:]:
                if ing_idx < len(r) and mat_idx < len(r):
                    nm = re.sub(r"\s+", " ", safe_str(r[ing_idx]).lower()).strip()
                    code = safe_str(r[mat_idx]).strip()
                    if nm and code and not _MATCODE_HDR_RE.search(nm):
                        code_by_ing[nm] = code
            if code_by_ing:
                if mat_hdr not in cols:
                    if ing_col and ing_col in cols:
                        cols.insert(cols.index(ing_col) + 1, mat_hdr)
                    else:
                        cols.insert(min(1, len(cols)), mat_hdr)
                    result["columns"] = cols
                for sec in result.get("sections", []):
                    if not isinstance(sec, dict):
                        continue
                    for row in (sec.get("rows") or []):
                        if not isinstance(row, dict):
                            continue
                        if not isinstance(row.get("columns"), dict):
                            row["columns"] = {}
                        rc = row["columns"]
                        if safe_str(rc.get(mat_hdr)):
                            continue
                        nm = re.sub(r"\s+", " ",
                                    safe_str(row.get("ingredient", "")).lower()).strip()
                        if nm in code_by_ing:
                            rc[mat_hdr] = code_by_ing[nm]
    except Exception:
        logger.exception("RF12 material-code backfill skipped")

    result["all_rows"] = all_rows

    # ── The NOTE STAGE, before any calculation (Ticket 6) ────────────────────
    # Markers are bound to the rows and columns they modify, stripped from the
    # display text, and their meaning applied to the calculation inputs. A
    # marker removed for display whose meaning was never applied is exactly the
    # failure this stage exists to stop.
    apply_composition_notes(result, all_rows)

    # ── Table 1 is the composition AS UPLOADED (T3) ──────────────────────────
    # Every column the sheet has - every strength side by side - copied
    # verbatim. The extractor's choice of ONE amount column reaches the
    # calculation only. A template read already carries its own display.
    if not result.get("_display_columns"):
        try:
            _ei_display_composition(result, all_rows)
        except Exception:                                        # noqa: BLE001
            logger.exception("EI composition display copy skipped")

    # ── RED FLAG 14 ──────────────────────────────────────────────────────────
    # The resolved ingredient names are self-tested for role words, which is how
    # a wrong-column pick announces itself. The product NAME is never taken from
    # the composition (RF13): it comes from the request field only.
    try:
        _names = []
        for _sec in result.get("sections", []):
            if not isinstance(_sec, dict):
                continue
            for _row in (_sec.get("rows") or []):
                if isinstance(_row, dict):
                    _nm = safe_str(_row.get("ingredient", ""))
                    if _nm:
                        _names.append(_nm)
        _report = COLS.composition_column_report(_names, doc_type="EI")
        result["_column_selftest"] = _report["selftest_failures"]
    except Exception:                                            # noqa: BLE001
        logger.exception("EI composition column check skipped")

    return result


