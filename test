# ── Pre-flight ────────────────────────────────────────────────────────────────
def validate_inputs(excel_bytes: bytes,
                    annexure_raw: List[Tuple[str, str]],
                    header: Dict) -> List[str]:
    errors: List[str] = []
    # Required header fields (user-entered — no reference PDF)
    for field, label in [
        ("product_name",   "Product Name"),
        ("dosage_form",    "Dosage Form"),
        ("strength",       "Strength"),
        ("route",          "Route"),
        ("document_no",    "Document No"),
        ("mdd_mg_per_day", "MDD (mg/day)"),
    ]:
        if not safe_str(header.get(field, "")):
            errors.append(f"'{label}' is required.")
    if safe_float(header.get("mdd_mg_per_day", 0)) <= 0:
        errors.append("MDD (mg/day) must be a positive number.")
    try:
        wb = openpyxl.load_workbook(BytesIO(excel_bytes), data_only=True)
        if not wb.worksheets: errors.append("Excel has no sheets.")
        else:
            ws = wb.worksheets[0]
            nrows = sum(1 for row in ws.iter_rows(values_only=True) if any(c is not None for c in row))
            if nrows < 3: errors.append(f"Excel sheet has only {nrows} non-empty rows.")
        wb.close()
    except Exception as e:
        errors.append(f"Excel cannot be opened: {e}")
    if not annexure_raw:
        errors.append("No annexure files uploaded (JSON from annexure_converter.py or PDF).")
    for i, (name, raw) in enumerate(annexure_raw):
        if name.lower().endswith(".pdf"):
            continue  # PDFs validated during processing
        if not raw or not raw.strip():
            continue  # empty placeholder
        try:
            obj = json.loads(raw.lstrip("\ufeff"))
            if not isinstance(obj, (dict, list)):
                errors.append(f"Annexure {i+1} ({name}): JSON must be object or array.")
        except json.JSONDecodeError as e:
            errors.append(f"Annexure {i+1} ({name}): invalid JSON — {e}")
    import shutil
    if not shutil.which("node"):
        errors.append("Node.js not found. Install Node.js >= 18.")
    else:
        for pkg in ["docx", "jszip"]:
            r = subprocess.run(["node","-e",f"require('{pkg}');process.exit(0)"],
                               capture_output=True, timeout=10)
            if r.returncode != 0:
                errors.append(f"npm package '{pkg}' not found. Run: npm install {pkg}")
    creds = os.environ.get("GOOGLE_APPLICATION_CREDENTIALS","")
    if creds and not Path(creds).exists():
        errors.append(f"GCP credentials not found: {creds}")
    return errors


