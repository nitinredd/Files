# Identify the special footer rows in a detailed sheet
_TOTAL_ROW_HINTS = ("total daily exposure", "total exposure")
_LIMIT_ROW_HINTS = ("residual solvent limit", "usp <467>", "usp467", "limit as per")
_DRUGPRODUCT_HINTS = ("drug product",)
_QS_HINTS = ("q.s", "qs to", "q.s.", "water", "purified water")


def _is_qs_value(cell_value: str) -> bool:
    """True when a cell value denotes a q.s. (quantum satis) quantity rather than
    a number — e.g. 'q.s.', 'qs', 'q.s', 'q s', 'QS to volume'. Calculation-
    exempt but display-valid (Red Flag 3)."""
    s = _s(cell_value).lower().strip()
    if not s:
        return False
    s_norm = re.sub(r"[^a-z0-9 ]+", "", s)
    if s_norm in ("qs", "q s", "qsto", "q s to"):
        return True
    return bool(re.search(r"\bq\.?\s*s\.?\b", s))


def _is_footer_row(name: str) -> Optional[str]:
    n = name.lower()
    if any(h in n for h in _TOTAL_ROW_HINTS):
        return "total"
    if any(h in n for h in _LIMIT_ROW_HINTS):
        return "limit"
    if any(h in n for h in _DRUGPRODUCT_HINTS):
        return "drug_product"
    return None


# ════════════════════════════════════════════════════════════════════════════
# DETERMINISTIC EXCEL READING + MODE CLASSIFICATION
# These read the workbook directly (no LLM-shape dependency) so unit-composition
# and component-MDD Excels are parsed reliably and product-agnostically.
# ════════════════════════════════════════════════════════════════════════════
# A strength column header: "100 mg", and the way formula sheets write it -
# "For 100 mg/tab", "50 mg / tablet", "25 mg/capsule". The first number is the
# strength; the optional "For" and "/unit" add nothing to it.
_STRENGTH_RE = re.compile(
    r"^\s*(?:for\s+)?\d+(?:\.\d+)?\s*mg\s*"
    r"(?:/\s*(?:tabs?|tablets?|caps?|capsules?|units?|vials?|doses?|sachets?)\.?)?\s*$",
    re.IGNORECASE)
_AMOUNT_HINTS = ("amount in maximum dose", "amount in max dose", "amount in maximum")
_MDD_HINTS = ("maximum daily intake", "max daily intake", "mdd", "maximum daily dose",
              "daily intake")
_QTY_HINTS = (
    # multi-word patterns FIRST so they win the header hint scan
    "quantity / unit", "quantity/unit", "qty/unit", "quantity per unit",
    "mg / vial", "mg / ml", "mg / tablet", "mg / capsule", "mg / sachet",
    "mg/vial", "mg/ml", "mg/tablet", "mg/capsule", "mg/sachet", "mg/dose",
    "mg / tab", "mg/tab",
    "amount per unit", "amount/unit",
    "per unit", "per vial", "per ml", "per tablet", "per capsule", "per sachet",
    "quantity mg", "amount mg", "quantity (", "qty (", "qty.",
    # broad fallbacks – checked last
    "mg/unit", "quantity", "qty ", "amount",
)

# Unit-basis hints — recognised in the qty column header to drive the dose
# basis prompt (mg/Vial, mg/mL, mg/tablet, mg/sachet, mg/dose, mg/capsule).
_UNIT_BASIS_PATTERNS = [
    (re.compile(r"mg\s*[/\(]\s*vial", re.IGNORECASE), "vial"),
    (re.compile(r"mg\s*[/\(]\s*ml", re.IGNORECASE), "ml"),
    (re.compile(r"mg\s*[/\(]\s*tab(?:let)?s?\b", re.IGNORECASE), "tablet"),
    (re.compile(r"mg\s*[/\(]\s*capsule", re.IGNORECASE), "capsule"),
    (re.compile(r"mg\s*[/\(]\s*sachet", re.IGNORECASE), "sachet"),
    (re.compile(r"mg\s*[/\(]\s*dose", re.IGNORECASE), "dose"),
    (re.compile(r"per\s+vial", re.IGNORECASE), "vial"),
    (re.compile(r"per\s+ml", re.IGNORECASE), "ml"),
    (re.compile(r"per\s+tablet", re.IGNORECASE), "tablet"),
    (re.compile(r"per\s+capsule", re.IGNORECASE), "capsule"),
    (re.compile(r"per\s+sachet", re.IGNORECASE), "sachet"),
]


def _infer_unit_basis(header_label: str) -> str:
    """The presentation basis a quantity column is expressed in.

    The explicit patterns above cover the canonical spellings ("mg/mL",
    "per vial"). Anything else falls through to the shared column detector,
    which reads the compact forms real sheets use — "Qty./1mL", "Qty./2mL",
    "Quantity/Vial (100 mL)". Missing those made a volume-dosed liquid parse as
    a solid, so its drug-product mass became the sum of dissolved solids instead
    of volume x density, and the equivalent-ppm denominator was far too small.
    """
    if not header_label:
        return "unit"
    for rx, basis in _UNIT_BASIS_PATTERNS:
        if rx.search(header_label):
            return basis
    detected = DOSE.detect_quantity_columns([header_label])
    if detected:
        return _s(detected[0].get("unit_basis")) or "unit"
    return "unit"
_COMP_HINTS = ("component", "ingredient", "material", "name of ingredient", "name")
_COMPENDIA_HINTS = ("compendia", "compendial", "status", "grade")
_STAGE_HINTS = ("stage", "step", "process step", "manufacturing stage")
_SOLVENT_HINTS = ("limit (ppm)", "daily exposure", "ppm", "residual solvent")

# Named residual solvents that headline a detailed RS calculation sheet.
_RS_SOLVENT_NAMES = (
    "ethanol", "methanol", "toluene", "acetone", "isopropyl alcohol",
    "iso propyl alcohol", "ethylene glycol", "1,4-dioxane", "1,4 dioxane",
    "heptane", "tert-butyl alcohol", "tertiary butyl alcohol", "t-butyl alcohol",
    "dehydrated alcohol", "dichloromethane", "n-hexane", "hexane",
    "ethyl acetate", "methylene chloride",
)


def _detailed_rs_signatures(sheet: Dict) -> int:
    """Count how many detailed-RS-calculation signatures are present in a sheet.
    Scans the header AND the whole grid (footers included) so signatures such as
    'Drug Product', 'Total Daily Exposure' and 'Residual solvent Limit as per
    current USP <467>' are detected even when they sit in footer rows. A sheet
    with >= 4 signatures is a detailed RS calculation sheet (Type B)."""
    header = sheet.get("header", []) or []
    rows = sheet.get("rows", []) or []
    # Flatten all cell text (header + body) into one lowercased blob.
    cells: List[str] = [_s(h).lower() for h in header]
    for r in rows:
        if isinstance(r, list):
            cells.extend(_s(c).lower() for c in r)
        elif isinstance(r, dict):
            cells.extend(_s(c).lower() for c in r.values())
    blob = " | ".join(cells)

    sig = 0
    # 1. "No. of doses"
    if re.search(r"no\.?\s*of\s*doses", blob):
        sig += 1
    # 2. "Quantity / unit (mg)"
    if any(h in blob for h in ("quantity / unit", "quantity/unit",
                               "quantity per unit", "qty/unit")):
        sig += 1
    # 3. "Amount in Maximum Dose (mg)"
    if any(h in blob for h in _AMOUNT_HINTS):
        sig += 1
    # 4. Named solvent group headers (count as one signature if >= 1 present)
    if any(nm in blob for nm in _RS_SOLVENT_NAMES):
        sig += 1
    # 5. Per-solvent sub-headers "Limit (ppm)" and "Daily Exposure (mg)"
    if "limit (ppm)" in blob or re.search(r"limit\s*\(?\s*ppm", blob):
        sig += 1
    if "daily exposure" in blob:
        sig += 1
    # 6. "Drug Product" footer row
    if "drug product" in blob:
        sig += 1
    # 7. "Total Daily Exposure" footer row
    if "total daily exposure" in blob:
        sig += 1
    # 8. "Residual solvent Limit as per current USP <467>" footer row
    if re.search(r"residual\s+solvent.*usp\s*<?\s*467", blob) or \
       re.search(r"usp\s*<?\s*467", blob):
        sig += 1
    return sig


def read_excel_grid(excel_bytes: bytes, max_rows: int = 400) -> List[Dict]:
    """
    Read every worksheet into a list of {sheet, header, rows} using openpyxl.
    Header = the first row that looks like column labels. Deterministic; no LLM.
    """
    import openpyxl
    from io import BytesIO
    wb = openpyxl.load_workbook(BytesIO(excel_bytes), data_only=True)
    sheets = []
    for ws in wb.worksheets:
        grid = []
        for i, row in enumerate(ws.iter_rows(values_only=True)):
            grid.append(["" if c is None else str(c).strip() for c in row])
            if i > max_rows:
                break
        if not grid:
            continue
        # Find the header row: the row with the most non-empty, text-ish cells
        # that also contains a component-like or strength-like or amount-like label.
        header_idx = 0
        best_score = -1
        for idx in range(min(len(grid), 15)):
            cells = grid[idx]
            nonempty = [c for c in cells if c]
            if not nonempty:
                continue
            low = " | ".join(c.lower() for c in nonempty)
            score = len(nonempty)
            if any(h in low for h in _COMP_HINTS):
                score += 5
            if any(_STRENGTH_RE.match(c) for c in nonempty):
                score += 5
            if any(h in low for h in _AMOUNT_HINTS + _MDD_HINTS):
                score += 4
            if score > best_score:
                best_score = score
                header_idx = idx
        header = grid[header_idx]
        data_rows = grid[header_idx + 1:]
        sheets.append({"sheet": ws.title, "header": header,
                       "rows": data_rows, "header_idx": header_idx,
                       "full_grid": grid})
    wb.close()
    return sheets


def parse_flat_detailed_rs_excel(excel_bytes: bytes) -> Dict:
    """
    Deterministically parse a FLAT single-header detailed RS calculation Excel
    (no LLM). Emits a raw dict compatible with parse_rs_excel(): component rows
    with a 'columns' map, plus footer rows (Drug Product / Total Daily Exposure /
    USP <467> limit) tagged so parse_rs_excel classifies them.

    Handles:
      - a 'No. of doses' cell (row 1) with the numeric value in an adjacent cell
      - a single-row header with 'Components', 'Quantity / unit (mg)',
        'Amount in Maximum Dose (mg)' and per-solvent 'X Limit (ppm)' /
        'X Daily Exposure (mg)' columns
      - solvent columns auto-detected via _RS_SOLVENT_NAMES
      - footer rows via _is_footer_row

    Returns {} (empty) if it cannot find a usable component header + rows, so the
    caller can fall back to the Claude extraction path.
    """
    try:
        import openpyxl
        from io import BytesIO
        wb = openpyxl.load_workbook(BytesIO(excel_bytes), data_only=True)
    except Exception:
        return {}

    best: Dict[str, Any] = {}
    for ws in wb.worksheets:
        grid = []
        for row in ws.iter_rows(values_only=True):
            grid.append(["" if c is None else str(c).strip() for c in row])
        if not grid:
            continue

        # ── Find 'No. of doses' anywhere in the grid ─────────────────────────
        no_of_doses = None
        for r_i, row in enumerate(grid):
            for c_i, cell in enumerate(row):
                if re.search(r"no\.?\s*of\s*doses", cell.lower()):
                    # numeric value in an adjacent cell (right, then below)
                    for (rr, cc) in ((r_i, c_i + 1), (r_i + 1, c_i),
                                     (r_i, c_i + 2)):
                        if rr < len(grid) and cc < len(grid[rr]):
                            v = _num_or_none(grid[rr][cc])
                            if v:
                                no_of_doses = int(v)
                                break
                if no_of_doses:
                    break
            if no_of_doses:
                break

        # ── Find the component header row ────────────────────────────────────
        header_idx = None
        comp_col_idx = None
        for idx in range(min(len(grid), 25)):
            row = grid[idx]
            low = [c.lower() for c in row]
            for ci, c in enumerate(low):
                if any(h == c or h in c for h in ("components", "component",
                                                  "ingredient", "name of ingredient")):
                    comp_col_idx = ci
                    break
            if comp_col_idx is not None:
                # confirm this row also has quantity/amount or a solvent name
                joined = " | ".join(low)
                if (any(h in joined for h in _QTY_HINTS + _AMOUNT_HINTS)
                        or any(nm in joined for nm in _RS_SOLVENT_NAMES)
                        or "ppm" in joined or "daily exposure" in joined):
                    header_idx = idx
                    break
                comp_col_idx = None
        if header_idx is None:
            continue

        header = grid[header_idx]
        # Some detailed sheets use TWO header rows (solvent name on row N,
        # 'Limit (ppm)'/'Daily Exposure (mg)' on row N+1). Merge them so each
        # column has a full 'Ethanol Limit (ppm)' style label.
        merged_header = list(header)
        if header_idx + 1 < len(grid):
            sub = grid[header_idx + 1]
            sub_low = " | ".join(s.lower() for s in sub)
            if ("limit" in sub_low and "ppm" in sub_low) or "daily exposure" in sub_low:
                # carry the last seen solvent/group label forward across blanks
                last_group = ""
                combined = []
                for i in range(max(len(header), len(sub))):
                    top = header[i] if i < len(header) else ""
                    bot = sub[i] if i < len(sub) else ""
                    if top:
                        last_group = top
                    label = (f"{last_group} {bot}".strip() if bot else top or last_group)
                    combined.append(label.strip())
                merged_header = combined
                data_start = header_idx + 2
            else:
                data_start = header_idx + 1
        else:
            data_start = header_idx + 1

        # ── Detect solvent columns via _RS_SOLVENT_NAMES ─────────────────────
        solvents: List[str] = []
        for h in merged_header:
            hl = h.lower()
            for nm in _RS_SOLVENT_NAMES:
                if nm in hl:
                    # display name = the solvent portion (strip role words)
                    disp = re.sub(r"\b(limit|ppm|daily|exposure|mg|\(.*?\))\b", " ", h,
                                  flags=re.IGNORECASE)
                    disp = re.sub(r"[^A-Za-z0-9,\- ]+", " ", disp)
                    disp = re.sub(r"\s+", " ", disp).strip()
                    if disp and disp not in solvents:
                        solvents.append(disp)
                    break

        # locate quantity / amount columns
        def _find_col(hints):
            for i, h in enumerate(merged_header):
                if any(hint in h.lower() for hint in hints):
                    return i, merged_header[i]
            return None, ""
        _qi, quantity_col = _find_col(_QTY_HINTS)
        _ai, amount_col = _find_col(_AMOUNT_HINTS)
        component_col = merged_header[comp_col_idx] if comp_col_idx < len(merged_header) else "Components"

        # ── Build rows (component + footer) as {columns:{label:value}} ───────
        out_rows: List[Dict] = []
        for r in grid[data_start:]:
            if comp_col_idx >= len(r):
                continue
            name = _s(r[comp_col_idx])
            if not name:
                # a row with values but no name in the component column is skipped
                if not any(_s(x) for x in r):
                    continue
            cols_map = {}
            for i, label in enumerate(merged_header):
                if not label:
                    continue
                val = _s(r[i]) if i < len(r) else ""
                cols_map[label] = val
            # ensure the component label carries the name
            if component_col:
                cols_map[component_col] = name
            out_rows.append({"columns": cols_map})

        if not out_rows or not solvents:
            continue

        raw = {
            "no_of_doses": no_of_doses,
            "component_col": component_col or "Components",
            "quantity_col": quantity_col,
            "amount_col": amount_col,
            "solvents": solvents,
            "columns": [h for h in merged_header if h],
            "has_calculated_values": True,
            "rows": out_rows,
            "_parser": "flat_deterministic",
        }
        # Prefer the sheet with the most component rows / solvents
        if (not best) or (len(out_rows) > len(best.get("rows", []))):
            best = raw

    wb.close()
    return best


def _col_index(header: List[str], hints: Tuple[str, ...]) -> Optional[int]:
    """Return the index of the first header cell matching any hint.

    Hints are scanned in ORDER, so earlier hints win. When matching the generic
    'material' hint, cells with 'code'/'no.' are skipped so a 'Material code'
    column never masquerades as the component (ingredient) column.
    """
    for hint in hints:
        for i, h in enumerate(header):
            hl = h.lower().strip()
            if hint == "material" and any(
                    bad in hl for bad in ("code", "no.", "no ", "no.")):
                continue
            if hint in hl:
                return i
    return None


def _comp_col_index(header: List[str]) -> Optional[int]:
    """The ingredient-name column, vetted against RED FLAG 14.

    The plain hint scan can nominate a column whose header is a ROLE
    ("Pharmaceutical Function"), a reference, a vendor or a material CODE —
    Chlorpromazine then parsed "Antioxidant" / "Tonicity agent" as ingredient
    names and nothing mapped. ``docgen_columns`` classifies every header and
    rejects any of those, falling back to the leftmost genuine name column.
    """
    return COLS.resolve_name_column(header, _col_index(header, _COMP_HINTS))


def _strength_columns(header: List[str]) -> List[Tuple[int, str, float]]:
    """Return [(col_index, label, mg_value)] for every strength column like '40 mg'."""
    out = []
    for i, h in enumerate(header):
        if _STRENGTH_RE.match(h or ""):
            m = re.search(r"\d+(?:\.\d+)?", h)
            if m:
                out.append((i, h.strip(), float(m.group(0))))
    return out


# Instruction / notes / guidance tabs must never be classified as a calculation
# sheet — their prose contains RS keywords that falsely trip signatures (RF7a).
_INSTRUCTION_SHEET_TOKENS = (
    "instruction", "instructions", "note", "notes", "readme", "read me",
    "help", "guide", "guidance", "manual", "info", "information", "legend",
    "key", "cover", "index", "how to use", "definitions", "glossary",
)


def _is_instruction_sheet(sh: Dict) -> bool:
    """True for an instructions/notes/guidance tab, or any sheet dominated by
    long free-text prose cells (>80 chars, more than 3 of them)."""
    name = _s(sh.get("sheet")).lower().strip()
    name_tokens = set(re.split(r"[\s_\-]+", name))
    for tok in _INSTRUCTION_SHEET_TOKENS:
        if name == tok or tok in name_tokens or name.startswith(tok + " "):
            return True
    header = sh.get("header", []) or []
    rows = sh.get("rows", []) or []
    cells: List[str] = list(header)
    for r in rows:
        if isinstance(r, list):
            cells.extend(r)
        elif isinstance(r, dict):
            cells.extend(r.values())
    long_cells = sum(1 for c in cells if len(_s(c)) > 80)
    return long_cells > 3


def classify_rs_excel(excel_bytes: bytes) -> Dict:
    """
    Classify the Excel into one of:
      - detailed_rs_calculation
      - unit_composition_strength_columns
      - combined_workbook         (a unit-composition sheet AND a detailed sheet)
      - component_mdd_only
      - insufficient_material_names_only
    Returns a dict with mode, the chosen sheet, detected columns, and strengths.
    Deterministic and product-agnostic.
    """
    sheets = read_excel_grid(excel_bytes)
    if not sheets:
        return {"mode": "insufficient_material_names_only", "reason": "empty workbook",
                "sheets": []}

    # Classify each sheet's role independently first.
    sheet_roles = []        # (role, info)
    detailed_candidates = []   # RF7a: choose the highest-signature detailed sheet
    detailed_info = None
    unit_info = None
    mdd_info = None
    single_info = None
    for sh in sheets:
        # RF7a: never classify an instructions / notes / prose sheet.
        if _is_instruction_sheet(sh):
            continue
        header = sh["header"]
        low_join = " | ".join(h.lower() for h in header)
        has_solvent = any(h in low_join for h in _SOLVENT_HINTS)
        has_amount = _col_index(header, _AMOUNT_HINTS) is not None
        has_mdd = _col_index(header, _MDD_HINTS) is not None
        qty_idx = _col_index(header, _QTY_HINTS)
        has_qty = qty_idx is not None
        strengths = _strength_columns(header)
        comp_idx = _comp_col_index(header)

        info = {
            "sheet": sh["sheet"], "header": header, "rows": sh["rows"],
            "comp_idx": comp_idx, "has_solvent": has_solvent,
            "has_amount": has_amount, "has_mdd": has_mdd, "has_qty": has_qty,
            "qty_idx": qty_idx, "strengths": strengths,
        }

        # Type B (detailed RS calculation) is detected FIRST, via a robust
        # signature count that scans header + footers. >= 4 signatures ⇒ detailed.
        # This ensures a complete pre-computed Excel is never misread as a unit-
        # composition sheet (which would wrongly prompt for MDD / strength).
        n_sig = _detailed_rs_signatures(sh)
        info["detailed_signatures"] = n_sig
        if n_sig >= 4:
            info["mode"] = "detailed_rs_calculation"
            sheet_roles.append(("detailed", info))
            detailed_candidates.append(info)
        elif has_solvent and (has_amount or has_qty):
            info["mode"] = "detailed_rs_calculation"
            sheet_roles.append(("detailed", info))
            detailed_candidates.append(info)
        elif strengths and comp_idx is not None and not has_amount and not has_mdd:
            info["mode"] = "unit_composition_strength_columns"
            sheet_roles.append(("unit", info))
            unit_info = unit_info or info
        elif (has_amount or has_mdd) and comp_idx is not None:
            info["mode"] = "component_mdd_only"
            sheet_roles.append(("mdd", info))
            mdd_info = mdd_info or info
        elif (has_qty and comp_idx is not None and not strengths
              and not has_solvent):
            # Single-strength unit composition: one quantity column with a
            # unit basis (mg/vial, mg/mL, mg/tablet, mg/sachet, mg/dose).
            info["mode"] = "single_strength_unit_composition"
            info["unit_basis"] = _infer_unit_basis(
                header[qty_idx] if qty_idx is not None and qty_idx < len(header) else "")
            info["qty_col_label"] = (header[qty_idx] if qty_idx is not None
                                     and qty_idx < len(header) else "")
            sheet_roles.append(("single", info))
            single_info = single_info or info
        else:
            info["mode"] = "insufficient_material_names_only"
            sheet_roles.append(("insufficient", info))

    # RF7a: among all detailed candidates, keep the one with the most signatures
    # (a full calculation sheet beats a thin one that merely mentions a solvent).
    if detailed_candidates:
        detailed_info = max(detailed_candidates,
                            key=lambda i: i.get("detailed_signatures", 0))

    # Combined workbook: BOTH a unit-composition sheet AND a detailed sheet exist.
    if unit_info is not None and detailed_info is not None:
        return {"mode": "combined_workbook",
                "sheet": unit_info["sheet"],
                "unit_sheet": unit_info, "detailed_sheet": detailed_info,
                "header": unit_info["header"], "rows": unit_info["rows"],
                "comp_idx": unit_info["comp_idx"], "strengths": unit_info["strengths"],
                "sheets": sheets}

    # Single-role priority: detailed > unit > mdd > single > insufficient
    if detailed_info is not None:
        return {**detailed_info, "sheets": sheets}
    if unit_info is not None:
        return {**unit_info, "sheets": sheets}
    if mdd_info is not None:
        return {**mdd_info, "sheets": sheets}
    if single_info is not None:
        return {**single_info, "sheets": sheets}
    return {"mode": "insufficient_material_names_only",
            **(sheet_roles[0][1] if sheet_roles else {}), "sheets": sheets,
            "mode_override": "insufficient_material_names_only"}


def _clean_num(v: Any) -> Optional[float]:
    return _num_or_none(v)


_RS_NA_CELL_RE = re.compile(
    r"^\s*(?:n\.?\s*a\.?|n/a|nil|none|not\s+applicable|-+|–|—)\s*$", re.IGNORECASE)


def _rs_absent_at_strength(selected: Any, others: List[Any]) -> bool:
    """True when a row states no quantity at the selected strength but does at
    another: a per-strength variant (one colour of a coating per strength) that
    is not part of this strength's formulation.

    An explicit NA / "-" at the selected strength beside a number or a q.s.
    elsewhere is such a row. A BLANK selected cell counts only beside a number:
    a q.s. merged across the strength columns reads blank everywhere but its
    first cell, and that vehicle belongs to every strength.
    """
    sel = _s(selected).strip()
    explicit_na = bool(sel) and bool(_RS_NA_CELL_RE.match(sel))
    if sel and not explicit_na:
        return False
    stated = [_s(o).strip() for o in others or []]
    stated = [o for o in stated if o and not _RS_NA_CELL_RE.match(o)]
    numeric = any(_num_or_none(_strip_footnote_markers(o)) is not None for o in stated)
    qs = any(_is_qs_value(o) for o in stated)
    return (numeric or qs) if explicit_na else numeric


def parse_unit_composition_excel(classified: Dict, mdd_mg_day: float,
                                 selected_strength: Optional[float] = None,
                                 doses_per_day: int = 1) -> Dict:
    """
    Mode B parser. Strength-column unit composition:
        Ingredient | Compendia Status | 40 mg | 20 mg | 10 mg | Stage

    The strength under assessment is DERIVED, never forced to the maximum:
    ``implied_strength = MDD ÷ doses_per_day`` picks the column, and the
    multiplier is then the number of units taken per day. MDD 120 mg over 12
    doses is the 10 mg presentation — selecting the 40 mg column instead would
    compute 480 mg/day and contradict the stated MDD. When no column matches
    the implied strength the choice falls back to the largest presentation
    (worst case) with ``MDD ÷ strength`` units per day, and says so.

    Exactly ONE column feeds the maths; the others remain in the composition
    table for display. Duplicate components across stages are aggregated for the
    quantitative total while stage rows are preserved for display.
    """
    header = classified["header"]
    rows = classified["rows"]
    comp_idx = classified.get("comp_idx")
    strengths = classified.get("strengths", [])
    compendia_idx = _col_index(header, _COMPENDIA_HINTS)
    stage_idx = _col_index(header, _STAGE_HINTS)

    if comp_idx is None or not strengths:
        return {"mode": "unit_composition_strength_columns", "rows": [],
                "needs_dose_basis": True, "error": "missing component or strength columns"}

    # ── Part 3: derive the strength from the regimen, never force the max ────
    doses = max(1, int(doses_per_day or 1))
    implied = DOSE.implied_strength(mdd_mg_day, doses)
    strength_warnings: List[str] = []
    if selected_strength is not None:               # explicit caller override
        sel = min(strengths, key=lambda x: abs(x[2] - selected_strength))
        sel_reason = f"caller selected {selected_strength:g} mg"
        strength_matched = True
    else:
        choice = DOSE.select_strength_column(
            [{"index": i, "label": lbl, "unit_basis": "unit",
              "volume_ml": None, "header_strength_mg": mg}
             for (i, lbl, mg) in strengths],
            {i: mg for (i, _lbl, mg) in strengths}, implied)
        chosen = choice.get("column") or {}
        sel = next((t for t in strengths if t[0] == chosen.get("index")),
                   max(strengths, key=lambda x: x[2]))
        sel_reason = _s(choice.get("reason"))
        strength_matched = bool(choice.get("matched"))
        strength_warnings.extend(choice.get("warnings") or [])
    sel_idx, sel_label, sel_mg = sel

    # Units taken per day. When the implied strength genuinely matches the
    # selected column the count IS doses_per_day (MDD = strength × doses by
    # construction); otherwise MDD ÷ strength keeps the stated MDD authoritative.
    no_of_doses = None
    _implied_d, _sel_mg_d = _D(implied), _D(sel_mg)
    if strength_matched and _implied_d > 0 and _sel_mg_d > 0 and _DIV(abs(_sel_mg_d - _implied_d), _implied_d, default=1) <= _D(DOSE.STRENGTH_MATCH_TOLERANCE):
        no_of_doses = _D(doses)
    elif mdd_mg_day and _sel_mg_d > 0:
        no_of_doses = _DIV(mdd_mg_day, _sel_mg_d)
    logger.info("[RS] strength column '%s' (%s); units/day = %s",
                sel_label, sel_reason, no_of_doses)

    # Build display columns (verbatim) and quantitative aggregation
    display_columns = [header[comp_idx]]
    if compendia_idx is not None:
        display_columns.append(header[compendia_idx])
    display_columns += [lbl for (_i, lbl, _mg) in strengths]
    if stage_idx is not None:
        display_columns.append(header[stage_idx])

    display_rows: List[Dict] = []
    agg: Dict[str, Dict] = {}    # component -> aggregated quantity at selected strength
    absent_at_strength: List[str] = []
    order: List[str] = []

    for r in rows:
        if comp_idx >= len(r):
            continue
        name = _s(r[comp_idx])
        if not name:
            continue
        # Display row (verbatim)
        disp = {header[comp_idx]: name}
        if compendia_idx is not None and compendia_idx < len(r):
            disp[header[compendia_idx]] = _s(r[compendia_idx])
        for (si, lbl, _mg) in strengths:
            disp[lbl] = _s(r[si]) if si < len(r) else ""
        if stage_idx is not None and stage_idx < len(r):
            disp[header[stage_idx]] = _s(r[stage_idx])
        display_rows.append({"ingredient": name, "columns": disp})

        is_qs = any(h in name.lower() for h in _QS_HINTS)
        # Enhanced q.s. detection: ingredient hints (@ suffix, gases, process
        # aids) and non-numeric quantity cells are also q.s. rows.
        if _is_qs_ingredient(name):
            is_qs = True
        sel_cell_val = _s(r[sel_idx]) if sel_idx < len(r) else ""
        # RS-6 — a variant with no quantity at THIS strength is not in this
        # strength's formulation: it stays in the composition table above and
        # is never a calculation row, and never a q.s. one.
        if _rs_absent_at_strength(
                sel_cell_val, [_s(r[si]) if si < len(r) else ""
                               for (si, _l, _m) in strengths if si != sel_idx]):
            absent_at_strength.append(name)
            continue
        if _is_qs_quantity(sel_cell_val):
            is_qs = True
        qty = (_EV.dec_or_none(_strip_footnote_markers(sel_cell_val))
               if sel_idx < len(r) else None)

        key = name.strip().lower()
        if key not in agg:
            agg[key] = {"component": name, "qty_per_unit": _EV.DECIMAL_ZERO,
                        "_is_qs": is_qs, "had_qty": False}
            order.append(key)
        if qty is not None:
            # One component listed in several stages contributes each of its
            # quantities; the sum is exact, so the total is the total.
            agg[key]["qty_per_unit"] = agg[key]["qty_per_unit"] + qty
            agg[key]["had_qty"] = True
        if is_qs:
            agg[key]["_is_qs"] = True

    for _name in absent_at_strength:
        strength_warnings.append(
            f"'{_name}' states no quantity at the selected {sel_label} strength, "
            "so it is not part of that strength's formulation; it is shown in "
            "the composition table only.")
    comp_rows: List[Dict] = []
    for key in order:
        a = agg[key]
        qty_unit = a["qty_per_unit"] if a["had_qty"] else None
        amount_mg = None
        basis = "none"
        amount_exact = None
        if (not a["_is_qs"]) and qty_unit is not None and no_of_doses:
            amount_exact = _MUL(qty_unit, no_of_doses)
            amount_mg = _FLOAT(_ROUND(amount_exact, 6))
            basis = "selected_strength_column_times_units_per_day"
        comp_rows.append({
            "component": a["component"],
            "quantity": (_FLOAT(_ROUND(qty_unit, 6))
                         if qty_unit is not None else None),
            "amount_in_maximum_dose_mg": amount_mg,
            "amount_in_maximum_dose_mg_exact": (str(amount_exact)
                                                if amount_exact is not None
                                                else None),
            "amount_basis": basis,
            "_is_qs": a["_is_qs"],
            "solvents": {},          # no Excel solvent columns in this mode
            "columns": {},
        })

    needs_dose_basis = any((not c["_is_qs"]) and c["amount_in_maximum_dose_mg"] is None
                           for c in comp_rows)
    product_mdd = _FLOAT(_ROUND(mdd_mg_day, 6)) if mdd_mg_day else None

    return {
        "mode": "unit_composition_strength_columns",
        "no_of_doses": _FLOAT(no_of_doses) if no_of_doses is not None else None,
        "multiplier": _FLOAT(no_of_doses) if no_of_doses is not None else None,
        "multiplier_exact": str(no_of_doses) if no_of_doses is not None else None,
        "selected_strength_mg": sel_mg,
        "selected_strength_label": sel_label,
        "selected_strength_column": sel_label,
        "strength_selection_reason": sel_reason,
        "strength_matched": strength_matched,
        "implied_strength": round(implied, 6) if implied else None,
        "doses_per_day": doses,
        "detected_strengths": [(lbl, mg) for (_i, lbl, mg) in strengths],
        "component_col": header[comp_idx],
        "quantity_col": "Quantity / unit (mg)",
        "amount_col": "Amount in Maximum Dose (mg)",
        "mdi_col": "", "mdi_unit": "",
        "columns": ["Components", "Quantity / unit (mg)", "Amount in Maximum Dose (mg)"],
        "solvents_display": [],
        "solvent_canon": {},
        "rows": comp_rows,
        "footer_total": {}, "footer_limit": {}, "drug_product_row": {},
        "has_calculated_values": False,
        "needs_dose_basis": needs_dose_basis,
        "product_mdd_mg": product_mdd,
        "mdd_source": "mdd_over_derived_strength",
        "_display_columns": display_columns,
        "_display_sections": [{"name": "Composition", "rows": display_rows}],
        "audit": {"selected_strength": sel_label, "no_of_doses": no_of_doses,
                  "mdd_mg_day": mdd_mg_day, "doses_per_day": doses,
                  "implied_strength": implied,
                  "strength_selection": sel_reason},
        "warnings": list(strength_warnings),
    }


_QS_QUANTITY_STRINGS = {"", "-", "n/a", "na", "tbd", "q.s", "qs", "q s", "qs to",
                        "q.s.", "qsto", "q s to", "as required", "adjust ph"}
_QS_INGREDIENT_HINTS = ("nitrogen", "n2", "argon", "process aid", "process-aid",
                        "processing aid", "sparging gas")

# The marker alphabet is defined once, in docgen_evidence, and shared by every
# workflow. It used to be declared twice in THIS module with different
# contents: the validator below knew "@" and "$", while the stripper here did
# not. A cell marked with a glyph only one of them recognised was therefore
# detected as carrying a footnote in one place and left with the marker
# embedded in the other - so an ingredient name kept its marker into the
# rendered document, and the note that changed the row's meaning was never
# required. Superscript markers are handled too: NFKC folds a superscript digit
# onto an ordinary digit, so stripping has to happen before normalisation or a
# cell reading "44.5<superscript 1>" silently becomes 44.51.

#: Upper bound on a plausible salt/base molecular-weight ratio. Above this the
#: two numbers are almost certainly in different units, not a real conversion.
SALT_FACTOR_MAX = 4.0


def _strip_footnote_markers(s: str) -> str:
    """Remove footnote markers so the numeric parse succeeds.

    Delegates to :func:`docgen_evidence.strip_note_markers`, which is the one
    implementation shared by every workflow. Non-marker characters are
    preserved.
    """
    if not s:
        return s
    return _EV.strip_note_markers(s)


# RS Bug 2: salt-form APIs carry an asterisk footnote reconciling the formulation
# (salt) weight with the label (free-base) strength, e.g. Trilaciclib 2HCl
# "349 mg dihydrochloride ≡ 300 mg base". The dose multiplier must use the BASE
# weight (432/300 = 1.44), NOT the salt weight (432/349 = 1.238). A different
# asterisk footnote encodes an OVERAGE ("10% overage") and is handled separately
# (multiplier uses the nominal strength). This parser classifies + extracts both.
_SALT_WORDS = (
    "2hcl", "3hcl", "hcl", "dihydrochloride", "trihydrochloride", "hydrochloride",
    "hydrobromide", "hbr", "sulfate", "sulphate", "bisulfate", "hemisulfate",
    "tartrate", "bitartrate", "mesylate", "methanesulfonate", "tosylate",
    "tosilate", "besylate", "besilate", "phosphate", "diphosphate", "maleate",
    "fumarate", "succinate", "acetate", "citrate", "sodium", "potassium",
    "calcium", "magnesium", "hydrate", "monohydrate", "dihydrate", "trihydrate",
    "salt", "tromethamine", "trometamol", "meglumine", "olamine", "diolamine",
    "lysine", "arginine", "choline", "benzathine", "pamoate", "embonate",
    "napsylate", "xinafoate", "valerate", "propionate", "palmitate",
    "decanoate", "enanthate", "dipropionate", "furoate", "lactate",
    "gluconate", "malate", "oxalate", "nitrate", "bromide", "chloride",
    "iodide",
)
_OVERAGE_RE_A = re.compile(r"(\d+(?:\.\d+)?)\s*%\s*(?:w\s*/?\s*w\s*)?over\s*age", re.I)
_OVERAGE_RE_B = re.compile(r"over\s*age\D{0,15}?(\d+(?:\.\d+)?)\s*%", re.I)
# Salt/base footnotes are written in whatever unit the product uses — a
# 250 mcg carboprost base against a 332 mcg tromethamine salt is the same
# statement as Trilaciclib's 300 mg / 349 mg, so every mass unit is recognised
# and normalised to mg before the ratio is taken (the ratio is unit-free).
_MG_NUM_RE = re.compile(r"(\d+(?:\.\d+)?)\s*(mg|mcg|µg|ug|g)\b(?!\s*/)", re.I)
_FOOTNOTE_MASS_TO_MG = {"g": 1000.0, "mg": 1.0, "mcg": 0.001, "µg": 0.001,
                        "ug": 0.001}


def _footnote_mass_mg(m) -> float:
    """A mass match from _MG_NUM_RE, in milligrams."""
    try:
        return float(m.group(1)) * _FOOTNOTE_MASS_TO_MG.get(
            (m.group(2) or "mg").lower(), 1.0)
    except (TypeError, ValueError, IndexError):
        return 0.0
_BASE_CTX_RE = re.compile(r"\b(?:free[\s-]*)?base\b", re.I)


def parse_salt_base_footnote(text: str) -> Optional[Dict]:
    """Classify an asterisk footnote and extract its conversion (RS Bug 2).

    Returns None when nothing salt/base/overage is recognised, else a dict:
      kind='overage'   → {'overage_pct': fraction, 'salt_factor': 1.0}
      kind='salt_base' → {'salt_weight', 'base_weight',
                          'salt_factor'=salt/base (>1), 'overage_pct': 0.0}
    The multiplier is later computed as MDD × salt_factor / api_qty, so a
    free-base MDD applied to a salt formulation weight yields MDD / base_weight
    (Trilaciclib: 432 × (349/300) / 349 = 1.44)."""
    t = _s(text)
    if not t:
        return None
    # Replace footnote markers (*, #, †…) with a space so a glued '349* mg'
    # still parses; '=' and '≡' connectives are preserved (not markers). The
    # marker alphabet is the shared one — this module used to declare its own,
    # and the two drifted until a cell was a footnote reference to one of them
    # and data to the other.
    low = _EV.scrub_note_markers(t).lower()

    # Overage first (distinct footnote content; must not be read as salt/base).
    om = _OVERAGE_RE_A.search(low) or _OVERAGE_RE_B.search(low)
    if om:
        try:
            pct = float(om.group(1))
        except (TypeError, ValueError):
            pct = 0.0
        return {"kind": "overage", "overage_pct": pct / 100.0, "salt_factor": 1.0,
                "salt_weight": None, "base_weight": None, "raw": t}

    has_salt = any(w in low for w in _SALT_WORDS)
    has_base = bool(_BASE_CTX_RE.search(low))
    equiv = bool(re.search(
        r"equivalent|equals?|corresponds?|is\s+equal|provid|deliver|contain|[=≡]",
        low))
    if not (equiv and (has_base or has_salt)):
        return None

    nums = [(_footnote_mass_mg(m), m.start(), m.end())
            for m in _MG_NUM_RE.finditer(low)]
    nums = [n for n in nums if n[0] > 0]
    if len(nums) < 2:
        return None

    # base = the mg-number sitting CLOSEST *before* a "base" token (e.g. the 300
    # in "…= 300 mg base"). Picking the nearest preceding number avoids a greedy
    # window tagging the leading salt weight as the base on short strings.
    base_val = None
    best_gap = 26                      # cap: ignore far-away "base" mentions
    for bm in _BASE_CTX_RE.finditer(low):
        bpos = bm.start()
        for val, _s0, e in nums:
            if e <= bpos and (bpos - e) < best_gap:
                base_val, best_gap = val, (bpos - e)
    salt_val = None
    if base_val is not None:
        others = [v for v, _s0, _e in nums if v != base_val]
        if others:
            salt_val = max(others)     # the salt is the heavier partner
    if base_val is None or salt_val is None:
        # Fallback: two distinct weights → salt is heavier, base is lighter.
        vals = sorted({v for v, _s0, _e in nums}, reverse=True)
        if len(vals) >= 2:
            salt_val, base_val = vals[0], vals[1]

    if not salt_val or not base_val or base_val <= 0 or salt_val < base_val:
        return None
    return {"kind": "salt_base", "salt_weight": salt_val, "base_weight": base_val,
            "salt_factor": round(salt_val / base_val, 6), "overage_pct": 0.0, "raw": t}


_SALT_EQUIV_CUE_RE = re.compile(
    r"equivalent|equals?|corresponds?|as\s+(?:the\s+)?(?:free\s+)?base|"
    r"provid\w*|calculated\s+as|expressed\s+as", re.IGNORECASE)


def _footnote_base_weight(text: str) -> Optional[float]:
    """Extract the free-BASE weight (mg) from a salt/base footnote that may carry
    ONLY the base number — the salt weight then lives in the API Qty cell (the
    common Trilaciclib format: Qty '349*' + footnote '* equivalent to 300 mg
    base'). Returns the base mg value, or None. Requires both a base cue and a
    salt/equivalence cue so plain excipient masses never match."""
    t = _s(text)
    if not t:
        return None
    low = _EV.scrub_note_markers(t).lower()
    if not _BASE_CTX_RE.search(low):
        return None
    if not (_SALT_EQUIV_CUE_RE.search(low) or any(w in low for w in _SALT_WORDS)):
        return None
    nums = [(_footnote_mass_mg(m), m.start(), m.end())
            for m in _MG_NUM_RE.finditer(low)]
    nums = [n for n in nums if n[0] > 0]
    if not nums:
        return None
    # base = the mg-number sitting CLOSEST before a 'base' token.
    base_val = None
    best_gap = 40
    for bm in _BASE_CTX_RE.finditer(low):
        bpos = bm.start()
        for val, _s0, e in nums:
            if e <= bpos and (bpos - e) < best_gap:
                base_val, best_gap = val, (bpos - e)
    if base_val is None:
        # 'base' present but not adjacent to a number → take the value right after
        # an equivalence cue ("equivalent to 300 mg", "as 300 mg").
        m = re.search(r"(?:equivalent to|equals?|as|corresponds? to|provid\w*|"
                      r"calculated as|expressed as)\D{0,14}(\d+(?:\.\d+)?)\s*mg", low)
        if m:
            base_val = float(m.group(1))
    return base_val


_EQUIVALENT_MASS_RE = re.compile(
    r"(?:equivalent\s+to|equiv\.?\s+to|equals?|corresponds?\s+to|expressed\s+as|"
    r"calculated\s+as|[=≡])\s*(?:about\s+|approx\.?\s+|~\s*)?"
    r"(\d+(?:\.\d+)?)\s*(mg|mcg|µg|ug|g)\b", re.IGNORECASE)


def _equivalent_mass_mg(text: str) -> Optional[float]:
    """The mass (mg) a salt/base note says its quantity is equivalent to.

    Only consulted for a note whose category already established it as a
    salt/base equivalence and that is bound to the API row: such a note names
    the base weight whether or not it uses the word "base"
    ("* Equivalent to 40 mg of the active moiety").
    """
    m = _EQUIVALENT_MASS_RE.search(_EV.scrub_note_markers(_s(text)))
    if not m:
        return None
    value = _footnote_mass_mg(m)
    return value if value > 0 else None


def _iter_classified_cells(cls: Dict):
    """Yield every non-empty cell string across a classified Excel (all sheets +
    the chosen sheet's rows/header), so a footnote below the composition table is
    reachable regardless of which sheet it sits on."""
    seen_ids = set()
    def _emit_rows(header, rows):
        for cell in (header or []):
            s = _s(cell)
            if s:
                yield s
        for r in (rows or []):
            for cell in (r or []):
                s = _s(cell)
                if s:
                    yield s
    for sh in (cls.get("sheets") or []):
        if not isinstance(sh, dict):
            continue
        seen_ids.add(id(sh.get("rows")))
        yield from _emit_rows(sh.get("header"), sh.get("rows"))
    # The chosen sheet's rows may be a distinct list (unit/detailed info copy).
    if id(cls.get("rows")) not in seen_ids:
        yield from _emit_rows(cls.get("header"), cls.get("rows"))


def _classified_row_sets(cls: Dict) -> List[Tuple[List, List, str]]:
    """Every (header, rows, label) triple a classified workbook carries."""
    def _seq(value: Any) -> List:
        return list(value) if isinstance(value, (list, tuple)) else []

    out: List[Tuple[List, List, str]] = []
    seen_ids = set()
    sheets = cls.get("sheets")
    for sh in (sheets if isinstance(sheets, (list, tuple)) else ()):
        if not isinstance(sh, dict):
            continue
        seen_ids.add(id(sh.get("rows")))
        out.append((_seq(sh.get("header")), _seq(sh.get("rows")),
                    _s(sh.get("name")) or "sheet"))
    if id(cls.get("rows")) not in seen_ids:
        out.append((_seq(cls.get("header")), _seq(cls.get("rows")), "composition"))
    return out


def find_api_row(cls: Dict, api_component: Optional[str] = None
                 ) -> Tuple[str, Optional[float], Optional[List]]:
    """The API's ``(name, quantity, row)`` in a classified workbook, or blanks.

    The same ladder the composition parser uses: an explicitly named component
    first, then a Function/Role cell reading Active / API / Drug Substance, then
    the first non-q.s. numeric row. Shared so the note stage and the calculation
    agree about which row is the API — a salt/base note that drives the dose
    basis must be the one attached to THAT row and no other.
    """
    header = cls.get("header") or []
    rows = cls.get("rows") or []
    comp_idx = cls.get("comp_idx")
    if comp_idx is None:
        comp_idx = _col_index(header, _COMP_HINTS)
    qty_idx = cls.get("qty_idx")
    if qty_idx is None:
        qty_idx = _col_index(header, _QTY_HINTS)
    if comp_idx is None or qty_idx is None:
        return "", None, None
    func_idx = _col_index(header, ("function", "role", "category"))

    scan: List[Tuple[str, Optional[float], bool, str, List]] = []
    for r in rows:
        if not isinstance(r, (list, tuple)) or comp_idx >= len(r):
            continue
        nm_raw = _s(r[comp_idx])
        if not nm_raw or _is_footer_row(nm_raw):
            continue
        nm = re.sub(r"\s*@\s*$", "", nm_raw).strip()
        raw_q = _s(r[qty_idx]) if qty_idx < len(r) else ""
        isqs = _is_qs_ingredient(nm_raw) or _is_qs_quantity(raw_q)
        q = _num_or_none(_strip_footnote_markers(raw_q)) if not isqs else None
        fv = _s(r[func_idx]) if (func_idx is not None and func_idx < len(r)) else ""
        scan.append((nm, q, isqs, fv, r))

    if api_component:
        for nm, q, isqs, fv, r in scan:
            if q and _rs_norm(nm) == _rs_norm(api_component):
                return nm, q, r
    if func_idx is not None:
        for nm, q, isqs, fv, r in scan:
            if q and _API_FUNC_RE.search(fv):
                return nm, q, r
    for nm, q, isqs, fv, r in scan:
        if (not isqs) and q:
            return nm, q, r
    return "", None, None


def bind_composition_notes(cls: Dict, api_row: Optional[List] = None,
                           api_component: Optional[str] = None) -> Dict:
    """Bind every composition cell to the notes that annotate IT.

    A marker is meaningless without the row it sits on. A salt/base note on the
    API row changes the dose basis; the identical sentence on a preservative row
    ("5.25 mg Chlorobutanol Hemihydrate = 5 mg Chlorobutanol") is a display
    equivalence and changes nothing. A global first-match scan cannot tell those
    apart, and picking whichever the cell iterator reached first is how an
    excipient's conversion became the API's salt factor.

    Returns::

        {"index":        the shared NoteIndex,
         "rows":         [{"row", "name", "is_api", "notes", "categories"}, …],
         "api":          the API row's entry, or None,
         "salt_base":    the API row's salt/base conversion, or None,
         "overage_pct":  the API row's overage as a fraction,
         "qs_rows":      names of rows a q.s. note exempts from the calculation,
         "display_only": salt/base notes bound to a NON-API row,
         "unbound":      notes no row references,
         "notes":        human-readable audit lines}

    Never raises: a workbook whose notes cannot be read is a workbook without
    note enrichment, not a failed generation.
    """
    result: Dict[str, Any] = {"index": None, "rows": [], "api": None,
                              "salt_base": None, "overage_pct": 0.0,
                              "qs_rows": [], "display_only": [], "unbound": [],
                              "notes": []}
    if not isinstance(cls, dict):
        return result
    try:
        cells = list(_iter_classified_cells(cls))
    except Exception:                                   # noqa: BLE001
        logger.debug("[RS notes] cell scan failed", exc_info=True)
        cells = []
    index = build_note_index(cells)
    result["index"] = index

    if api_row is None:
        _n, _q, api_row = find_api_row(cls, api_component)

    referenced: set = set()
    for header, rows, label in _classified_row_sets(cls):
        comp_idx = cls.get("comp_idx")
        if comp_idx is None or comp_idx >= len(header or []):
            comp_idx = _col_index(header, _COMP_HINTS)
        for row_no, row in enumerate(rows or []):
            if not isinstance(row, (list, tuple)):
                continue
            name = ""
            if comp_idx is not None and comp_idx < len(row):
                name = _EV.strip_note_markers(_s(row[comp_idx]))
            if _is_footer_row(name or ""):
                continue
            # A footnote DEFINITION printed under the table is a row of the
            # sheet, not an ingredient. Binding its own marker back to itself
            # would make every note look like a row that the note annotates.
            if any(_EV.is_note_definition(cell) for cell in row):
                continue
            notes: List[Any] = []
            for col_no, cell in enumerate(row):
                text = _s(cell)
                if not text:
                    continue
                column = _s(header[col_no]) if col_no < len(header or []) else ""
                _clean, bound = index.bind(cell, target=(name or f"{label} row "
                                                         f"{row_no + 1}"),
                                           column=column)
                for note in bound:
                    if note not in notes:
                        notes.append(note)
                    referenced.add((note.marker, note.text))
            if not notes:
                continue
            entry = {"row": row, "row_no": row_no, "name": name,
                     "sheet": label, "is_api": api_row is not None and row is api_row,
                     "notes": notes,
                     "categories": sorted({n.category for n in notes})}
            result["rows"].append(entry)
            if entry["is_api"]:
                result["api"] = entry

    # -- route each bound note by CATEGORY to the thing it changes -------------
    for entry in result["rows"]:
        for note in entry["notes"]:
            category = note.category
            if category == "qs":
                if entry["name"] and entry["name"] not in result["qs_rows"]:
                    result["qs_rows"].append(entry["name"])
                continue
            if category == "overage":
                parsed = parse_salt_base_footnote(note.text) or {}
                if entry["is_api"] and parsed.get("kind") == "overage":
                    result["overage_pct"] = float(parsed.get("overage_pct") or 0.0)
                    result["notes"].append(
                        f"overage {result['overage_pct'] * 100:.4g}% bound to the "
                        f"API row ({entry['name'] or 'unnamed'})")
                elif parsed.get("kind") == "overage":
                    result["notes"].append(
                        f"overage note on '{entry['name'] or 'unnamed'}' is that "
                        "row's own; it does not change the API dose basis")
                continue
            if category != "salt_base_equivalence":
                continue
            if not entry["is_api"]:
                result["display_only"].append(
                    {"row": entry["name"], "text": note.text,
                     "marker": note.marker})
                result["notes"].append(
                    f"salt/base note on '{entry['name'] or 'unnamed'}' is a "
                    "display equivalence for that row and is NOT the API salt "
                    "factor")
                continue
            conversion = parse_salt_base_footnote(note.text)
            if conversion and conversion.get("kind") == "salt_base":
                result["salt_base"] = conversion
            else:
                # A note bound to the API quantity that says what it is
                # "equivalent to" names the base weight even when it never says
                # "base" - its category already established the equivalence.
                base_w = (_footnote_base_weight(note.text)
                          or _equivalent_mass_mg(note.text))
                api_qty = _num_or_none(_strip_footnote_markers(
                    _s(_api_quantity_cell(cls, entry["row"]))))
                if base_w and api_qty and 0 < base_w < api_qty:
                    factor = round(api_qty / base_w, 6)
                    if factor <= SALT_FACTOR_MAX:
                        result["salt_base"] = {
                            "kind": "salt_base", "salt_weight": api_qty,
                            "base_weight": base_w, "salt_factor": factor,
                            "overage_pct": 0.0, "raw": note.text,
                            # The salt weight is the API's own quantity cell,
                            # not a number the note printed: it is resolved
                            # against whichever presentation is selected.
                            "salt_weight_source": "api_quantity_cell"}
                    else:
                        result["notes"].append(
                            f"ignoring implausible salt factor {factor:.3f} from "
                            f"{note.text[:60]!r} against API qty {api_qty} — "
                            "check the units")
            if result["salt_base"]:
                result["notes"].append(
                    f"salt/base factor {result['salt_base']['salt_factor']} bound "
                    f"to the API row ({entry['name'] or 'unnamed'})")

    for marker, defs in (index.audit().get("definitions") or {}).items():
        for d in defs:
            if (marker, d.get("text")) not in referenced:
                result["unbound"].append({"marker": marker,
                                          "text": d.get("text", ""),
                                          "category": d.get("category", "")})
    return result


def _api_quantity_cell(cls: Dict, row: Any) -> str:
    """The quantity cell of *row*, using the workbook's own quantity column."""
    header = cls.get("header") or []
    qty_idx = cls.get("qty_idx")
    if qty_idx is None:
        qty_idx = _col_index(header, _QTY_HINTS)
    if qty_idx is None or not isinstance(row, (list, tuple)) or qty_idx >= len(row):
        return ""
    return _s(row[qty_idx])


def detect_salt_base_from_classified(cls: Dict, api_row: Optional[List] = None,
                                     api_component: Optional[str] = None
                                     ) -> Optional[Dict]:
    """The API row's salt/base (or overage) conversion, else None.

    Resolution is ROW-BOUND: the note that changes the dose basis is the one
    whose marker sits on the API row. A salt/base note attached to any other row
    is that row's display equivalence and is never returned here, however
    convincingly it parses — that rule is what keeps a preservative's
    "5.25 mg hemihydrate = 5 mg base" note out of the API's salt factor.

    A note that NO row references is a document-level statement and can still be
    used, but only when the workbook contains exactly one of them: two unbound
    conversions cannot be told apart, and guessing is what this function exists
    to stop. Product-agnostic; never raises.
    """
    if not isinstance(cls, dict):
        return None
    try:
        bound = bind_composition_notes(cls, api_row=api_row,
                                       api_component=api_component)
    except Exception:                                   # noqa: BLE001
        logger.debug("[RS notes] row binding failed", exc_info=True)
        bound = {"salt_base": None, "overage_pct": 0.0, "unbound": [],
                 "display_only": [], "notes": []}
    for line in bound.get("notes") or ():
        logger.info("[RS notes] %s", line)

    if bound.get("salt_base"):
        return bound["salt_base"]

    overage_hit = None
    if bound.get("overage_pct"):
        overage_hit = {"kind": "overage", "overage_pct": float(bound["overage_pct"]),
                       "salt_factor": 1.0, "salt_weight": None,
                       "base_weight": None, "raw": "overage note on the API row"}

    # -- unbound, document-level statements ----------------------------------
    unbound_salt: List[Dict] = []
    unbound_overage: List[Dict] = []
    for note in bound.get("unbound") or ():
        parsed = parse_salt_base_footnote(note.get("text", ""))
        if parsed and parsed.get("kind") == "salt_base":
            unbound_salt.append(parsed)
        elif parsed and parsed.get("kind") == "overage":
            unbound_overage.append(parsed)

    # A workbook whose notes carry no markers at all cannot be row-bound; the
    # conversion is then a statement about the document. One such statement is
    # usable, several are ambiguous.
    if not unbound_salt and not bound.get("rows"):
        loose: List[Dict] = []
        try:
            for cell in _iter_classified_cells(cls):
                low = cell.lower()
                if not (("mg" in low and ("base" in low
                                          or any(w in low for w in _SALT_WORDS)))
                        or "overage" in low):
                    continue
                parsed = parse_salt_base_footnote(cell)
                if parsed and parsed.get("kind") == "salt_base":
                    loose.append(parsed)
                elif parsed and parsed.get("kind") == "overage" and not unbound_overage:
                    unbound_overage.append(parsed)
        except Exception:                               # noqa: BLE001
            logger.debug("[RS notes] loose scan failed", exc_info=True)
        unbound_salt.extend(loose)

    distinct = {round(float(p.get("salt_factor") or 0.0), 6): p
                for p in unbound_salt if p.get("salt_factor")}
    if len(distinct) == 1:
        return next(iter(distinct.values()))
    if len(distinct) > 1:
        logger.warning(
            "[RS notes] %d document-level salt/base conversions and no marker "
            "binding them to a row — none applied; enter the salt factor "
            "explicitly.", len(distinct))

    if overage_hit:
        return overage_hit
    if unbound_overage:
        return unbound_overage[0]

    # Last resort for the common single-number format: a footnote giving ONLY
    # the base weight while the salt weight sits in a marked Qty cell. Only used
    # when nothing above resolved and exactly one base weight is present.
    base_weights: List[float] = []
    try:
        for cell in _iter_classified_cells(cls):
            bw = _footnote_base_weight(cell)
            if bw and bw not in base_weights:
                base_weights.append(bw)
    except Exception:                                   # noqa: BLE001
        logger.debug("[RS notes] base-weight scan failed", exc_info=True)
    if len(base_weights) != 1:
        return None
    base_w = base_weights[0]
    salt_w = None
    try:
        for cell in _iter_classified_cells(cls):
            if _EV.extract_note_markers(cell):
                n = _num_or_none(_strip_footnote_markers(cell))
                if n and n > base_w and (salt_w is None or n > salt_w):
                    salt_w = n
    except Exception:                                   # noqa: BLE001
        logger.debug("[RS notes] salt-weight scan failed", exc_info=True)
    if not salt_w:
        return None
    factor = round(salt_w / base_w, 6)
    if factor > SALT_FACTOR_MAX:
        logger.warning("[RS notes] ignoring implausible salt factor %.3f "
                       "(%s / %s) — check the units.", factor, salt_w, base_w)
        return None
    return {"kind": "salt_base", "salt_weight": salt_w, "base_weight": base_w,
            "salt_factor": factor, "overage_pct": 0.0,
            "raw": f"{salt_w:g} mg salt equivalent to {base_w:g} mg base",
            "salt_weight_source": "marked_quantity_cell"}


# ══════════════════════════════════════════════════════════════════════════════
# RS-RF1: MANDATORY FOOTNOTE VALIDATION
# A quantity cell carrying a footnote marker (e.g. '349*', '1.10#', '5.25†') is
# meaningless without its footnote. These functions surface the marker→footnote
# linkage and BLOCK generation when a marker has NO footnote at all — so a
# salt-form weight is never silently mis-read as a free base (Case A) and an
# overage is never silently dropped (Case B). Product-agnostic; never raises.
# ══════════════════════════════════════════════════════════════════════════════
# The marker alphabet, the marker regexes and the note-category vocabulary all
# live in docgen_evidence and are used from there. This module used to declare
# its own copies; a second copy is how a glyph came to be a footnote reference
# in one function and ordinary data in the next.
_RF1_CATEGORY_OF_NOTE = {"salt_base_equivalence": "A_salt_base",
                         "overage": "B_overage",
                         "qs": "C_qs"}
# What a marked cell has to look like to be a QUANTITY: a number once its
# markers are removed. Anything with words in it is prose, not a quantity.
_MARKED_QTY_RE = re.compile(r"^\s*[+-]?\d[\d\s.,]*\s*$")


def _is_marked_quantity(text: str) -> bool:
    """True when *text* (already stripped of its markers) is a bare number."""
    return bool(_MARKED_QTY_RE.match(_s(text))) and _num_or_none(text) is not None


def build_note_index(cells: Iterable[Any], *,
                     source: str = "composition workbook") -> "_EV.NoteIndex":
    """The shared note index for one composition workbook.

    One index per document, built before any row is read, so a marker means the
    same thing to the footnote validator, the salt/base resolver and the
    exposure maths.
    """
    index = _EV.NoteIndex()
    try:
        index.add_definitions(list(cells or ()), source=source)
    except Exception:                                   # noqa: BLE001
        logger.debug("[RS footnote] definition scan failed", exc_info=True)
    return index


def _rf1_note(note: "_EV.Note") -> Dict:
    """One shared Note rendered in the RF1 report's own vocabulary."""
    category, data = _classify_footnote_text(note.text)
    return {"category": category, "data": data, "text": note.text,
            "marker": note.marker, "note_category": note.category}


def _classify_footnote_text(text: str) -> Tuple[str, Dict]:
    """Classify a footnote's descriptive text into RF1 Category A/B/C/D.

    The conversion numbers come from :func:`parse_salt_base_footnote`; the
    CATEGORY comes from the shared vocabulary, so a sentence classified as an
    overage here is classified as an overage by every other workflow too. A
    note whose kind is recognised but whose numbers cannot be extracted keeps
    its category and carries no data, rather than being demoted to a courtesy
    remark.
    """
    r = parse_salt_base_footnote(text)
    if r and r.get("kind") == "salt_base":
        return "A_salt_base", r
    if r and r.get("kind") == "overage":
        return "B_overage", r
    category = _EV.categorise_note(text)
    if category == "qs":
        return "C_qs", {"is_qs": True}
    return _RF1_CATEGORY_OF_NOTE.get(category, "D_informational"), {}


def parse_composition_footnotes(classified: Dict) -> Dict:
    """Scan a classified Excel for footnote MARKERS on quantity cells and match each
    to its footnote text by marker symbol. Returns marked_quantities, footnotes,
    matched, unmatched_markers and the NoteIndex itself. Never raises.

    Marker detection, definition detection and marker→note resolution are the
    shared :class:`docgen_evidence.NoteIndex`, so a doubled marker (``**``)
    resolves to its own note when one exists and only then falls back to ``*``.
    """
    try:
        cells = list(_iter_classified_cells(classified))
    except Exception:                                   # noqa: BLE001
        logger.debug("[RS footnote] cell scan failed", exc_info=True)
        cells = []
    index = build_note_index(cells)

    marked: List[Dict] = []
    matched: List[Dict] = []
    unmatched: List[Dict] = []
    for cell in cells:
        try:
            text, markers = _EV.split_note_markers(cell)
        except Exception:                               # noqa: BLE001
            continue
        if not markers or not _is_marked_quantity(text):
            continue
        entry = {"value": text, "markers": sorted(set(markers))}
        marked.append(dict(entry))
        _bound, notes = index.bind(cell, target=text, column="quantity")
        if notes:
            entry["footnotes"] = [_rf1_note(n) for n in notes]
            matched.append(entry)
        else:
            unmatched.append(entry)

    footnotes: Dict[str, List[Dict]] = {}
    for marker, defs in (index.audit().get("definitions") or {}).items():
        footnotes[marker] = [{"category": _classify_footnote_text(d["text"])[0],
                              "data": _classify_footnote_text(d["text"])[1],
                              "text": d["text"], "marker": marker,
                              "note_category": d.get("category", "")}
                             for d in defs]
    return {"marked_quantities": marked, "footnotes": footnotes,
            "matched": matched, "unmatched_markers": unmatched,
            "note_index": index, "note_audit": index.audit()}


def validate_excel_footnotes(classified: Dict) -> Dict:
    """RS-RF1 footnote inspection — WARNING-ONLY, never blocks generation.

    A quantity marker (*, #, $, @) with no matching footnote text is logged and
    nothing more: the pipeline must never block on missing metadata. When a
    salt/base footnote IS present and parseable it is returned so the caller can
    auto-populate salt_factor / base_qty; when it is absent the caller falls back
    to salt_factor = 1.0 and the math is the submitting scientist's
    responsibility (e.g. Epinephrine's 1.10* overage and 5.25# preservative note
    are correct via volume-based dosing and must not be blocked).

    Returns {salt_base_detected, matched_entries, footnotes}. Never raises.
    """
    try:
        parsed = parse_composition_footnotes(classified)
    except Exception:
        logger.exception("[RS footnote] parse failed — proceeding without footnotes")
        parsed = {"marked_quantities": [], "footnotes": {}, "matched": [],
                  "unmatched_markers": []}

    try:
        salt_base_detected = detect_salt_base_from_classified(classified)
    except Exception:
        logger.exception("[RS footnote] salt/base detection failed")
        salt_base_detected = None

    # Unresolved markers: log only. A recognised salt/base or overage footnote
    # anywhere in the sheet already covers a marked cell.
    for um in parsed.get("unmatched_markers", []):
        if salt_base_detected:
            continue
        mk = "".join(um.get("markers", []))
        logger.warning(
            "[RS footnote] Quantity '%s%s' carries a footnote marker but no "
            "matching footnote text was found. Proceeding with salt_factor=1.0 — "
            "verify the salt/base or overage math for this component.",
            um.get("value", ""), mk)

    for mm in parsed.get("matched", []):
        for fn in mm.get("footnotes", []):
            if fn.get("category") == "D_informational" and any(
                    w in _s(fn.get("text")).lower()
                    for w in ("equivalent", "overage", "base")):
                logger.warning(
                    "[RS footnote] Footnote '%s' resembles a salt/base or overage "
                    "note but could not be parsed — verify its format.",
                    _s(fn.get("text"))[:60])

    return {
        "salt_base_detected": salt_base_detected,
        "matched_entries": parsed.get("matched", []),
        "footnotes": parsed,
    }


def merge_rs_evidence(cluster: Dict) -> Dict:
    """Cluster evidence merge (RS side): union of solvent entries across every
    annexure documenting the SAME material (dedup by name+raw_text+value), best
    material/code/supplier/spec via the shared pickers, and a negative declaration
    ONLY when no positive solvent exists. A size-1 cluster returns that single
    annexure's evidence unchanged (RS baselines untouched). Never raises."""
    try:
        import annexure_identity_clustering as _AC
    except Exception:
        _AC = None
    anns = [a for a in (cluster.get("annexures") or []) if isinstance(a, dict)]
    solvents: List[Dict] = []
    seen = set()
    neg = False
    for a in anns:
        for sv in (a.get("solvents") or []):
            if not isinstance(sv, dict):
                continue
            key = (_s(sv.get("solvent_name")).lower(),
                   _s(sv.get("raw_text")).lower(), _s(sv.get("raw_value")))
            if key in seen:
                continue
            seen.add(key)
            solvents.append(sv)
        if a.get("negative_declaration"):
            neg = True
    positives = [s for s in solvents
                 if _s(s.get("raw_value")) or _s(s.get("converted_ppm"))]
    pick = (lambda ks: _AC._first_field(cluster, ks)) if _AC else (lambda ks: "")
    return {
        "material_name": cluster.get("canonical_name", ""),
        "material_code": (_AC._pick_best_material_code(cluster) if _AC else ""),
        "supplier": (_AC._pick_best_vendor(cluster) if _AC else ""),
        "drl_spec_no": (_AC._pick_best_specification_no(cluster) if _AC else ""),
        "solvents": solvents,
        "negative_declaration": bool(neg and not positives),
    }


def _is_qs_ingredient(name: str) -> bool:
    """Return True when the ingredient name signals q.s. handling.
    Product-agnostic: '@' suffix, gases, process aids."""
    s = _s(name).lower().strip()
    if not s:
        return False
    if s.endswith("@") or s.rstrip().endswith("@"):
        return True
    for hint in _QS_INGREDIENT_HINTS:
        if hint in s:
            return True
    return False


def _is_qs_quantity(cell_value: str) -> bool:
    """Enhanced q.s. quantity detection. Handles textual markers and any value
    that cannot be numerically parsed after footnote stripping."""
    if cell_value is None:
        return True
    s = _s(cell_value).lower().strip()
    if not s:
        return True
    s_norm = re.sub(r"[^a-z0-9 ]+", "", s).strip()
    if s_norm in _QS_QUANTITY_STRINGS or s in _QS_QUANTITY_STRINGS:
        return True
    if _is_qs_value(s):
        return True
    # If numeric extraction after footnote stripping fails, treat as q.s.
    cleaned = _strip_footnote_markers(_s(cell_value))
    if _num_or_none(cleaned) is None:
        # If the raw cell has NO digits at all, it's q.s.-like text
        if not re.search(r"\d", cleaned):
            return True
    return False


_API_FUNC_RE = re.compile(r"active|drug\s+substance|\bapi\b|a\.?p\.?i\.?",
                          re.IGNORECASE)
_DOSAGE_BY_BASIS = {
    # RS Bug 6a: a mg/mL basis defaults to "Injection" (user may override to an
    # oral solution/suspension in the UI).
    "vial": "Sterile Injection", "ml": "Injection",
    "tablet": "Tablet", "capsule": "Capsule", "sachet": "Oral Suspension",
    "dose": "", "unit": "",
}


# ══════════════════════════════════════════════════════════════════════════════
# RS-RF2: DENSITY AUTO-ESTIMATION (liquid drug products)
# Approximate a liquid drug-product density (g/mL) from composition so the UI can
# pre-fill an OPTIONAL, overridable density field. Product-agnostic; never blocks.
# ══════════════════════════════════════════════════════════════════════════════
def estimate_density_from_composition(components: List[Dict]) -> float:
    """density ≈ 1.000 + solids_g_per_mL × 0.65, where solids_g_per_mL sums the
    per-mL mass (mg/mL ÷ 1000) of every non-q.s. component. Adjustments: >30% w/v
    sugar → 0.75 factor; >15% w/v alcohol → −0.05; emulsion → cap 1.02; >50% solids
    → cap 1.35. Clamped to [0.90, 1.35]. Each component: {name, mg_per_ml, is_qs}.
    (Epinephrine: 14.35 mg/mL solids → 1.000 + 0.01435×0.65 ≈ 1.009.)
    Exact arithmetic, rounded once to 3 places."""
    solids_mg = alcohol_mg = sugar_mg = _EV.DECIMAL_ZERO
    emulsion = False
    for c in components or []:
        if not isinstance(c, dict) or c.get("is_qs") or c.get("_is_qs"):
            continue
        mg = _EV.dec_or_none(c.get("mg_per_ml", c.get("qty_per_unit")))
        if mg is None or mg <= 0:
            continue
        solids_mg = solids_mg + mg
        name = str(c.get("component") or c.get("name") or "").lower()
        if any(k in name for k in ("alcohol", "ethanol", "propylene glycol",
                                   "glycerin", "glycerol")):
            alcohol_mg = alcohol_mg + mg
        if any(k in name for k in ("sucrose", "sugar", "sorbitol", "syrup",
                                   "dextrose", "fructose", "maltitol")):
            sugar_mg = sugar_mg + mg
        if any(k in name for k in ("oil", "lipid", "lecithin", "emulsion",
                                   "triglyceride")):
            emulsion = True
    solids_g = _DIV(solids_mg, 1000)
    factor = (Decimal("0.75") if _DIV(sugar_mg, 1000) > Decimal("0.30")
              else Decimal("0.65"))
    density = _EV.DECIMAL_ONE + _MUL(solids_g, factor)
    if _DIV(alcohol_mg, 1000) > Decimal("0.15"):
        density = density - Decimal("0.05")
    if emulsion:
        density = min(density, Decimal("1.02"))
    if solids_g > Decimal("0.50"):
        density = min(density, Decimal("1.35"))
    density = max(Decimal("0.90"), min(density, Decimal("1.35")))
    return _FLOAT(_ROUND(density, 3), 1.0)


# A dilute aqueous composition is taken at 1.0 g/mL - the density of its vehicle
# - when its estimate lies this close to it; the estimate is recorded beside it.
AQUEOUS_DENSITY_TOLERANCE = Decimal("0.02")
# No solution holds more than this per mL. A larger "quantity" is an identifier
# (a material code) or a mis-read cell, never a solid in solution.
_MAX_PLAUSIBLE_MG_PER_ML = Decimal("2000")
_WATER_VEHICLE_RE = re.compile(r"\bwater\b|\bw\.?f\.?i\b|\baqua\b", re.IGNORECASE)


def _is_identifier_column(label: Any) -> bool:
    """True when a header names an identifier column - a material / SAP code or
    a serial number - whose digits are never a quantity."""
    try:
        return COLS.classify_header(label) in ("code", "serial")
    except Exception:                                           # noqa: BLE001
        return bool(re.search(r"\bcode\b|\bs\.?\s*no\b|\bsr\.?\s*no\b",
                              _s(label), re.IGNORECASE))


def _plausible_per_ml_quantity(cell: Any) -> Optional[Decimal]:
    """A cell's per-mL quantity, or None when the cell cannot be one.

    A six-or-more-digit integer with no decimal point is an identifier - a
    material code reads 100012580 - and a value above any concentration a
    solution can hold is a mis-read; neither is a solid in solution.
    """
    raw = _strip_footnote_markers(_s(cell))
    if not raw or re.fullmatch(r"\s*\d{6,}\s*", raw):
        return None
    n = _num_or_none(raw)
    if n is None:
        return None
    value = _D(n)
    if value <= 0 or value > _MAX_PLAUSIBLE_MG_PER_ML:
        return None
    return value


def _is_aqueous_composition(classified: Dict) -> bool:
    """True when the composition's vehicle is water."""
    comp_idx = classified.get("comp_idx") if isinstance(classified, dict) else None
    for r in (classified.get("rows") or []) if isinstance(classified, dict) else ():
        if (isinstance(r, (list, tuple)) and comp_idx is not None
                and comp_idx < len(r) and _WATER_VEHICLE_RE.search(_s(r[comp_idx]))):
            return True
    return False


def estimate_density_from_classified(classified: Dict) -> float:
    """Light-touch composition extraction from a classified Excel → density
    estimate. Defensive: returns 1.0 on any doubt (the value is overridable).

    Only a QUANTITY can be a solid in solution. The workbook's own quantity
    column is read when the classification found one; otherwise the largest
    plausible per-mL number in the row, never from an identifier column.
    Reading the material-code column as mg/mL summed 100012580 into the solids
    and capped every dilute injection at 1.35 g/mL.
    """
    comps: List[Dict] = []
    try:
        header = [_s(h) for h in (classified.get("header") or [])]
        skip = {i for i, h in enumerate(header) if h and _is_identifier_column(h)}
        comp_idx = classified.get("comp_idx")
        qty_idx = classified.get("qty_idx")
        if qty_idx is not None and qty_idx in skip:
            qty_idx = None
        for r in (classified.get("rows") or []):
            if not isinstance(r, (list, tuple)):
                continue
            name = (_s(r[comp_idx]) if comp_idx is not None and comp_idx < len(r)
                    else "")
            if not name:
                for ci, cell in enumerate(r):
                    s = _s(cell)
                    if (ci not in skip and s and re.search(r"[A-Za-z]", s)
                            and not re.search(r"\d", s)):
                        name = s
                        break
            if (not name or _EV.is_note_definition(name) or _is_footer_row(name)
                    or _is_qs_ingredient(name)):
                continue
            if qty_idx is not None:
                mg = (_plausible_per_ml_quantity(r[qty_idx])
                      if qty_idx < len(r) else None)
            else:
                values = [_plausible_per_ml_quantity(cell)
                          for ci, cell in enumerate(r)
                          if ci not in skip and ci != comp_idx]
                values = [v for v in values if v is not None]
                mg = max(values) if values else None
            if mg is not None:
                comps.append({"name": name, "mg_per_ml": mg, "is_qs": False})
    except Exception:
        return 1.0
    return estimate_density_from_composition(comps) if comps else 1.0


def parse_single_strength_unit_composition(classified: Dict,
                                           mdd_mg_day: Optional[float] = None,
                                           unit_basis: Optional[str] = None,
                                           salt_factor: float = 1.0,
                                           density_g_per_ml: float = 1.0,
                                           api_component: Optional[str] = None,
                                           no_of_doses: Optional[int] = None,
                                           dose_volume_ml: Optional[float] = None,
                                           overage_pct: float = 0.0,
                                           mdd_value: Optional[float] = None,
                                           mdd_unit: str = "mg",
                                           doses_per_day: int = 1) -> Dict:
    """Single-strength unit composition parser (RS RF1).

    Composition has ONE quantity column with a unit basis (mg/vial, mg/mL,
    mg/tablet, mg/sachet, mg/dose). The API row is auto-detected (its
    Function/Role cell reads Active / API / Drug Substance, else the first
    non-q.s. numeric row) and its per-unit quantity yields the dose multiplier.

    Solids (mg/vial, mg/tablet, …): the user supplies the API's Maximum Daily
    Dose (MDD, mg/day) and

        multiplier               = MDD_mg_day × salt_factor / api_qty_per_unit

    Volume-dosed liquids (mg/mL basis — RS Bug 1): the user supplies the daily
    dose VOLUME (mL/day) and the multiplier IS that volume directly — it is not
    derived from MDD ÷ strength, so a formulation strength that bakes in an API
    overage (e.g. 1.1 mg/mL for a 1 mg/mL label with 10% overage) does not skew
    the dose. In both cases:

        amount_in_maximum_dose_mg[i] = quantity_per_unit[i] × multiplier

    overage_pct (0.0 = none) only affects the DISPLAYED label strength (RS Bug
    6b): effective strength = api_qty / (1 + overage_pct); component amounts keep
    using the formulation strength as printed in the composition.

    salt_factor (default 1.0) reconciles a salt composition with a free-base MDD
    label. Drug-product mass: liquids use multiplier × 1000 × density (no summing
    of dissolved solids); solids sum the non-q.s. component amounts. A legacy
    no_of_doses path is retained only when MDD/volume are not supplied.
    """
    header = classified["header"]
    rows = classified["rows"]
    comp_idx = classified.get("comp_idx")
    qty_idx = classified.get("qty_idx")
    if qty_idx is None:
        qty_idx = _col_index(header, _QTY_HINTS)
    unit_basis = unit_basis or classified.get("unit_basis") or "unit"
    # Exact inside, float only at the boundary. A caller's salt factor or
    # overage always wins; one the composition's own notes state is applied
    # only where the caller left the neutral default (the note stage below).
    _caller_salt = _D(salt_factor) if salt_factor else _EV.DECIMAL_ONE
    if _caller_salt <= 0:
        _caller_salt = _EV.DECIMAL_ONE
    salt_factor = _FLOAT(_caller_salt, 1.0)
    density_g_per_ml = float(density_g_per_ml) if density_g_per_ml else 1.0
    _overage = _D(overage_pct) if overage_pct else _EV.DECIMAL_ZERO
    overage_pct = _FLOAT(_overage)
    dose_volume_ml = float(dose_volume_ml) if dose_volume_ml else None
    is_liquid = unit_basis == "ml"

    if comp_idx is None or qty_idx is None:
        return {"mode": "single_strength_unit_composition", "rows": [],
                "needs_dose_basis": True,
                "error": "missing component or quantity column"}

    # ── Part 2: MULTI-COLUMN composition — detect every quantity column ───────
    # A composition may carry several presentations side by side ("Qty./1mL" and
    # "Qty./2mL", "Quantity per mL" and "Quantity per 1mL"). Exactly ONE of them
    # feeds the maths; the rest stay in Table 1 for display. Columns holding
    # identical values are one presentation written twice and are collapsed, so
    # a duplicated header can never double-count.
    strength_columns = DOSE.detect_quantity_columns(header)
    dose_warnings: List[str] = []
    column_choice: Dict[str, Any] = {}
    if len(strength_columns) > 1:
        values_by_index = {
            c["index"]: [_s(r[c["index"]]) if c["index"] < len(r) else ""
                         for r in rows]
            for c in strength_columns}
        strength_columns, dedup_notes = DOSE.dedup_identical_columns(
            strength_columns, values_by_index)
        dose_warnings.extend(dedup_notes)

    # Optional display columns
    matcode_idx = _col_index(header, ("material code", "mat code", "material_code",
                                      "sap code", "sap_code"))
    func_idx = _col_index(header, ("function", "role", "category"))
    stage_idx = _col_index(header, _STAGE_HINTS)
    compendia_idx = _col_index(header, _COMPENDIA_HINTS)

    comp_label = header[comp_idx]

    def _build_display_columns() -> List[str]:
        """Table 1 shows the composition as uploaded — including EVERY strength
        column, exactly as an approved document does. Only the calculation is
        restricted to the one selected column."""
        cols: List[str] = []
        if matcode_idx is not None:
            cols.append(header[matcode_idx])
        cols.append(comp_label)
        if func_idx is not None:
            cols.append(header[func_idx])
        if compendia_idx is not None:
            cols.append(header[compendia_idx])
        qty_cols = [c["label"] for c in strength_columns] or [header[qty_idx]]
        if header[qty_idx] not in qty_cols:
            qty_cols.insert(0, header[qty_idx])
        cols.extend(qty_cols)
        if stage_idx is not None:
            cols.append(header[stage_idx])
        return cols

    # ── Pre-scan: locate the API row + its per-unit quantity ──────────────────
    def _prescan(col_idx: int) -> List[Tuple[str, Optional[float], bool, str, List]]:
        out: List[Tuple[str, Optional[float], bool, str, List]] = []
        for r in rows:
            if comp_idx >= len(r):
                continue
            nm_raw = _s(r[comp_idx])
            if (not nm_raw or _is_footer_row(nm_raw)
                    or _EV.is_note_definition(nm_raw)):
                continue
            # Every footnote mark off the name ('@', '*', ...), not only '@':
            # the API name is printed in the strength label and its note.
            nm = (_EV.strip_note_markers(nm_raw)
                  or re.sub(r"\s*@\s*$", "", nm_raw).strip())
            raw_q = _s(r[col_idx]) if col_idx < len(r) else ""
            isqs = _is_qs_ingredient(nm_raw) or _is_qs_quantity(raw_q)
            q = _num_or_none(_strip_footnote_markers(raw_q)) if not isqs else None
            fv = _s(r[func_idx]) if (func_idx is not None and func_idx < len(r)) else ""
            out.append((nm, q, isqs, fv, r))
        return out

    def _find_api(scan) -> Tuple[str, Optional[float], Optional[List]]:
        if api_component:                   # explicit user/caller choice
            for nm, q, isqs, fv, r in scan:
                if q and _rs_norm(nm) == _rs_norm(api_component):
                    return nm, q, r
        if func_idx is not None:            # Function/Role = Active/API
            for nm, q, isqs, fv, r in scan:
                if q and _API_FUNC_RE.search(fv):
                    return nm, q, r
        for nm, q, isqs, fv, r in scan:     # fallback: first non-q.s. numeric row
            if (not isqs) and q:
                return nm, q, r
        return "", None, None

    prescan = _prescan(qty_idx)
    api_name, api_qty, api_row = _find_api(prescan)

    # ── The composition's own notes, bound to the rows they annotate ─────────
    # Resolved BEFORE the presentation is chosen: a salt-form API quantity can
    # only be compared with the regimen once it is expressed on the free base,
    # and a formulation strength only once its overage is backed out. A note on
    # the API row changes the dose basis; the identical sentence on any other
    # row ("5.25 mg X Hemihydrate = 5 mg X") is that row's display equivalence.
    # Notes are ENRICHMENT on top of what the caller supplied - present, absent
    # or unparseable, the workbook still generates on the caller's values.
    salt_note_warnings: List[str] = []
    salt_auto_applied = False
    bound_notes: Dict[str, Any] = {}
    try:
        bound_notes = bind_composition_notes(classified, api_row=api_row,
                                             api_component=api_component) or {}
    except Exception:                                       # noqa: BLE001
        logger.debug("[RS] composition note binding skipped", exc_info=True)
    note_qs_rows = {_rs_norm(n) for n in (bound_notes.get("qs_rows") or []) if n}
    if _overage <= 0 and bound_notes.get("overage_pct"):
        _overage = _D(bound_notes.get("overage_pct"))
        overage_pct = _FLOAT(_overage)
    # The salt/base conversion as an exact FRACTION (salt weight, base weight):
    # 349 mg salt ≡ 300 mg base makes a 432 mg base MDD exactly 1.44 units per
    # day, which a factor rounded to 1.163333 never does.
    _salt_fraction: Optional[Tuple[Decimal, Decimal]] = None
    _salt_base_only: Optional[Decimal] = None
    if _caller_salt != _EV.DECIMAL_ONE:
        _salt_fraction = (_caller_salt, _EV.DECIMAL_ONE)
    else:
        _conv = bound_notes.get("salt_base")
        if not _conv:
            try:
                _detected = detect_salt_base_from_classified(
                    classified, api_row=api_row, api_component=api_component)
            except Exception:                               # noqa: BLE001
                logger.debug("[RS] salt/base footnote resolution skipped",
                             exc_info=True)
                _detected = None
            if _detected and _detected.get("kind") == "salt_base":
                _conv = _detected
            elif (_detected and _detected.get("kind") == "overage"
                  and _overage <= 0):
                _overage = _D(_detected.get("overage_pct"))
                overage_pct = _FLOAT(_overage)
        if _conv:
            _sw = _EV.dec_or_none(_conv.get("salt_weight"))
            _bw = _EV.dec_or_none(_conv.get("base_weight"))
            _sf = _EV.dec_or_none(_conv.get("salt_factor"))
            _weights_from_cell = _s(_conv.get("salt_weight_source")) in (
                "api_quantity_cell", "marked_quantity_cell")
            if _bw and _bw > 0 and (_weights_from_cell or not _sw):
                # Only the base weight is the note's own: the salt weight is the
                # quantity of whichever presentation is selected.
                _salt_base_only = _bw
            elif _sw and _bw and 0 < _bw < _sw:
                if _DIV(_sw, _bw) > _D(SALT_FACTOR_MAX):
                    salt_note_warnings.append(
                        f"Ignored an implausible salt factor "
                        f"{_EV.format_decimal(_ROUND(_DIV(_sw, _bw), 3))} from a "
                        "footnote — check the units.")
                else:
                    _salt_fraction = (_sw, _bw)
                    salt_auto_applied = True
            elif _sf and _EV.DECIMAL_ONE < _sf <= _D(SALT_FACTOR_MAX):
                _salt_fraction = (_sf, _EV.DECIMAL_ONE)
                salt_auto_applied = True
    for _line in bound_notes.get("display_only") or ():
        salt_note_warnings.append(
            f"Salt/base note on '{_line.get('row') or 'a component'}' is "
            "a display equivalence for that row; it was not applied to "
            "the API dose basis.")

    def _label_quantity(qty: Any) -> Decimal:
        """An API quantity on the LABEL basis: salt form and overage removed."""
        num, den = _salt_fraction or (_EV.DECIMAL_ONE, _EV.DECIMAL_ONE)
        return _DIV(_MUL(qty, den), _MUL(num, _EV.DECIMAL_ONE + _overage))

    # ── Part 2/3: select exactly ONE presentation column ─────────────────────
    # The column is DERIVED from the regimen (implied strength = MDD ÷ doses),
    # never forced to the maximum and never summed across columns. When nothing
    # matches, the highest drug-product mass per day is used as the documented
    # worst case and a warning records the choice. Each column's API quantity is
    # compared on the LABEL basis: a salt weight read as if it were the labelled
    # strength matched nothing, fell through to MDD ÷ salt weight and put every
    # component amount ~10 % low.
    _doses = max(1, int(doses_per_day or 1))
    _mdd_for_strength = (float(mdd_value) if mdd_value
                         else float(mdd_mg_day) if mdd_mg_day else 0.0)
    _implied = DOSE.implied_strength(_mdd_for_strength, _doses)
    if len(strength_columns) > 1 and api_row is not None:
        api_qty_by_index: Dict[int, float] = {}
        mass_by_index: Dict[int, float] = {}
        for c in strength_columns:
            ci = c["index"]
            aq = _num_or_none(_strip_footnote_markers(
                _s(api_row[ci]))) if ci < len(api_row) else None
            api_qty_by_index[ci] = _FLOAT(_label_quantity(aq)) if aq else 0.0
            mass_by_index[ci] = _FLOAT(_SUM(
                q for (_n, q, _qs, _fv, _r) in _prescan(ci) if q))
        # A volume-dosed liquid presents CONCENTRATIONS, not per-dose strengths
        # ("25 mg/1 mL" and "50 mg/2 mL" are one product) — those are compared
        # per-mL. Everything else compares against the implied per-dose strength.
        _vol_cols = [c for c in strength_columns if (c.get("volume_ml") or 0) > 0]
        if is_liquid and len(_vol_cols) == len(strength_columns):
            column_choice = DOSE.select_volume_basis_column(
                strength_columns, api_qty_by_index)
        else:
            column_choice = DOSE.select_strength_column(
                strength_columns, api_qty_by_index, _implied,
                mass_by_index=mass_by_index)
        dose_warnings.extend(column_choice.get("warnings") or [])
        chosen = column_choice.get("column")
        if chosen and chosen["index"] != qty_idx:
            qty_idx = chosen["index"]
            prescan = _prescan(qty_idx)
            api_name, api_qty, api_row = _find_api(prescan)
        logger.info("[RS] strength column '%s' selected (%s)",
                    (chosen or {}).get("label", "?"),
                    column_choice.get("reason", ""))

    qty_label = header[qty_idx]
    display_columns = _build_display_columns()

    # RS Bug 2: a footnote giving ONLY the base weight ("* equivalent to 300 mg
    # base") while the salt weight (349) is the API's own Qty cell resolves
    # against the SELECTED presentation's API quantity, which is known only now.
    # Without it the multiplier used the salt weight (432/349 = 1.238, not 1.44).
    # A salt/base ratio is a molecular-weight ratio, between 1 and about 4;
    # anything larger means the note and the Qty cell are in different units, so
    # it is reported rather than applied.
    if (_salt_fraction is None and _salt_base_only is not None
            and api_qty and 0 < _salt_base_only < _D(api_qty)):
        _cand = _DIV(api_qty, _salt_base_only)
        if _cand > _D(SALT_FACTOR_MAX):
            salt_note_warnings.append(
                f"Ignored an implausible salt factor "
                f"{_EV.format_decimal(_ROUND(_cand, 3))} derived from a footnote "
                f"against the API quantity {api_qty} — check the units.")
        else:
            _salt_fraction = (_D(api_qty), _salt_base_only)
            salt_auto_applied = True
    _salt_num, _salt_den = _salt_fraction or (_EV.DECIMAL_ONE, _EV.DECIMAL_ONE)
    salt_factor = _FLOAT(_ROUND(_DIV(_salt_num, _salt_den), 6), 1.0)
    if salt_note_warnings:
        dose_warnings.extend(salt_note_warnings)

    # ── Dose multiplier ───────────────────────────────────────────────────────
    # Volume-dosed liquids (RS Bug 1): the daily dose is a VOLUME (mL/day); the
    # multiplier IS that volume — never MDD ÷ strength — so an API overage baked
    # into the mg/mL strength does not inflate it.
    # Solids (RF2): multiplier = MDD × salt × (1 + overage) / api_qty. When the
    # solid strength is inclusive of a manufacturing overage, the number of units
    # per day = MDD_label ÷ effective_strength = MDD ÷ (api_qty / (1+overage)).
    # overage_pct = 0 (default) leaves the classic MDD ÷ api_qty behaviour intact
    # (no regression for Esomeprazole / Trilaciclib).
    #
    # Part 3 — the daily dose is DERIVED from the MDD and its unit, never
    # reconciled by the user:
    #   mdd_unit == mL      -> daily volume = MDD                    (direct)
    #   mdd_unit == mg|g|mcg-> daily volume = MDD ÷ API mg/mL
    #   mdd_unit == units|IU-> daily volume = MDD ÷ API units/mL
    # A per-2mL column is normalised to per-mL first, so "25 mg/1 mL" and
    # "50 mg/2 mL" are recognised as the SAME concentration and give the same
    # answer whichever column was selected.
    #
    # For a SOLID the multiplier is the number of units taken per day. When the
    # regimen's implied strength (MDD ÷ doses) genuinely matches the selected
    # column's API quantity, that count IS doses_per_day; otherwise the classic
    # MDD ÷ api_qty derivation stands (this is what keeps a salt-basis product
    # such as Trilaciclib — MDD 432 mg base vs 349 mg salt per unit — exact).
    # Only a MULTI-column sheet needs per-mL normalisation: it is the presence of
    # a sibling column on a different volume basis ("Qty./1mL" next to "Qty./2mL")
    # that makes the basis ambiguous. A single-column sheet keeps its existing,
    # verified behaviour untouched (multiplier IS the daily volume).
    _col_volume_ml = _D(column_choice.get("column", {}).get("volume_ml")
                        if column_choice.get("column") else 1, 1)
    if _col_volume_ml <= 0:
        _col_volume_ml = _EV.DECIMAL_ONE

    _api_per_ml = _DIV(api_qty, _col_volume_ml) if api_qty else _EV.DECIMAL_ZERO
    # The daily VOLUME derives from the LABEL concentration: the formulation
    # strength with its overage and its salt form backed out. 1.1 mg/mL made
    # with a 10 % overage is a 1 mg/mL label, so an 8 mg MDD is 8 mL - not the
    # 7.27 mL that dividing by the formulation strength gave. Component amounts
    # below keep the formulation weights; only this derivation backs them out.
    _label_per_ml = (_label_quantity(_api_per_ml) if _api_per_ml > 0
                     else _EV.DECIMAL_ZERO)
    # An activity dose is not salt-corrected; its overage still comes out.
    _label_units_per_ml = _DIV(_api_per_ml, _EV.DECIMAL_ONE + _overage)
    _derived_volume = None
    _derived_exact: Optional[Decimal] = None
    if is_liquid and not (dose_volume_ml and dose_volume_ml > 0) and _mdd_for_strength > 0:
        _is_activity = DOSE.is_activity_unit(mdd_unit)
        _derived_volume, _vol_basis, _vol_warn = DOSE.derive_daily_volume_ml(
            _mdd_for_strength, mdd_unit,
            api_conc_mg_per_ml=(None if _is_activity else _label_per_ml),
            api_units_per_ml=(_label_units_per_ml if _is_activity else None))
        dose_warnings.extend(_vol_warn)
        # The same derivation, exactly: the float above is only its boundary.
        if _derived_volume:
            _mdd_mg_exact = DOSE.mdd_as_mg_exact(_mdd_for_strength, mdd_unit)
            if (_vol_basis == "mdd_mg_over_mg_per_ml" and _label_per_ml > 0
                    and _mdd_mg_exact is not None):
                _derived_exact = _DIV(_mdd_mg_exact, _label_per_ml)
            elif (_vol_basis == "mdd_units_over_units_per_ml"
                  and _label_units_per_ml > 0):
                _derived_exact = _DIV(_mdd_for_strength, _label_units_per_ml)
            else:
                _derived_exact = _D(_derived_volume)

    _implied_d = _D(_implied)
    _api_label_qty = _label_quantity(api_qty) if api_qty else _EV.DECIMAL_ZERO
    _strength_matched = bool(
        api_qty and _implied_d > 0
        and _DIV(abs(_api_label_qty - _implied_d), _implied_d, default=1)
        <= _D(DOSE.STRENGTH_MATCH_TOLERANCE))

    # The multiplier is a ratio of decimal quantities and every component amount
    # is multiplied by it, so it is exact: a binary residue here is multiplied
    # into every row of the table.
    if is_liquid and dose_volume_ml and dose_volume_ml > 0:
        multiplier = _DIV(dose_volume_ml, _col_volume_ml)
        mult_basis = "dose_volume_ml"
    elif is_liquid and _derived_exact and _derived_exact > 0:
        multiplier = _DIV(_derived_exact, _col_volume_ml)
        mult_basis = "daily_volume_from_mdd"
        dose_volume_ml = _FLOAT(_ROUND(_derived_exact, 6))
    elif _strength_matched and _doses >= 1:
        multiplier = _D(_doses)
        mult_basis = "doses_per_day_at_matched_strength"
    elif mdd_mg_day and api_qty and api_qty > 0:
        # MDD × (salt weight ÷ base weight) × (1 + overage) ÷ API quantity, as
        # ONE division of exact products.
        multiplier = _DIV(_MUL(mdd_mg_day, _salt_num, _EV.DECIMAL_ONE + _overage),
                          _MUL(_salt_den, api_qty))
        mult_basis = "mdd_over_api_qty"
    elif no_of_doses:
        multiplier = _D(no_of_doses)
        mult_basis = "no_of_doses_legacy"
    else:
        multiplier = _EV.DECIMAL_ONE
        mult_basis = "default_multiplier_1"

    comp_rows: List[Dict] = []
    display_rows: List[Dict] = []
    for r in rows:
        if comp_idx >= len(r):
            continue
        name_raw = _s(r[comp_idx])
        if not name_raw:
            continue
        # Skip Total / Drug Product / Limit footer rows, and a footnote
        # DEFINITION printed in the ingredient column ("* 10% overage"): a
        # note about a row is never an ingredient of its own.
        if _is_footer_row(name_raw) or _EV.is_note_definition(name_raw):
            continue

        # display name: strip the footnote marks ('@', '*', ...) so the report
        # reads cleanly; the marks' meaning was bound to this row above.
        name = (_EV.strip_note_markers(name_raw)
                or re.sub(r"\s*@\s*$", "", name_raw).strip())

        # q.s. determination — name/quantity/ingredient hints, and a q.s. / pH
        # adjustment note bound to THIS row ("1N HCl used for pH adjustment").
        raw_qty_cell = _s(r[qty_idx]) if qty_idx < len(r) else ""
        # RS-6 — no quantity at the selected presentation but one at another:
        # a per-strength variant. Shown in Table 1, never calculated.
        _absent = len(strength_columns) > 1 and _rs_absent_at_strength(
            raw_qty_cell, [_s(r[c["index"]]) if c["index"] < len(r) else ""
                           for c in strength_columns if c["index"] != qty_idx])
        if _absent:
            dose_warnings.append(
                f"'{name}' states no quantity in the selected column "
                f"'{header[qty_idx]}', so it is not part of that presentation's "
                "formulation; it is shown in the composition table only.")
        is_qs = (_is_qs_ingredient(name_raw)
                 or _is_qs_quantity(raw_qty_cell)
                 or _rs_norm(_EV.strip_note_markers(name_raw)) in note_qs_rows)

        cleaned_qty = _strip_footnote_markers(raw_qty_cell)
        qty_exact = _EV.dec_or_none(cleaned_qty) if not is_qs else None
        qty = _FLOAT(qty_exact) if qty_exact is not None else None

        amount_mg = None
        amount_exact = None
        basis = "qs"
        if not is_qs and qty_exact is not None and qty_exact > 0:
            amount_exact = _MUL(qty_exact, multiplier)
            amount_mg = _FLOAT(_ROUND(amount_exact, 6))
            basis = f"qty_times_multiplier_per_{unit_basis}"

        row_cols = {}
        if matcode_idx is not None and matcode_idx < len(r):
            mc = _s(r[matcode_idx])
            row_cols[header[matcode_idx]] = "" if mc in ("-", "—") else mc
        row_cols[comp_label] = name
        if func_idx is not None and func_idx < len(r):
            row_cols[header[func_idx]] = _s(r[func_idx])
        if compendia_idx is not None and compendia_idx < len(r):
            row_cols[header[compendia_idx]] = _s(r[compendia_idx])
        # Every detected presentation column is shown verbatim (Part 2.4); only
        # the SELECTED one drives the amounts computed above.
        row_cols[qty_label] = raw_qty_cell
        for _c in strength_columns:
            if _c["label"] not in row_cols:
                row_cols[_c["label"]] = (_s(r[_c["index"]])
                                         if _c["index"] < len(r) else "")
        if stage_idx is not None and stage_idx < len(r):
            row_cols[header[stage_idx]] = _s(r[stage_idx])

        _comp_row = {
            "component": name,
            "quantity": qty if qty is not None else None,
            "amount_in_maximum_dose_mg": amount_mg,
            "amount_in_maximum_dose_mg_exact": (str(amount_exact)
                                                if amount_exact is not None
                                                else None),
            "amount_basis": basis,
            "_is_qs": is_qs,
            "solvents": {},
            "columns": row_cols,
        }
        if not _absent:
            comp_rows.append(_comp_row)
        display_rows.append({"ingredient": name, "columns": row_cols})

    known = [c["amount_in_maximum_dose_mg_exact"] for c in comp_rows
             if (not c["_is_qs"]) and c["amount_in_maximum_dose_mg"] is not None]
    solid_mass_exact = _SUM(known) if known else None
    solid_mass = (_FLOAT(_ROUND(solid_mass_exact, 6))
                  if solid_mass_exact is not None else None)
    needs_dose_basis = any((not c["_is_qs"])
                           and c["amount_in_maximum_dose_mg"] is None
                           for c in comp_rows)

    # Drug-product mass per daily dose. Liquids (mL basis): the daily dose is a
    # VOLUME — mass = multiplier(mL/day) × 1000 × density; never sum dissolved
    # solids. Solids: sum of the non-q.s. component amounts. (is_liquid computed
    # once, up front.)
    if is_liquid:
        # The daily dose VOLUME — the multiplier counts presentation units, so a
        # per-2mL column must be scaled back to millilitres before it becomes a
        # mass. (Single-column sheets have _col_volume_ml = 1 and are unchanged.)
        _daily_volume_ml = _MUL(multiplier, _col_volume_ml)
        # mL/day x 1000 mg/g x g/mL. Exact: this number is the denominator of
        # every equivalent-ppm figure in the report.
        _dp_mass_exact = _MUL(_daily_volume_ml, 1000, density_g_per_ml)
        drug_product_mass_mg = _FLOAT(_ROUND(_dp_mass_exact, 6))
    else:
        _dp_mass_exact = solid_mass_exact
        drug_product_mass_mg = solid_mass
    # The API's own amount in the maximum daily dose (salt basis).
    api_amount_exact = (_MUL(api_qty, multiplier) if api_qty is not None
                        else None)
    api_amount_mg = (_FLOAT(_ROUND(api_amount_exact, 6))
                     if api_amount_exact is not None else None)

    # RF6 metadata: strength string + inferred dosage form (never a column header).
    # RS Bug 6b: for an overage product the DISPLAYED strength is the EFFECTIVE
    # (label) strength = api_qty / (1 + overage), e.g. 1.1 mg/mL → "1 mg/mL"; a
    # footnote records the overage. Component amounts still use the formulation
    # strength as printed. The API name is included for liquids per the approved
    # convention ("1 mg/mL Epinephrine").
    strength_note = ""
    if api_qty is not None:
        # Effective LABEL strength backs out (a) any manufacturing overage and
        # (b) a salt-form conversion, so the displayed strength is the free-base
        # label value, never the salt formulation weight (RS Bug 2 — Trilaciclib
        # 349 mg dihydrochloride → 300 mg base). salt_factor/overage default to
        # neutral, so Esomeprazole and other free-base APIs are unchanged (RF9).
        _sf = _DIV(_salt_num, _salt_den)
        eff_qty = _label_quantity(api_qty)
        _eff_text = _EV.format_decimal(_ROUND(eff_qty, 6))
        _api_text = _EV.format_decimal(_D(api_qty))
        if is_liquid:
            strength_label = f"{_eff_text} mg/mL"
            if api_name:
                strength_label = f"{strength_label} {api_name}"
        else:
            strength_label = f"{_eff_text} mg/{unit_basis}"
        if _sf != _EV.DECIMAL_ONE:
            # Salt-form footnote takes precedence: it records the salt weight and
            # its free-base equivalent (memory acceptance point 6).
            strength_note = (f"* {_api_text} mg {api_name or 'salt'} equivalent "
                             f"to {_eff_text} mg base")
        elif overage_pct:
            strength_note = (
                f"* API strength inclusive of "
                f"{_EV.format_decimal(_MUL(overage_pct, 100))}% overage")
    else:
        strength_label = ""
    dosage_form_inferred = _DOSAGE_BY_BASIS.get(unit_basis, "")

    return {
        "mode": "single_strength_unit_composition",
        "no_of_doses": _FLOAT(_ROUND(multiplier, 6)),  # legacy display only
        "multiplier": _FLOAT(_ROUND(multiplier, 6)),
        "multiplier_exact": str(multiplier),
        "multiplier_basis": mult_basis,
        # Part 2/3 audit: every presentation column that was detected, which one
        # the assessment ran on, and why. Display-only columns are never summed.
        "strength_columns": [{"label": c["label"], "unit_basis": c["unit_basis"],
                              "volume_ml": c.get("volume_ml"),
                              "duplicate_labels": c.get("duplicate_labels", [])}
                             for c in strength_columns],
        "selected_strength_column": qty_label,
        "strength_selection_reason": _s(column_choice.get("reason")),
        "strength_matched": bool(column_choice.get("matched", True)),
        "implied_strength": round(_implied, 6) if _implied else None,
        "doses_per_day": _doses,
        "mdd_value": _mdd_for_strength or None,
        "mdd_unit": _s(mdd_unit) or "mg",
        "mdd_mg_day": (float(mdd_mg_day) if mdd_mg_day else None),
        "salt_factor": salt_factor,
        # The exact conversion behind the rounded factor above: (salt, base).
        "salt_weights": ([str(_salt_num), str(_salt_den)]
                         if _salt_fraction else None),
        "salt_auto_applied": salt_auto_applied,
        "label_conc_per_ml": (_FLOAT(_ROUND(_label_per_ml, 8))
                              if is_liquid else None),
        "density_g_per_ml": density_g_per_ml,
        "api_component": api_name,
        "api_qty_per_unit": api_qty,
        "api_amount_mg": api_amount_mg,
        "unit_basis": unit_basis,
        "component_col": comp_label,
        "quantity_col": qty_label,
        "amount_col": "Amount in Maximum Dose (mg)",
        "mdi_col": "", "mdi_unit": "",
        "columns": [comp_label, qty_label, "Amount in Maximum Dose (mg)"],
        "solvents_display": [],
        "solvent_canon": {},
        "rows": comp_rows,
        "footer_total": {}, "footer_limit": {}, "drug_product_row": {},
        "has_calculated_values": False,
        "needs_dose_basis": needs_dose_basis,
        # Nominal MDD (mg/day): solids use the supplied MDD; a volume-dosed liquid
        # uses the label dose = effective strength × volume (e.g. 1 mg/mL × 8 mL =
        # 8 mg/day), never the sum of dissolved solids.
        "product_mdd_mg": (
            float(mdd_mg_day) if mdd_mg_day
            else _FLOAT(_ROUND(_MUL(
                _DIV(api_qty, _EV.DECIMAL_ONE + _D(overage_pct))
                if overage_pct else _D(api_qty), multiplier), 6))
            if (is_liquid and mult_basis == "dose_volume_ml" and api_qty is not None)
            else solid_mass),
        "drug_product_mass_mg": drug_product_mass_mg,
        "mdd_source": ("dose_volume_ml" if mult_basis == "dose_volume_ml"
                       else "mdd_over_api_qty" if mdd_mg_day else "legacy_doses"),
        "dose_volume_ml": dose_volume_ml,
        "overage_pct": overage_pct,
        "strength_label": strength_label,
        "strength_note": strength_note,
        "dosage_form_inferred": dosage_form_inferred,
        "_display_columns": display_columns,
        "_display_sections": [{"name": "Composition", "rows": display_rows}],
        "audit": {"unit_basis": unit_basis,
                  "multiplier": _FLOAT(_ROUND(multiplier, 6)),
                  "multiplier_exact": str(multiplier),
                  "api_component": api_name, "api_qty_per_unit": api_qty,
                  "mdd_mg_day": mdd_mg_day, "salt_factor": salt_factor,
                  "column_volume_ml": _FLOAT(_col_volume_ml),
                  "strength_selection": column_choice.get("reason", "")},
        "warnings": list(dose_warnings),
    }


def parse_component_mdd_only_excel(classified: Dict) -> Dict:
    """
    Mode C parser. Component name + a direct daily-amount column
    (Amount in Maximum Dose, or MDD/Maximum Daily Intake). Uses it directly,
    converting g→mg when needed. No strength / no_of_doses required.
    """
    header = classified["header"]
    rows = classified["rows"]
    comp_idx = classified.get("comp_idx")
    amount_idx = _col_index(header, _AMOUNT_HINTS)
    mdd_idx = _col_index(header, _MDD_HINTS)
    use_idx = amount_idx if amount_idx is not None else mdd_idx
    if comp_idx is None or use_idx is None:
        return {"mode": "component_mdd_only", "rows": [], "needs_dose_basis": True}

    use_label = header[use_idx].lower()
    unit = "mg"
    if re.search(r"\(\s*g\s*\)|\bgram", use_label) and not re.search(r"mg|µg|mcg|ug", use_label):
        unit = "g"
    elif re.search(r"µg|mcg|ug", use_label):
        unit = "ug"

    comp_rows = []
    display_rows = []
    for r in rows:
        if comp_idx >= len(r):
            continue
        name = _s(r[comp_idx])
        if not name:
            continue
        is_qs = any(h in name.lower() for h in _QS_HINTS)
        if _is_qs_ingredient(name):
            is_qs = True
        raw_val = _s(r[use_idx]) if use_idx < len(r) else ""
        if _is_qs_quantity(raw_val):
            is_qs = True
        val = _clean_num(_strip_footnote_markers(raw_val)) if use_idx < len(r) else None
        amount_mg = None
        amount_exact = None
        basis = "none"
        if not is_qs and val is not None and val > 0:
            # g / µg -> mg exactly; the float is only the display boundary.
            if unit == "g":
                amount_exact = _MUL(val, 1000); basis = "mdi_grams"
            elif unit == "ug":
                amount_exact = _DIV(val, 1000); basis = "mdi_micrograms"
            else:
                amount_exact = _D(val); basis = "component_mdd_mg"
            amount_mg = _FLOAT(_ROUND(amount_exact, 6))
        comp_rows.append({
            "component": name, "quantity": None,
            "amount_in_maximum_dose_mg": amount_mg,
            "amount_in_maximum_dose_mg_exact": (str(amount_exact)
                                                if amount_exact is not None
                                                else None),
            "amount_basis": basis,
            "_is_qs": is_qs, "solvents": {}, "columns": {header[comp_idx]: name,
                                                         header[use_idx]: _s(r[use_idx])},
        })
        display_rows.append({"ingredient": name,
                             "columns": {header[comp_idx]: name,
                                         header[use_idx]: _s(r[use_idx])}})

    needs = any((not c["_is_qs"]) and c["amount_in_maximum_dose_mg"] is None for c in comp_rows)
    known = [c["amount_in_maximum_dose_mg_exact"] for c in comp_rows
             if (not c["_is_qs"]) and c["amount_in_maximum_dose_mg_exact"] is not None]
    return {
        "mode": "component_mdd_only", "no_of_doses": None,
        "component_col": header[comp_idx], "quantity_col": "",
        "amount_col": "Amount in Maximum Dose (mg)", "mdi_col": header[use_idx],
        "mdi_unit": unit,
        "columns": ["Components", "Amount in Maximum Dose (mg)"],
        "solvents_display": [], "solvent_canon": {},
        "rows": comp_rows, "footer_total": {}, "footer_limit": {},
        "drug_product_row": {}, "has_calculated_values": False,
        "needs_dose_basis": needs,
        "product_mdd_mg": _FLOAT(_ROUND(_SUM(known), 6)) if known else None,
        "mdd_source": "component_mdd_direct",
        "_display_columns": [header[comp_idx], header[use_idx]],
        "_display_sections": [{"name": "Composition", "rows": display_rows}],
        "audit": {"amount_unit": unit}, "warnings": [],
    }


def parse_rs_excel(raw: Dict, no_of_doses_override: int = 0) -> Dict:
    """
    Convert the raw extracted RS spreadsheet into a structured model.

    Implements the daily-intake hierarchy, normalising every quantitative
    component to `amount_in_maximum_dose_mg`:
      1. Amount in Maximum Dose (mg)            → use directly
      2. Maximum Daily Intake (g) / MDD (g)     → ×1000 → mg
      3. MDD (mg) / component daily amount (mg) → use directly
      4. Quantity/unit (mg) × No. of doses      → compute
      5. none of the above                      → needs_dose_basis = True
    """
    if not isinstance(raw, dict):
        raw = {}
    audit: Dict[str, Any] = {}
    warnings: List[str] = []

    component_col = _s(raw.get("component_col"))
    quantity_col  = _s(raw.get("quantity_col"))
    amount_col    = _s(raw.get("amount_col"))
    mdi_col       = _s(raw.get("mdi_col"))
    columns       = [_s(c) for c in (raw.get("columns") or []) if _s(c)]
    solvents_raw  = [_s(s) for s in (raw.get("solvents") or []) if _s(s)]
    has_calc      = bool(raw.get("has_calculated_values"))

    no_of_doses = no_of_doses_override or _num_or_none(raw.get("no_of_doses")) or 1
    no_of_doses = int(no_of_doses) if no_of_doses else 1

    # Determine mdi unit from header
    mdi_unit = ""
    if mdi_col:
        h = mdi_col.lower()
        if re.search(r"\(\s*g\s*\)|\bgram", h) and not re.search(r"mg|µg|mcg|ug", h):
            mdi_unit = "g"
        elif re.search(r"µg|mcg|ug", h):
            mdi_unit = "ug"
        else:
            mdi_unit = "mg"

    # Canonicalise solvent names against the master
    solvents: List[str] = []
    solvent_canon: Dict[str, str] = {}
    for s in solvents_raw:
        # A roll-up group ("Total", "Total Daily Exposure") summarises the
        # solvents; it is never one, and never gets a column of its own.
        if not RSM.resolve_solvent(s) and re.search(
                r"^\s*(?:grand\s+)?totals?\b|^\s*sum\b|\btotal\s+daily\s+exposure\b",
                s, re.IGNORECASE):
            continue
        canon = RSM.resolve_solvent(s) or s
        solvents.append(s)             # preserve the sheet's display label
        solvent_canon[s] = canon

    def cell(row: Dict, col: str, fallbacks: List[str] = None) -> str:
        cols = row.get("columns", {})
        if isinstance(cols, dict):
            if col and col in cols:
                return _s(cols[col])
            for fb in (fallbacks or []):
                for k, v in cols.items():
                    if fb.lower() in k.lower():
                        return _s(v)
        # Also check top-level row keys (some LLM outputs flatten the row)
        if col and col in row:
            return _s(row[col])
        for fb in (fallbacks or []):
            for k, v in row.items():
                if k == "columns":
                    continue
                if fb.lower() in str(k).lower():
                    return _s(v)
        return ""

    # Walk rows: classify footer rows, build component rows
    comp_rows: List[Dict] = []
    footer_total: Dict[str, Any] = {}
    footer_limit: Dict[str, Any] = {}
    drug_product_row: Dict[str, Any] = {}

    for r in (raw.get("rows") or []):
        if not isinstance(r, dict):
            continue
        name = (_s(r.get("component"))
                or _s(r.get("ingredient"))
                or _s(r.get("name"))
                or cell(r, component_col, ["component", "name", "ingredient", "material"]))
        kind = _is_footer_row(name)

        # Per-solvent subvalues for this row.
        # IMPORTANT: match the solvent name to the column's solvent portion with
        # word boundaries, because some solvent names are substrings of others
        # (e.g. "Ethanol" ⊂ "Methanol"). Without this, Methanol's column would
        # wrongly satisfy a naive "ethanol in header" test.
        solvent_vals: Dict[str, Dict[str, Any]] = {}
        cols = r.get("columns", {})
        cols = cols if isinstance(cols, dict) else {}
        for disp in solvents:
            limit_v = None
            de_v = None
            d_low = disp.lower().strip()
            for k, v in cols.items():
                kl = str(k).lower()
                # Strip the role words to isolate the solvent portion of the header
                solvent_part = re.sub(
                    r"\b(limit|ppm|daily|exposure|mg|\(.*?\))\b", " ", kl)
                solvent_part = re.sub(r"[^a-z0-9 ]+", " ", solvent_part)
                tokens = solvent_part.split()
                # Match only if the solvent name appears as a whole token sequence
                disp_tokens = re.sub(r"[^a-z0-9 ]+", " ", d_low).split()
                is_match = disp_tokens and _seq_in(disp_tokens, tokens)
                if not is_match:
                    continue
                if "limit" in kl or "ppm" in kl:
                    limit_v = _num_or_none(v)
                elif "exposure" in kl or "daily" in kl:
                    de_v = _num_or_none(v)
            solvent_vals[disp] = {"limit": limit_v, "daily_exposure": de_v}

        if kind == "total":
            footer_total = {disp: solvent_vals[disp] for disp in solvents}
            continue
        if kind == "limit":
            footer_limit = {disp: solvent_vals[disp] for disp in solvents}
            continue
        if kind == "drug_product":
            drug_product_row = {
                "component": name,
                "quantity": _num_or_none(cell(r, quantity_col, ["quantity"])),
                "amount_max_dose": _num_or_none(cell(r, amount_col, ["amount in maximum", "amount"])),
                "solvents": solvent_vals,
            }
            continue
        if not name:
            continue

        is_qs = any(h in name.lower() for h in _QS_HINTS)
        if _is_qs_ingredient(name):
            is_qs = True
        # If ALL three quantity cells (amount/qty/mdi) are q.s.-like, force q.s.
        raw_amount = cell(r, amount_col, ["amount in maximum", "amount"])
        raw_qty = cell(r, quantity_col, ["quantity"])
        raw_mdi = cell(r, mdi_col, ["maximum daily intake", "mdd"]) if mdi_col else ""
        _qs_cells = [raw_amount, raw_qty, raw_mdi]
        if all(_is_qs_quantity(v) for v in _qs_cells if v):
            is_qs = True

        # ── daily-intake hierarchy → amount_in_maximum_dose_mg ───────────────
        amount_mg: Optional[float] = None
        basis = "none"
        amt = _num_or_none(_strip_footnote_markers(raw_amount))
        qty = _num_or_none(_strip_footnote_markers(raw_qty))
        mdi = (_num_or_none(_strip_footnote_markers(raw_mdi))
               if mdi_col else None)

        if is_qs:
            pass                        # calc-exempt
        elif amt is not None and amt > 0:
            amount_mg = amt
            basis = "amount_in_maximum_dose"
        elif mdi is not None and mdi > 0:
            # Exact conversions; the float is only the JSON boundary.
            if mdi_unit == "g":
                amount_mg = _FLOAT(_MUL(mdi, 1000))
                basis = "mdi_grams"
            elif mdi_unit == "ug":
                amount_mg = _FLOAT(_DIV(mdi, 1000))
                basis = "mdi_micrograms"
            else:
                amount_mg = mdi
                basis = "mdd_mg"
        elif qty is not None and qty > 0:
            amount_mg = _FLOAT(_MUL(qty, no_of_doses))
            basis = "qty_times_doses"

        comp_rows.append({
            "component": name,
            "quantity": qty,
            "amount_in_maximum_dose_mg": amount_mg,
            "amount_basis": basis,
            "_is_qs": is_qs,
            "solvents": solvent_vals,     # sheet-provided limits/exposures (detailed mode)
            "columns": dict(r.get("columns", {})) if isinstance(r.get("columns"), dict) else {},
        })

    # Determine whether any quantitative row lacks a dose basis
    needs_dose_basis = any(
        (not cr["_is_qs"]) and cr["amount_in_maximum_dose_mg"] is None
        for cr in comp_rows
    )

    mode = "detailed" if (has_calc and solvents) else "basic"

    # ── Infer product-level Maximum Daily Dose from the Excel (no user input) ──
    # Priority: an explicit "Drug Product" total row → else the sum of component
    # amounts in maximum dose. This is shown on the verification screen and is
    # editable, mirroring the injection workflow (no forced MDD/strength entry).
    product_mdd_mg: Optional[float] = None
    mdd_source = "not_determinable"
    dp_amt = None
    if drug_product_row:
        dp_amt = drug_product_row.get("amount_max_dose")
    if dp_amt is not None and dp_amt > 0:
        product_mdd_mg = float(dp_amt)
        mdd_source = "excel_drug_product_row"
    else:
        known = [cr["amount_in_maximum_dose_mg"] for cr in comp_rows
                 if (not cr["_is_qs"]) and cr["amount_in_maximum_dose_mg"] is not None]
        if known:
            product_mdd_mg = _FLOAT(_ROUND(_SUM(known), 6))
            mdd_source = "sum_of_component_amounts"

    return {
        "mode": mode,
        "no_of_doses": no_of_doses,
        "component_col": component_col,
        "quantity_col": quantity_col,
        "amount_col": amount_col,
        "mdi_col": mdi_col,
        "mdi_unit": mdi_unit,
        "columns": columns,
        "solvents_display": solvents,
        "solvent_canon": solvent_canon,
        "rows": comp_rows,
        "footer_total": footer_total,
        "footer_limit": footer_limit,
        "drug_product_row": drug_product_row,
        "has_calculated_values": has_calc,
        "needs_dose_basis": needs_dose_basis,
        "product_mdd_mg": product_mdd_mg,
        "mdd_source": mdd_source,
        "audit": audit,
        "warnings": warnings,
    }


