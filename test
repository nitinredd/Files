# COMPOSITION-EXCEL ENTRY POINT (UI-free)
# The Streamlit client used to hold this routing inline. The API layer needs the
# same behaviour without widgets, so it lives here: classify the workbook, then
# parse it in the mode it actually is. Dose / salt-factor / overage / density
# come from `meta` when supplied and are otherwise auto-detected exactly as the
# UI auto-detects them - never blocking, always logged (warning-first).
# ══════════════════════════════════════════════════════════════════════════════
def rs_parse_composition_excel(excel_bytes: bytes, meta: Dict = None,
                               claude_text: Any = None) -> Dict:
    """Parse an RS composition workbook into the model calculate_rs_exposures wants.

    *meta* uses the SAME fixed dosing contract as the Elemental Impurity
    workflow (Part 4) — everything is known before any Excel is touched::

        {"dosage_category": ..., "mdd_value": 0.0, "mdd_unit": "mg",
         "doses_per_day": 1, "salt_factor": None, "density_g_per_ml": None}

    ``salt_factor`` and ``density_g_per_ml`` are OPTIONAL: the Excel footnote
    and the composition are consulted first, and a missing value warns rather
    than blocks. The workbook's classification decides only which of the
    supplied fields the maths uses — it never changes which fields the caller
    had to send. The legacy names (``mdd_mg_day``, ``dose_volume_ml``,
    ``no_of_doses``, ``overage_pct``) are still accepted.

    *claude_text* is an optional ``fn(prompt) -> str`` used only when a
    detailed-mode workbook cannot be read deterministically; without it the
    deterministic parser is final.
    """
    meta = meta or {}
    contract = DOSE.normalize_dose_contract(meta)
    cls = classify_rs_excel(excel_bytes)
    mode = _s(cls.get("mode"))
    logger.info("[RS] workbook mode: %s", mode or "unknown")

    def _finish(parsed: Dict, resolved_mode: str) -> Dict:
        """Stamp the mode, then apply RED FLAGS 13 + 14 to whatever branch ran.

        Every branch below funnels through here, so the product identity comes
        a wrong-column pick is caught by the role-word self-test regardless of
        which parser produced the rows. The product name is NOT resolved here:
        it comes from the request field only (RF13).
        """
        if not isinstance(parsed, dict):
            return parsed
        parsed["_mode"] = resolved_mode
        if grounded:
            # The composition table exactly as the template sheet states it,
            # every filled strength included; the calculation ran on one.
            parsed["_display_columns"] = grounded["display"]["columns"]
            parsed["_display_sections"] = grounded["display"]["sections"]
            audit = grounded.get("_rs_audit") or {}
            parsed["_template_grounding"] = {
                k: v for k, v in audit.items() if k != "warnings"}
            parsed["warnings"] = (list(parsed.get("warnings") or [])
                                  + list(grounded.get("warnings") or [])
                                  + list(audit.get("warnings") or []))
        try:
            names = [_s(r.get("component")) for r in (parsed.get("rows") or [])
                     if isinstance(r, dict)]
            report = COLS.composition_column_report(names, doc_type="RS")
            parsed["_column_selftest"] = report["selftest_failures"]
            if report["warnings"]:
                parsed.setdefault("warnings", [])
                parsed["warnings"] = list(parsed["warnings"]) + report["warnings"]
        except Exception as exc:                                 # noqa: BLE001
            logger.warning("[RS] composition column check failed: %s", exc)
        return parsed

    # T15 — the official upload template, as a strong PRIOR and never a gate. A
    # workbook filled on its OSD or Injectable sheet is read deterministically
    # through it: the sheet decides per mL or per unit, its marks are bound to
    # their own rows, and the result feeds the SAME parsers below. A workbook
    # with no template signal is untouched.
    # A workbook the classifier reads as a pre-computed RS calculation carries
    # solvent columns the template does not have, so it is never a template
    # upload and keeps its own route.
    grounded = None
    if mode not in ("detailed_rs_calculation", "combined_workbook"):
        try:
            import docgen_template as _TPL
            grounded = _TPL.ground_composition_workbook(
                excel_bytes, claude_text=claude_text,
                prefer=_TPL.preference_from_request(meta.get("dosage_category"),
                                                    meta.get("route"),
                                                    meta.get("dosage_form")))
            adapted = _TPL.rs_classified(
                grounded,
                mdd_mg=DOSE.mdd_as_mg(contract.get("mdd_value"),
                                      contract.get("mdd_unit")),
                doses_per_day=int(contract.get("doses_per_day") or 1)
            ) if grounded else None
            if adapted:
                cls, mode, _audit = adapted
                logger.info("[RS] composition grounded in the upload template: "
                            "%s sheet (%s), %s", grounded.get("sheet_type"),
                            grounded.get("layer"), mode)
        except Exception:                                       # noqa: BLE001
            logger.warning("[RS] template grounding skipped; the workbook is read "
                           "by the standard parser", exc_info=True)
            grounded = None

    # D-2 — never names-only while a quantity table is present: a workbook no
    # deterministic reader could place goes to model alignment first.
    if (not grounded and mode == "insufficient_material_names_only"
            and claude_text is not None):
        try:
            import docgen_template as _TPL
            if _TPL.workbook_has_quantity_table(excel_bytes):
                aligned = _TPL.align_workbook_with_model(
                    excel_bytes, claude_text=claude_text,
                    prefer=_TPL.preference_from_request(meta.get("dosage_category"),
                                                        meta.get("route"),
                                                        meta.get("dosage_form")))
                adapted = _TPL.rs_classified(
                    aligned,
                    mdd_mg=DOSE.mdd_as_mg(contract.get("mdd_value"),
                                          contract.get("mdd_unit")),
                    doses_per_day=int(contract.get("doses_per_day") or 1)
                ) if aligned else None
                if adapted:
                    grounded = aligned
                    cls, mode, _audit = adapted
                    logger.info("[RS] composition aligned by the model: %s", mode)
        except Exception:                                       # noqa: BLE001
            logger.warning("[RS] model alignment skipped", exc_info=True)

    if mode == "detailed_rs_calculation":
        flat = parse_flat_detailed_rs_excel(excel_bytes)
        if flat and flat.get("rows"):
            parsed = parse_rs_excel(flat)
        elif claude_text is not None:
            raw = rs_safe_json(claude_text(rs_excel_prompt() + "\n\nSpreadsheet:\n"
                                           + _rs_dump_workbook(excel_bytes)),
                               want="dict")
            parsed = parse_rs_excel(raw)
        else:
            logger.warning("[RS] detailed workbook could not be read "
                           "deterministically and no extractor was supplied.")
            parsed = parse_rs_excel(flat or {})
        return _finish(parsed, mode)

    if mode == "combined_workbook":
        if claude_text is None:
            logger.warning("[RS] combined workbook needs an extractor for the "
                           "detailed sheet; falling back to the unit sheet only.")
            parsed = parse_unit_composition_excel(
                {**cls.get("unit_sheet", {}), "sheets": cls.get("sheets", [])},
                mdd_mg_day=float(DOSE.mdd_as_mg(contract.get("mdd_value"),
                                                contract.get("mdd_unit"))
                                 or meta.get("mdd_mg_day") or 0.0),
                doses_per_day=int(contract.get("doses_per_day") or 1))
        else:
            raw = rs_safe_json(claude_text(rs_excel_prompt() + "\n\nSpreadsheet:\n"
                                           + _rs_dump_workbook(excel_bytes)),
                               want="dict")
            parsed = parse_rs_excel(raw)
            try:
                unit_cls = {**cls.get("unit_sheet", {}),
                            "sheets": cls.get("sheets", [])}
                unit_parsed = parse_unit_composition_excel(unit_cls, mdd_mg_day=0.0)
                parsed["_display_sections"] = unit_parsed.get("_display_sections", [])
                parsed["_display_columns"] = unit_parsed.get("_display_columns", [])
            except Exception as exc:                             # noqa: BLE001
                logger.warning("[RS] combined unit-sheet parse failed: %s", exc)
        return _finish(parsed, mode)

    # ── Component-level daily amounts already in the sheet ───────────────────
    # The workbook states each component's Amount in Maximum Dose / Maximum
    # Daily Intake directly, so no dose derivation is needed — the contract's
    # dosing fields are simply not used for this mode.
    if mode == "component_mdd_only":
        parsed = parse_component_mdd_only_excel(cls)
        return _finish(parsed, mode)

    # ── Multi-strength unit composition (10 mg | 20 mg | 40 mg columns) ──────
    # Routed to the strength-column parser, which derives the presentation from
    # MDD ÷ doses_per_day and never forces the maximum.
    if mode == "unit_composition_strength_columns":
        parsed = parse_unit_composition_excel(
            cls,
            mdd_mg_day=float(DOSE.mdd_as_mg(contract.get("mdd_value"),
                                            contract.get("mdd_unit"))
                             or meta.get("mdd_mg_day") or 0.0),
            doses_per_day=int(contract.get("doses_per_day") or 1))
        return _finish(parsed, mode)

    # ── Single-strength unit composition (the common case) ───────────────────
    unit_basis = _s(cls.get("unit_basis")) or "unit"
    is_liquid = unit_basis == "ml"

    salt_factor = _f(meta.get("salt_factor")) or 0.0
    overage_pct = _f(meta.get("overage_pct")) or 0.0
    # Footnote-derived salt/base and overage are OPTIONAL enrichment on top of
    # what the caller supplied, resolved INSIDE the parser: bound to the API
    # row, as exact weights rather than a rounded factor, and before the
    # presentation is chosen. Present, absent or unparseable, the workbook
    # generates; a value the caller supplied always wins.
    salt_factor = salt_factor or 1.0

    # Density: a supplied density wins. A dilute aqueous composition is
    # otherwise taken at 1.0 g/mL - the estimate is recorded beside it, never
    # substituted - and only a composition that is not dilute and aqueous runs
    # on the estimate, with a warning asking for the measured value.
    user_density = _f(meta.get("density_g_per_ml")) or 0.0
    auto_density = estimate_density_from_classified(cls) if is_liquid else 1.0
    density_warnings: List[str] = []
    if user_density:
        density, density_source = user_density, "user_supplied"
    elif not is_liquid:
        density, density_source = 1.0, "not_applicable"
    elif (_is_aqueous_composition(cls)
          and abs(_D(auto_density) - _EV.DECIMAL_ONE) <= AQUEOUS_DENSITY_TOLERANCE):
        density, density_source = 1.0, "aqueous_default"
    else:
        density, density_source = (auto_density or 1.0), "auto_estimated"
        density_warnings.append(
            f"No density was supplied; the drug-product mass uses an estimated "
            f"{_EV.format_decimal(auto_density)} g/mL from the composition. "
            "Enter the measured density to replace it.")

    # The MDD arrives in the contract's own unit. A mass MDD also feeds the
    # legacy mg/day argument so the solid path is byte-identical; a volume or
    # activity MDD is derived to a daily volume inside the parser (Part 3).
    mdd_value = _f(contract.get("mdd_value")) or 0.0
    mdd_unit = _s(contract.get("mdd_unit")) or "mg"
    doses_per_day = int(contract.get("doses_per_day") or 1)
    mdd = DOSE.mdd_as_mg(mdd_value, mdd_unit) or _f(meta.get("mdd_mg_day")) or 0.0
    dose_vol = _f(meta.get("dose_volume_ml")) or 0.0
    if not dose_vol and DOSE.is_volume_unit(mdd_unit):
        dose_vol = mdd_value
    parsed = parse_single_strength_unit_composition(
        cls, mdd_mg_day=float(mdd), unit_basis=unit_basis,
        salt_factor=float(salt_factor), density_g_per_ml=float(density),
        dose_volume_ml=(float(dose_vol) if is_liquid else None),
        overage_pct=float(overage_pct),
        mdd_value=mdd_value, mdd_unit=mdd_unit, doses_per_day=doses_per_day)
    if is_liquid and isinstance(parsed, dict):
        parsed["density_auto_estimate"] = auto_density
        parsed["density_source"] = density_source
        if density_warnings:
            parsed["warnings"] = list(parsed.get("warnings") or []) + density_warnings
    return _finish(parsed, mode or "unit_composition")


def _rs_dump_workbook(excel_bytes: bytes, max_rows: int = 150,
                      max_lines: int = 250) -> str:
    """Flat text dump of every sheet, for the LLM extraction fallback."""
    import openpyxl
    from io import BytesIO as _BytesIO
    wb = openpyxl.load_workbook(_BytesIO(excel_bytes), data_only=True)
    parts = []
    for ws in wb.worksheets:
        parts.append(f"=== Sheet: {ws.title} ===")
        for i, row in enumerate(ws.iter_rows(values_only=True)):
            if any(c is not None for c in row):
                parts.append("Row %d: %s" % (i + 1, " | ".join(
                    str(c) if c is not None else "" for c in row)))
            if i > max_rows:
                break
    wb.close()
    return "\n".join(parts[:max_lines])


