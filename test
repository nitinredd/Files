def call_claude(messages: List[Dict], max_tokens: int = 8192,
                context: str = "") -> str:
    """Retry with exponential backoff + jitter. RAISES on failure - a failed
    call must never return "" and be read downstream as "no data"."""
    return call_claude_robust(client, MODEL, messages, max_tokens,
                              log=logger, context=context)


def claude_text(prompt: str, max_tokens: int = 8192, context: str = "") -> str:
    return call_claude([{"role": "user", "content": prompt}], max_tokens,
                       context=context)


