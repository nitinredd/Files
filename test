# DOCGEN UI HELPERS — low-touch delivery
# The scientist supplies only what cannot be derived (product, dosage form,
# dose). Everything else is inferred silently and every backend warning goes to
# the logger, never to the screen.
# ════════════════════════════════════════════════════════════════════════════
def _infer_route(dosage_form: str) -> str:
    """Product-agnostic route inference from free-text dosage form."""
    dl = safe_str(dosage_form).lower()
    if any(k in dl for k in ("injection", "parenteral", "intravenous", "iv ",
                             " im", "vial", "ampoule", "ampule", "infusion")):
        return "parenteral"
    if any(k in dl for k in ("cream", "ointment", "gel", "lotion", "patch",
                             "transdermal", "topical")):
        return "topical"
    if any(k in dl for k in ("inhal", "nebul", "respiratory", "aerosol")):
        return "inhalation"
    if any(k in dl for k in ("tablet", "capsule", "sachet", "granule", "powder",
                             "syrup", "suspension", "solution", "drop", "oral")):
        return "oral"
    return "oral"


def _infer_route_specific(dosage_form: str, context: str = "") -> str:
    """RF8 — DISPLAY-ONLY route subtype for the narrative / document header.

    The CALCULATION route (and therefore the PDE column) is decided separately by
    _infer_route / comp_data['route']; all parenteral subtypes share the parenteral
    PDE, so this never touches the exposure math. Returns 'subcutaneous' /
    'intravenous' / 'intramuscular' / 'parenteral' for injectables (from device /
    route cues in the dosage form or context), else the base route unchanged."""
    base = _infer_route(dosage_form)
    if base != "parenteral":
        return base
    blob = f"{safe_str(dosage_form)} {safe_str(context)}".lower()
    if re.search(r"\b(subcutaneous|subcut|sub-?cut|subq|sub\s*q|sc|uniject|"
                 r"pre[-\s]?filled\s+syringe|prefilled\s+syringe|pen\s*injector|"
                 r"auto[-\s]?injector)\b", blob):
        return "subcutaneous"
    if re.search(r"\b(intravenous|iv|infusion|i\.v)\b", blob):
        return "intravenous"
    if re.search(r"\b(intramuscular|im|i\.m|depot)\b", blob):
        return "intramuscular"
    return "parenteral"


def _auto_meta(product_name: str, dosage_form: str, doc_type: str) -> Dict[str, Any]:
    """Auto-populate the document metadata the UI no longer asks for. Header
    fields the scientist wants filled in are edited in the DOCX after download."""
    now = datetime.now()
    slug = re.sub(r"[^A-Z]", "", doc_type.upper())[:4] or "DOC"
    return {
        "product_name": safe_str(product_name).strip(),
        "dosage_form": safe_str(dosage_form).strip(),
        "document_no": f"TSR-{slug}-{now.strftime('%Y%m%d')}",
        "strength": "",
        "version": "1.0, CURRENT",
        "department": "FR&D",
        "market": "",
        "protocol": "NA",
        "sop_format_number": "",
        "title": "",
        "route": _infer_route(dosage_form),
        # RF8: display-only route subtype (subcutaneous / IV / IM). The
        # calculation route stays in 'route' so the PDE column is unchanged.
        "route_specific": _infer_route_specific(dosage_form, product_name),
        "revision_history": [],
        "signatures": [],
    }


def _route_files(files: List[Any]) -> Tuple[Optional[bytes], List[Any], Optional[bytes]]:
    """Split ONE upload widget's files by kind.
    Returns (excel_bytes, annexure_files, image_bytes) — first Excel/image wins."""
    excel_bytes: Optional[bytes] = None
    image_bytes: Optional[bytes] = None
    annexure_files: List[Any] = []
    for f in (files or []):
        name = safe_str(getattr(f, "name", "")).lower()
        if name.endswith((".xlsx", ".xls")):
            if excel_bytes is None:
                excel_bytes = f.getvalue()
        elif name.endswith((".png", ".jpg", ".jpeg")):
            if image_bytes is None:
                image_bytes = f.getvalue()
        elif name.endswith((".pdf", ".docx", ".doc", ".json")):
            annexure_files.append(f)
        else:
            logger.warning("Ignoring unsupported upload: %s", name)
    return excel_bytes, annexure_files, image_bytes


def _process_annexures_with_progress(doc_type: str, annexure_files: List[Any],
                                     bar, lo: int = 5, hi: int = 90) -> List[Dict]:
    """Convert annexures behind ONE progress bar. Per-file failures are logged and
    skipped — never surfaced — so one bad file cannot stop a generation."""
    out: List[Dict] = []
    n = len(annexure_files or [])
    if not n:
        return out
    for i, f in enumerate(annexure_files):
        pct = lo + int((hi - lo) * (i / n))
        bar.progress(min(pct, 99), text=f"Analyzing files… {pct}%")
        try:
            out.extend(dispatch_annexures(doc_type, [f]) or [])
        except Exception:
            logger.exception("Annexure processing failed for %s",
                             getattr(f, "name", "?"))
    bar.progress(hi, text=f"Analyzing files… {hi}%")
    return out

def dispatch_annexures(doc_type: str, uploaded_files: List[Any],
                       progress=None) -> List[Dict]:
    """Auto-convert/normalise uploaded annexure files for the given document type.
    PDFs are routed to that doc type's converter; JSON files are normalised via
    that doc type's schema. The user never picks a converter. Never raises —
    per-file failures degrade to structured error objects so the run continues."""
    wf = DOCUMENT_WORKFLOWS.get(doc_type)
    if not wf or not uploaded_files:
        return []
    pdf_convert = wf["pdf_convert"]
    json_normalise = wf["json_normalise"]
    out: List[Dict] = []
    files = sorted(uploaded_files, key=lambda f: f.name)
    for i, af in enumerate(files):
        idx = i + 1
        name = af.name
        try:
            # PDFs (all workflows) and DOCX (BE NOC supporting files) route to the
            # doc type's converter; everything else is treated as pre-converted JSON.
            if name.lower().endswith((".pdf", ".docx", ".doc")):
                if progress:
                    progress(f"Converting annexure {idx}: {name}", idx / max(len(files), 1))
                ann = pdf_convert(af.getvalue(), name, idx, None)
            else:
                raw = af.getvalue().decode("utf-8", "replace").lstrip("\ufeff")
                try:
                    obj = json.loads(raw)
                except Exception as e:
                    obj = {"_error": True, "extraction_notes": f"Bad JSON: {e}"}
                ann = json_normalise(obj, idx)
            if isinstance(ann, dict):
                ann.setdefault("filename", name)
                ann["annexure_number"] = idx
            else:
                ann = {"_error": True, "annexure_number": idx, "filename": name,
                       "extraction_notes": "Converter returned non-dict."}
            out.append(ann)
        except Exception as e:
            logger.exception(f"Annexure dispatch failed for {name}")
            out.append({"_error": True, "annexure_number": idx, "filename": name,
                        "extraction_notes": f"Dispatch error: {e}"})

    # RF5: surface (never auto-dedup) content-identical uploads — different
    # filenames that classify to the same type + identity. Logged only; the
    # pipeline respects the user's input and processes every file.
    try:
        from collections import Counter
        sigs: Counter = Counter()
        for ann in out:
            if isinstance(ann, dict) and not ann.get("_error"):
                at = safe_str(ann.get("annexure_type"))
                ident = (safe_str(ann.get("material_name"))
                         or safe_str(ann.get("license_number"))
                         or safe_str(ann.get("stp_number"))
                         or safe_str(ann.get("batch_number")))
                if at and ident:
                    sigs[(at, ident.lower())] += 1
        for (at, ident), count in sigs.items():
            if count > 1:
                logger.warning(f"[{wf.get('prefix','?')}] Content-identical uploads "
                               f"detected: {count} files classified as {at} with "
                               f"identity '{ident}'. Check for duplicates.")
    except Exception:
        logger.exception("duplicate-signature check failed")
    return out


def claude_vision(image_bytes: bytes, prompt: str, media_type: str = "image/png") -> str:
    if not image_bytes:
        return ""
    b64 = base64.standard_b64encode(image_bytes).decode()
    return call_claude([{"role": "user", "content": [
        {"type": "image", "source": {"type": "base64", "media_type": media_type, "data": b64}},
        {"type": "text", "text": prompt},
    ]}])


