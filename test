                "Bulk density (g/mL, optional)", min_value=0.0, value=1.0,
                step=0.001, format="%.3f", key="ei_density",
                help="Used only if the Excel states no density; affects total grams / "
                     "Option 2a-vs-2b threshold only, never per-element concentrations.")
        else:
            mdd = st.number_input("MDD (mg/day)", min_value=0.0, value=0.0,
                                  step=1.0, format="%.3f", key="ei_mdd")
