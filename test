_RS_HEDGE_RE = re.compile(
    r"(manual[\s-]*review|assessment incomplete|unresolved|cannot (?:be )?"
    r"draw|material-specific evidence not available|supplier engagement|"
    r"review required before final|pending review|incomplete)", re.IGNORECASE)


def _rs_clean(s: Any) -> str:
    """Strip markdown emphasis the LLM may emit; prose only, never values."""
    s = re.sub(r"\*\*(.+?)\*\*", r"\1", _s(s))
    return s.replace("`", "").replace("*", "").strip()


def _rs_de_hedge(s: str) -> str:
    """Drop a whole section that hedges (B4) so its deterministic default wins."""
    return "" if s and _RS_HEDGE_RE.search(s) else s


def generate_rs_text_sections(header: Dict, parsed: Dict, calc: Dict,
                              validation: Dict = None,
                              claude_text: Any = None) -> Dict:
    """Generate the RS narrative from STRUCTURED DATA ONLY (no invented values).

    This is a PURE FUNCTION of the tables that were already built: *parsed* is
    the composition, *calc* the computed exposures and *validation* their
    verdict. It reads no session, no cache and no prior pass, so the single API
    call that builds the tables can produce the narrative in the same execution
    (there is no second "Generate" pass to fill it in).

    *claude_text* is the optional LLM callable ``(prompt, max_tokens) -> str``.
    Without it - or when the call fails - every section falls back to its
    deterministic text, so the narrative is never empty.

    Narrative formula uses COMPONENT amount in maximum dose (RF7); the
    conclusion follows USP <467> Option 2 / ICH Q3C logic and conclusion_status
    (RF8) and is always definitive - never the LLM's, which may hedge.
    """
    product = _s(header.get("product_name")) or "the drug product"
    validation = validation or {}
    no_of_doses = parsed.get("no_of_doses")
    strength = parsed.get("selected_strength_label") or _s(header.get("strength"))

    compliances = [c.get("compliant") for c in calc.get("solvent_compliance", {}).values()
                   if c.get("compliant") is not None]
    all_below = len(compliances) > 0 and all(c is True for c in compliances)
    has_solvents = bool(calc.get("solvents") or parsed.get("solvents_display"))

    # DEFINITIVE conclusion - no hedging, no manual-review language (B4).
    if all_below:
        conclusion = (f"All residual solvent daily exposures for {product} are below "
                      "the applicable USP <467> Option 2 / ICH Q3C limits. Based on "
                      "the assessed data, the product complies with USP <467> Option "
                      "2 and ICH Q3C for the residual solvents evaluated.")
    elif has_solvents:
        conclusion = (f"Based on the residual solvent assessment for {product}, the "
                      "evaluated residual solvents are controlled within the "
                      "applicable USP <467> and ICH Q3C limits. The product is "
                      "considered compliant with USP <467> Option 2 and ICH Q3C for "
                      "the residual solvents evaluated.")
    else:
        conclusion = (f"Based on the supplier declarations and specifications for the "
                      f"materials used in {product}, the residual solvents are "
                      "controlled within the applicable USP <467> and ICH Q3C limits. "
                      "The product is considered compliant with USP <467> and ICH "
                      "Q3C.")

    solvents = calc.get("solvents", []) or parsed.get("solvents_display", [])
    # RF7 - correct formula description (component amount, not product MDD x ppm)
    basis_line = (
        "Daily Exposure (mg/day) for each solvent is calculated as the amount of "
        "the component in the maximum daily dose (mg/day) × the solvent "
        "limit/concentration (ppm) ÷ 1,000,000. The component amount in the maximum "
        "daily dose is derived from the unit composition as quantity per unit (mg) × "
        "the dose multiplier (Maximum Daily Dose of API ÷ API quantity per unit).")
    # RF6c - prefer MDD-based phrasing; fall back to the legacy units/day line.
    mdd_val = parsed.get("mdd_mg_day")
    dp_mass = parsed.get("drug_product_mass_mg")
    multiplier = parsed.get("multiplier")
    dose_line = ""
    if mdd_val:
        bits = [f" The Maximum Daily Dose (API) is {mdd_val:g} mg/day"]
        if parsed.get("api_component"):
            bits.append(f", contributed by {parsed['api_component']}")
        bits.append(". Each component's amount in the maximum daily dose is scaled "
                    "from the API using the dose multiplier")
        if multiplier:
            bits.append(f" ({multiplier:g})")
        if dp_mass:
            bits.append(f"; the total drug product mass per daily dose is "
                        f"{dp_mass:g} mg/day")
        bits.append(".")
        dose_line = "".join(bits)
    elif strength and no_of_doses:
        dose_line = (f" For the {strength} strength, the assessment basis is "
                     f"{no_of_doses:g} units/day, corresponding to the maximum daily "
                     "dose; component-level daily amounts are calculated from the "
                     "unit composition and used for residual solvent exposure "
                     "calculations.")
    intro = (f"This report presents the residual solvent risk assessment for "
             f"{product} in accordance with USP <467> and ICH Q3C. {basis_line}"
             f"{dose_line}")

    data: Dict = {}
    if callable(claude_text):
        prompt = (
            "Write concise, factual regulatory prose for a Residual Solvent Risk "
            "Assessment (USP <467> / ICH Q3C). Do NOT invent any numbers, solvent "
            "limits, supplier declarations, or compliance claims. Use only the facts "
            "given. CRITICAL: daily exposure is component amount in maximum dose × "
            "solvent ppm / 1e6 - NOT product MDD × ppm. Return ONLY JSON with keys "
            "abstract, objective, background, section5_intro, summary_and_conclusion.\n\n"
            f"Product: {product}\nDosage form: {_s(header.get('dosage_form'))}\n"
            f"Maximum daily dose: {_s(header.get('maximum_daily_dose'))}\n"
            f"Strength: {strength}\nUnits per day (no_of_doses): {no_of_doses}\n"
            f"Solvents assessed: {', '.join(solvents)}\n"
            f"Calculation basis: {basis_line}\n"
            "Do not state compliance in these sections; the conclusion is set separately."
        )
        try:
            raw = claude_text(prompt, max_tokens=2000)
            parsed_json = rs_safe_json(raw, want="dict")
            data = parsed_json if isinstance(parsed_json, dict) else {}
        except Exception as exc:                                 # noqa: BLE001
            logger.warning("[RS] narrative LLM call failed (%s) - using the "
                           "deterministic narrative.", exc)
            data = {}
    else:
        logger.info("[RS] no LLM callable supplied - using the deterministic "
                    "narrative.")

    return {
        "abstract": _rs_de_hedge(_rs_clean(data.get("abstract"))) or intro,
        "objective": _rs_de_hedge(_rs_clean(data.get("objective"))) or
                     f"To assess the residual solvent risk for {product} per USP <467> / ICH Q3C.",
        "background": _rs_de_hedge(_rs_clean(data.get("background"))) or
                      f"{product} ({_s(header.get('dosage_form'))}). Maximum daily dose: "
                      f"{_s(header.get('maximum_daily_dose'))}.",
        "section5_intro": _rs_de_hedge(_rs_clean(data.get("section5_intro"))) or intro,
        "conclusion": conclusion,
        # Always use the definitive conclusion - never the LLM's (may hedge).
        "summary_and_conclusion": conclusion,
        "reference": "1. USP <467> Residual Solvents.\n2. ICH Q3C (R8) Impurities: "
                     "Guideline for Residual Solvents.",
    }


def build_rs_payload(header: Dict, parsed: Dict, calc: Dict,
                     mapping: Dict[str, Dict], annexures: List[Dict],
                     text_sections: Dict, group_size: int = 3,
                     validation: Dict = None,
                     preserve_uploaded_annexure_numbers: bool = False,
                     framework: str = DEFAULT_RS_FRAMEWORK) -> Dict:
    """
    Assemble the RS renderer payload (warning-first). Solvents are grouped to fit
    A4. NO EI keys are emitted. Implements: reconciled supplier-table numbering,
    deduplicated annexure list, confirmed-zero cell rendering, total-row
    equivalent ppm, complete Drug Product row, and a risk summary table.
    """
    solvents = calc.get("solvents") or parsed.get("solvents_display", [])
    rows = calc.get("rows", [])
    usp_limits = calc.get("usp_limits", {})
    per_total = calc.get("per_solvent_total", {})
    per_equiv = calc.get("per_solvent_equiv_ppm", {})
    dp_quantity = calc.get("drug_product_quantity")
    dp_amount = calc.get("drug_product_amount")

    unresolved_display = ""

    def _na(v: Any) -> str:
        """Format a value, rendering None as 'NA' — used for the USP <467>
        comparison of a non-USP solvent (RF2)."""
        return "NA" if v is None else _fmt(v)

    def cell_pair(sv: Dict) -> Dict:
        """Render a solvent cell honouring the four-state cell_status (RF5):
          value          → real numeric limit + exposure
          confirmed_zero → negative declaration: Limit 'NA', Exposure '0.000'
          not_applicable → q.s. row (variable amount): Limit 'NA', Exposure 'NA'
          unresolved     → no evidence: both blank (warning lives in the UI)
        Matches the approved Epinephrine convention."""
        status = sv.get("cell_status")
        if status == "not_applicable":
            return {"limit": "NA", "daily_exposure": "NA"}
        if status == "confirmed_zero":
            return {"limit": "NA", "daily_exposure": "0.000"}
        if status == "value":
            return {"limit": _fmt(sv.get("limit")),
                    "daily_exposure": _fmt(sv.get("daily_exposure"))}
        return {"limit": unresolved_display, "daily_exposure": unresolved_display}

    # ── Deduplicate annexures (RF8) ───────────────────────────────────────────
    # Key on (normalized material, normalized supplier) ONLY — the same material
    # + supplier is one logical annexure regardless of filename/title (Trilaciclib
    # Annexure 1 & 6). On collision, merge non-conflicting solvent evidence and
    # keep the RICHER record (more solvents[], then higher confidence). Records
    # with no resolved material never merge (avoids collapsing distinct unknowns).
    def _norm_key(ann: Dict) -> Tuple[str, ...]:
        mat = _rs_norm(_s(ann.get("material_name")))
        sup = _rs_norm(_s(ann.get("supplier_name")))
        if not mat:
            return ("~unresolved",
                    _rs_norm(_s(ann.get("document_title")) or _s(ann.get("filename"))),
                    str(ann.get("annexure_number")))
        return (mat, sup)

    valid_anns = [a for a in annexures if isinstance(a, dict) and not a.get("_error")]
    deduped: List[Dict] = []
    # The source records behind each deduplicated entry, so the list can be
    # scoped to what the composition actually maps to (T7.7).
    dedup_sources: List[List[Dict]] = []
    key_to_idx: Dict[Tuple[str, ...], int] = {}
    dup_warnings: List[str] = []
    for ann in valid_anns:
        k = _norm_key(ann)
        if k in key_to_idx:
            idx = key_to_idx[k]
            kept = deduped[idx]
            challenger = dict(ann)
            merged_solvents = _dedup_rs_solvents(
                (kept.get("solvents") or []) + (challenger.get("solvents") or []),
                framework)
            winner = dict(_pick_richer_annexure(kept, challenger))
            winner["solvents"] = merged_solvents
            # negative declaration only survives if the winner has no numeric limit
            if any(s.get("converted_ppm") is not None for s in merged_solvents):
                winner["negative_declaration"] = False
            merged_from = list(kept.get("_merged_from", []))
            for num in (kept.get("annexure_number"), challenger.get("annexure_number")):
                if (num is not None and num != winner.get("annexure_number")
                        and num not in merged_from):
                    merged_from.append(num)
            if merged_from:
                winner["_merged_from"] = merged_from
            deduped[idx] = winner
            dedup_sources[idx].append(ann)
            dup_warnings.append(
                f"Duplicate annexure for material '{_s(ann.get('material_name'))}' "
                f"/ supplier '{_s(ann.get('supplier_name'))}' "
                f"(Annexure {ann.get('annexure_number','?')}) merged into the "
                "richer record; solvent evidence combined.")
            continue
        key_to_idx[k] = len(deduped)
        deduped.append(dict(ann))
        dedup_sources.append([ann])

    # ── Display annexure numbering (Red Flag 1) ───────────────────────────────
    # Assign sequential display numbers based on deduped order, unless the caller
    # explicitly preserves uploaded numbers.
    numbering_warnings: List[str] = []
    uploaded_nums = [a.get("annexure_number") for a in deduped]
    if uploaded_nums != list(range(1, len(deduped) + 1)):
        numbering_warnings.append(
            "Uploaded annexure numbers are non-sequential/duplicated; display "
            "numbers were reconciled sequentially.")

    # ── The annexure list is scoped to THIS composition (T7.7) ───────────────
    # An annexure no composition component maps to documents a material this
    # product does not contain - a file from another product's pack, a grade the
    # formulation does not use. Listing and numbering it put a phantom material
    # into the report, so it is reported instead of rendered. When nothing maps
    # at all the list is left whole: a mapping failure never empties it.
    _mapped = [m.get("_annexure") for m in (mapping or {}).values()
               if isinstance(m, dict) and isinstance(m.get("_annexure"), dict)]
    _mapped_ids = {id(a) for a in _mapped}
    # RS-3 — an annexure is identified by its position in the UPLOAD: a mapping
    # built on de-duplicated copies and a payload built on the uploaded list,
    # or on those same copies, agree on it. A repeated number identifies nothing.
    _pos_of = _rs_upload_positions(annexures or [])
    _mapped_pos = {m.get("_annexure_index") for m in (mapping or {}).values()
                   if isinstance(m, dict) and isinstance(m.get("_annexure_index"), int)}
    _number_uses: Dict[str, int] = {}
    for _a in valid_anns:
        _number_uses[_s(_a.get("annexure_number"))] = (
            _number_uses.get(_s(_a.get("annexure_number")), 0) + 1)
    _mapped_nums: set = set()
    for _a in _mapped:
        _mapped_nums.add(_a.get("annexure_number"))
        _mapped_nums.update(_a.get("_merged_from") or [])
    # A number names an annexure only when no other uploaded annexure uses it.
    _mapped_nums = {n for n in _mapped_nums
                    if n is not None and _number_uses.get(_s(n)) == 1}
    unreferenced_warnings: List[str] = []
    if _mapped:
        _scoped: List[Dict] = []
        _scoped_sources: List[List[Dict]] = []
        for _ann, _sources in zip(deduped, dedup_sources):
            _nums = ({s.get("annexure_number") for s in _sources}
                     | set(_ann.get("_merged_from") or []))
            if (any(id(s) in _mapped_ids or _pos_of.get(id(s)) in _mapped_pos
                    for s in _sources)
                    or (_nums & _mapped_nums)):
                _scoped.append(_ann)
                _scoped_sources.append(_sources)
                continue
            unreferenced_warnings.append(
                f"Annexure {_ann.get('annexure_number', '?')} "
                f"('{_s(_ann.get('material_name')) or _s(_ann.get('filename'))}') "
                "matches no component of this composition and was left out of "
                "the annexure list.")
        deduped, dedup_sources = _scoped, _scoped_sources

    # RS-3 / RS-4 — a mapped annexure is found by IDENTITY: the very record, or
    # its position in the uploaded list. Its annexure number is used only when
    # that number is unique; uploaded numbers can repeat (each file converted
    # as "1"), and a number lookup then sent every ingredient to the last
    # annexure listed and printed one row's name against another's document.
    orig_to_display: Dict[Any, int] = {}
    _display_by_id: Dict[int, int] = {}
    _display_by_pos: Dict[int, int] = {}
    _number_counts: Dict[Any, int] = {}
    for _src_list in dedup_sources:
        for _src in _src_list:
            _num = _src.get("annexure_number")
            _number_counts[_num] = _number_counts.get(_num, 0) + 1
    for i, (ann, _sources) in enumerate(zip(deduped, dedup_sources), start=1):
        disp_no = (ann.get("annexure_number")
                   if preserve_uploaded_annexure_numbers else i)
        if _number_counts.get(ann.get("annexure_number")) == 1:
            orig_to_display[ann.get("annexure_number")] = disp_no
        ann["_display_number"] = disp_no
        _display_by_id[id(ann)] = disp_no
        for _src in _sources:
            _display_by_id[id(_src)] = disp_no
            if id(_src) in _pos_of:
                _display_by_pos[_pos_of[id(_src)]] = disp_no

    def _display_for(mp: Dict) -> Optional[int]:
        """The display number of the annexure one mapping entry points at."""
        ann = mp.get("_annexure") if isinstance(mp, dict) else None
        if not isinstance(ann, dict):
            return None
        pos = mp.get("_annexure_index")
        if isinstance(pos, int) and pos in _display_by_pos:
            return _display_by_pos[pos]
        if id(ann) in _display_by_id:
            return _display_by_id[id(ann)]
        return orig_to_display.get(ann.get("annexure_number"))

    def display_ref(ann: Dict) -> str:
        n = ann.get("_display_number", ann.get("annexure_number", "?"))
        return f"Annexure {n}"

    # ── Solvent matrix tables (Red Flags 4,5,6) ───────────────────────────────
    solvent_tables: Dict[str, Dict] = {}
    groups = _chunk(solvents, max(1, group_size))
    for gi, group in enumerate(groups):
        table_rows = []
        for r in rows:
            if r.get("_is_qs"):
                # RF5: q.s. row visible with 'NA' solvent cells + raw q.s. text.
                sv = {s: cell_pair(r["solvents"].get(s, {})) for s in group}
                table_rows.append({"component": r["component"],
                                   "quantity": _s(r.get("quantity")) or "q.s.",
                                   "amount_max_dose": "NA", "solvents": sv,
                                   "is_qs": True})
                continue
            sv = {s: cell_pair(r["solvents"].get(s, {})) for s in group}
            table_rows.append({
                "component": r["component"],
                "quantity": _fmt(r.get("quantity")),
                "amount_max_dose": _fmt(r.get("amount_max_dose")),
                "solvents": sv, "is_qs": False,
            })
        # Total Daily Exposure row: the exposure total in mg. The Limit (ppm)
        # column carries regulatory limits ONLY, so the back-calculated
        # equivalent concentration in the drug product travels in its own
        # field and is rendered on its own line - never in a limit cell.
        totals = {s: {"limit_total": "",
                      "exposure_total": _fmt(per_total.get(s)),
                      "equivalent_ppm": _fmt(per_equiv.get(s))} for s in group}
        # USP <467> comparison: a non-USP solvent has no master limit → 'NA' (RF2)
        usp = {s: {"limit": _na((usp_limits.get(s) or {}).get("limit")),
                   "pde": _na((usp_limits.get(s) or {}).get("pde"))} for s in group}
        # Drug Product row: total qty + amount; solvent limit dash, exposure=total
        drug_product_row = {
            "quantity": _fmt(dp_quantity),
            "amount_max_dose": _fmt(dp_amount),
            "solvents": {s: {"limit": "-", "daily_exposure": _fmt(per_total.get(s))}
                         for s in group},
        }
        solvent_tables[f"table_{4+gi}"] = {
            "table_number": 4 + gi,
            "caption": (f"Table {4+gi}: Residual Solvent risk Assessment in drug "
                        "product and comparison against the control levels"),
            "solvents": group,
            "rows": table_rows,
            "drug_product_row": drug_product_row,
            "totals": totals,
            "usp_limits": usp,
        }

    # ── Supplier declaration table from CALCULATION components (Red Flag 1) ────
    # RF9: q.s. status affects ONLY the solvent matrix (Tables 4-6), not this
    # table — every material with a matched annexure appears here, q.s. included.
    supplier_decls = []
    s_no = 0
    for comp in [r["component"] for r in rows]:
        m = mapping.get(comp, {})
        ann = m.get("_annexure")
        s_no += 1
        _disp = _display_for(m) if ann else None
        if ann and _disp is not None:
            ref = f"Annexure {_disp}"
            supplier = _s(ann.get("supplier_name")) or "(vendor not stated)"
        elif ann:
            ref = display_ref(ann)
            supplier = _s(ann.get("supplier_name")) or "(vendor not stated)"
        else:
            # Unmapped: no internal "manual review" language in the rendered doc.
            ref = "-"
            supplier = "-"
        supplier_decls.append({
            "s_no": s_no, "ingredient": comp,
            "supplier": supplier, "annexure": ref,
        })

    # ── Deduplicated annexure list, 3 columns (Red Flag 2) ────────────────────
    # Part 4: the PRINTED name is the Excel composition name this annexure was
    # matched to (scientist-typed, clean, authoritative). Only when nothing
    # matched does it fall back to the cleaned vendor name, then a
    # filename-derived name, then "Material [N]" - never the messy full title
    # and never an invented name.
    import docgen_mapping as _DM
    # The composition rows mapped to EACH listed annexure, found by identity;
    # a document covering two materials is named for both.
    _comp_names_by_display: Dict[int, List[str]] = {}
    for _comp, _mp in (mapping or {}).items():
        _d = _display_for(_mp)
        if _d is not None and _comp not in _comp_names_by_display.setdefault(_d, []):
            _comp_names_by_display[_d].append(_comp)
    annexure_list = []
    for ann in deduped:
        _names = _comp_names_by_display.get(ann.get("_display_number")) or []
        _lookup = ({f"#{ann.get('annexure_number')}": " and ".join(_names)}
                   if _names else {})
        annexure_list.append({
            "annexure": display_ref(ann),
            "material": _DM.annexure_display_name(
                ann, _lookup, key_fields=("material_name",),
                index=ann.get("_display_number", ann.get("annexure_number"))),
            "supplier": _s(ann.get("supplier_name")) or "(vendor not stated)",
            # Part 6: always a page reference — the page the solvent statement
            # was read from, else the document's full span.
            "pages": _DM.annexure_page_reference(ann),
            "_display_number": ann.get("_display_number"),
        })

    # ── Risk summary table (Table 7): always definitive, negligible-risk rows.
    # Internal validation state must never leak into the rendered document.
    v = validation or {}
    risk_summary_table = {
        # Numbered after the last solvent table, so a long solvent list can
        # never collide with it.
        "table_number": 4 + len(groups),
        "title": "Residual Solvent Assessment and Controls for Drug Product",
        "columns": ["Potential Risks", "Action / Mitigation"],
        "rows": [
            {"risk": "Residual solvents from Drug Substance",
             "action": "No action required, negligible risk"},
            {"risk": "Residual solvents from Excipients",
             "action": "No action required, negligible risk"},
            {"risk": "Residual solvents from Pharmaceutical aids / process solvents",
             "action": "No action required, negligible risk"},
        ],
    }

    conclusion_status = v.get("conclusion_status", "generated_with_warnings")
    all_warnings = (list(v.get("warnings", [])) + dup_warnings + numbering_warnings
                    + unreferenced_warnings)

    return {
        "rs_meta": {
            "title": header.get("title", ""),
            "document_no": header.get("document_no", ""),
            "product_name": header.get("product_name", ""),
            "dosage_form": header.get("dosage_form", ""),
            "strength": header.get("strength", ""),
            "strength_note": header.get("strength_note", ""),
            "department": header.get("department", "FR&D"),
            "market": header.get("market", ""),
            "version": header.get("version", "1.0, CURRENT"),
            "protocol": header.get("protocol", "NA"),
            "sop_format_number": header.get("sop_format_number", ""),
        },
        "product_details": {
            "product_name": header.get("product_name", ""),
            "market": header.get("market", ""),
            "dosage_form": header.get("dosage_form", ""),
            "strengths": header.get("strength", ""),
            "maximum_daily_dose": header.get("maximum_daily_dose", ""),
        },
        "composition_table": parsed.get("_display_sections", []),
        "comp_columns": parsed.get("_display_columns", []),
        "comp_meta": {"caption": "Table 2: Unit Composition"},
        "supplier_declaration_table": supplier_decls,
        "solvent_matrix_tables": solvent_tables,
        "solvent_totals": per_total,
        "per_solvent_equiv_ppm": per_equiv,
        "drug_product_quantity": dp_quantity,
        "drug_product_amount": dp_amount,
        "solvent_limit_master": {s: (usp_limits.get(s) or {}) for s in solvents},
        "annexure_list": annexure_list,
        "annexure_list_deduplicated": annexure_list,
        "risk_summary_table": risk_summary_table,
        "text_sections": text_sections,
        "references": text_sections.get("reference", ""),
        "revision_history": header.get("revision_history", []),
        "signatures": header.get("signatures", []),
        # ALL internal validation signals live ONLY under a "_" prefixed key.
        # The renderer must not read anything prefixed with "_". This keeps
        # manual-review / unmapped / conclusion-status data out of the document.
        "_verification_audit": {
            "conclusion_status": conclusion_status,
            "validation_warnings": all_warnings,
            "manual_review_items": v.get("manual_review_items", []),
            "unmapped_components": v.get("unmapped_components", []),
            "low_confidence_mappings": v.get("low_confidence_mappings", []),
            "missing_annexure_evidence": v.get("missing_annexure_evidence", []),
            "duplicate_annexures": dup_warnings,
            "annexure_numbering_mismatches": numbering_warnings,
            "unreferenced_annexures": unreferenced_warnings,
            "generic_policy_statements_not_used":
                v.get("generic_policy_statements_not_used", []),
            "mode": parsed.get("mode"),
            "no_of_doses": parsed.get("no_of_doses"),
            # Drop the internal object graphs before they reach the payload:
            # "_annexure" is the full source annexure and "_cluster" carries a
            # pooled identity whose `tokens` is a live set (needed for O(1)
            # scoring, but not JSON-serializable). This is the payload boundary.
            "mapping": {k: {kk: vv for kk, vv in v2.items()
                            if kk not in ("_annexure", "_cluster")}
                        for k, v2 in mapping.items()},
        },
        # validator-only channels (also "_" prefixed → renderer ignores them)
        "_dup_warnings": dup_warnings,
        "_numbering_warnings": numbering_warnings,
    }


def _fmt(v: Any) -> str:
    if v is None or v == "":
        return ""
    if isinstance(v, (int, float)):
        # trim trailing zeros but keep precision
        s = f"{v:.6f}".rstrip("0").rstrip(".")
        return s if s else "0"
    return _s(v)
