def rs_composition_name_index(mapping: Dict[str, Dict]) -> Dict[str, str]:
    """annexure material_name -> the Excel composition name it matched.

    The Excel name is scientist-typed and authoritative, so it is what the
    document PRINTS. Matching is untouched: it still uses the vendor title,
    candidate names and filename (Part 4.2)."""
    import docgen_mapping as _DM
    pairs = []
    for comp, mp in (mapping or {}).items():
        if not isinstance(mp, dict):
            continue
        ann = mp.get("_annexure")
        if not isinstance(ann, dict):
            continue
        key = _s(ann.get("material_name"))
        if key:
            pairs.append((key, _s(comp)))
        num = ann.get("annexure_number")
        if num is not None:
            pairs.append((f"#{num}", _s(comp)))
    return _DM.composition_name_index(pairs)


def build_mapping_checklist(components: List[str], mapping: Dict[str, Dict],
                            annexures: List[Dict] = None,
                            composition_rows: int = None) -> Dict:
    """Per-material mapped Yes/No checklist for the API layer (Part 5).

    DATA ONLY - never rendered into the DOCX. Unmapped materials never block
    generation; their rows simply render empty."""
    import docgen_mapping as _DM
    annexures = annexures or []
    items = []
    for comp in components or []:
        mp = (mapping or {}).get(comp, {}) or {}
        ann = mp.get("_annexure")
        matched = isinstance(ann, dict)
        label = ""
        if matched:
            label = (f"Annexure {ann.get('annexure_number', '?')}"
                     f" ({_s(ann.get('material_name')) or 'material not stated'})")
        if mp.get("_mapping_error"):
            reason = "mapping error"
        elif matched:
            reason = ""
        else:
            _cands = mp.get("candidates") or []
            _best = _cands[0] if isinstance(_cands, list) and _cands else {}
            reason = _DM.unmapped_reason(
                _s(mp.get("match_reason")) or comp,
                best_candidate=_s(_best.get("key") or _best.get("material") or ""),
                best_score=_best.get("score"),
                n_annexures=len(annexures))
        items.append(_DM.checklist_item(
            comp, matched, label, mp.get("confidence"), reason,
            needs_confirmation=bool(mp.get("needs_confirmation"))))
    failed = sum(1 for a in annexures if isinstance(a, dict) and a.get("_error"))
    return _DM.build_mapping_checklist(
        "Residual Solvent Risk Assessment", items,
        files_uploaded=len(annexures), extractions_failed=failed,
        extractions_total=len(annexures), composition_rows=composition_rows,
        annexures=annexures)



