        ui_density = 0.0
        if _is_injection:
            # FIX 1: MDD is authoritative for injections, with a mg/units toggle.
            mc1, mc2 = st.columns([2, 1])
            with mc1:
                mdd = st.number_input("Maximum Daily Dose (MDD)", min_value=0.0,
